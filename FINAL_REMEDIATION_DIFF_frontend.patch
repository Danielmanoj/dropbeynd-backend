+/*
+ * Media streaming service worker. OPT-IN: registered only when the build sets
+ * VITE_MEDIA_STREAMING=service-worker (see src/lib/media-streaming.ts).
+ *
+ * Why it exists: a <video> element cannot send an Authorization header, so
+ * protected video would otherwise have to be downloaded in full before it can
+ * play. This worker adds the signed-in viewer's token to the element's own
+ * requests, including each byte-range request, so the browser can stream and
+ * seek. The server still authorizes every one of those requests for the
+ * viewer; nothing about access is decided here.
+ *
+ * What it touches: GET requests to exactly <api origin>/api/media/post/<id>
+ * and /api/media/lesson/<id>. Every other request is left completely alone,
+ * and the token is never attached to any other address.
+ */
+"use strict";
+
+/** The one address prefix this worker may handle, or null if misconfigured. */
+var MEDIA_PREFIX = (function () {
+  try {
+    var raw = new URL(self.location.href).searchParams.get("prefix") || "";
+    var u = new URL(raw);
+    var local = u.hostname === "localhost" || u.hostname === "127.0.0.1";
+    if (u.protocol !== "https:" && !(local && u.protocol === "http:")) return null;
+    if (u.pathname !== "/api/media/" || u.search || u.hash || u.username || u.password) return null;
+    return u.origin + "/api/media/";
+  } catch (e) {
+    return null;
+  }
+})();
+
+var MEDIA_PATH = /^\/api\/media\/(post|lesson)\/[^\/]+$/;
+
+function mediaAddress(request) {
+  if (!MEDIA_PREFIX || request.method !== "GET") return null;
+  var u;
+  try {
+    u = new URL(request.url);
+  } catch (e) {
+    return null;
+  }
+  if (!MEDIA_PATH.test(u.pathname)) return null;
+  var address = u.origin + u.pathname;
+  return address.indexOf(MEDIA_PREFIX) === 0 ? address : null;
+}
+
+/** Asks the page that made the request for a fresh session token. */
+function tokenFromPage(client) {
+  return new Promise(function (resolve) {
+    var channel = new MessageChannel();
+    var timer = setTimeout(function () { resolve(null); }, 4000);
+    channel.port1.onmessage = function (event) {
+      clearTimeout(timer);
+      var token = event.data && typeof event.data.token === "string" ? event.data.token : null;
+      resolve(token);
+    };
+    client.postMessage({ type: "media-token" }, [channel.port2]);
+  });
+}
+
+function serve(event, address) {
+  var lookup = event.clientId ? self.clients.get(event.clientId) : Promise.resolve(null);
+  return Promise.resolve(lookup)
+    .then(function (client) { return client ? tokenFromPage(client) : null; })
+    .catch(function () { return null; })
+    .then(function (token) {
+      var headers = new Headers();
+      var range = event.request.headers.get("range");
+      if (range) headers.set("Range", range);
+      if (token) headers.set("Authorization", "Bearer " + token);
+      // The address is rebuilt from origin + path: no query string is forwarded.
+      return fetch(address, {
+        method: "GET",
+        headers: headers,
+        mode: "cors",
+        credentials: "omit",
+        cache: "no-store",
+        redirect: "error",
+      });
+    });
+}
+
+self.addEventListener("install", function () { self.skipWaiting(); });
+self.addEventListener("activate", function (event) { event.waitUntil(self.clients.claim()); });
+self.addEventListener("fetch", function (event) {
+  var address = mediaAddress(event.request);
+  if (!address) return; // not ours: the browser handles it normally
+  event.respondWith(serve(event, address));
+});
