+/**
+ * Frontend routing and media-loading tests.
+ *
+ * Run with Node's built-in test runner (no extra dependency):
+ *   npm test
+ *
+ * These cover the rules that decide which backend a build talks to, the
+ * hosting rewrite configuration, and a scan of the source proving that no
+ * request and no protected media bypasses those rules. They do not run a
+ * browser: what a deployed page actually requests still has to be checked on
+ * staging.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync, readdirSync } from "node:fs";
+import path from "node:path";
+import {
+  ApiConfigError,
+  KNOWN_PRODUCTION_API_HOSTS,
+  isApiUrl,
+  joinApiUrl,
+  mediaLoadMode,
+  resolveApiBase,
+  resolveDeployEnv,
+} from "./api-base.ts";
+
+const srcDir = path.resolve(import.meta.dirname, "..");
+const rootDir = path.resolve(srcDir, "..");
+const read = (file: string) => readFileSync(file, "utf8");
+
+const PROD_API = "https://dropbeynd-backend.onrender.com";
+const STAGING_API = "https://dropbeynd-backend-staging.onrender.com";
+
+function throwsConfig(env: Parameters<typeof resolveApiBase>[0], pattern: RegExp) {
+  assert.throws(() => resolveApiBase(env), (err: unknown) => err instanceof ApiConfigError && pattern.test(err.message));
+}
+
+// ─── Which environment a build is ─────────────────────────────────────────────
+
+test("the environment comes from VITE_APP_ENV, then Vercel's own value", () => {
+  assert.equal(resolveDeployEnv({ DEV: true }), "development");
+  assert.equal(resolveDeployEnv({}), "production");
+  assert.equal(resolveDeployEnv({ VITE_VERCEL_ENV: "production" }), "production");
+  assert.equal(resolveDeployEnv({ VITE_VERCEL_ENV: "preview" }), "staging", "every Vercel preview deployment is non-production");
+  assert.equal(resolveDeployEnv({ VITE_APP_ENV: "staging" }), "staging");
+  assert.equal(resolveDeployEnv({ VITE_APP_ENV: "Preview " }), "staging");
+  // An explicit declaration wins over Vercel's.
+  assert.equal(resolveDeployEnv({ VITE_APP_ENV: "staging", VITE_VERCEL_ENV: "production" }), "staging");
+  // Anything unrecognised is NOT assumed to be production.
