+/**
+ * Optional streaming of protected video through a service worker
+ * (public/media-sw.js). OFF unless the build sets
+ * VITE_MEDIA_STREAMING=service-worker.
+ *
+ * It is off by default because it has not been exercised in real browsers
+ * against a real backend. When it is off, or the worker is not yet in control
+ * of the page, protected video is downloaded on demand instead (see
+ * components/protected-media.tsx), which always works.
+ */
+import { API_BASE, getAuthToken } from "./api";
+
+const REQUESTED =
+  (import.meta.env as unknown as { VITE_MEDIA_STREAMING?: string }).VITE_MEDIA_STREAMING === "service-worker";
+
+const WORKER_PATH = "/media-sw.js";
+
+function mediaPrefix(): string {
+  return `${API_BASE || window.location.origin}/api/media/`;
+}
+
+function supported(): boolean {
+  return REQUESTED && typeof navigator !== "undefined" && "serviceWorker" in navigator;
+}
+
+/** Call once at startup. Does nothing unless streaming was switched on for this build. */
+export function startMediaStreaming(): void {
+  if (!supported()) return;
+  navigator.serviceWorker.addEventListener("message", (event) => {
+    const port = event.ports?.[0];
+    if (event.data?.type !== "media-token" || !port) return;
+    // Only this origin's own controlling worker is given a token.
+    if (!navigator.serviceWorker.controller || event.source !== navigator.serviceWorker.controller) {
+      port.postMessage({ token: null });
+      return;
+    }
+    getAuthToken().then((token) => port.postMessage({ token }));
+  });
+  navigator.serviceWorker
+    .register(`${WORKER_PATH}?prefix=${encodeURIComponent(mediaPrefix())}`, { scope: "/" })
+    .catch(() => {
+      /* Registration failed: the on-demand download path is used instead. */
+    });
+}
+
+/** True only when our worker, configured for this API, is controlling the page right now. */
+export function isMediaStreamingActive(): boolean {
+  if (!supported()) return false;
+  const controller = navigator.serviceWorker.controller;
+  if (!controller || controller.state === "redundant") return false;
+  try {
+    const script = new URL(controller.scriptURL);
+    return (
+      script.origin === window.location.origin &&
+      script.pathname === WORKER_PATH &&
+      script.searchParams.get("prefix") === mediaPrefix()
+    );
+  } catch {
+    return false;
+  }
+}
