+/**
+ * Subscription checkout with Razorpay.
+ *
+ * The browser's role is deliberately small: ask the server to start a
+ * subscription, open Razorpay Checkout, hand the result back for a signature
+ * check, then WAIT until the server reports access. Access is granted by the
+ * server only after Razorpay's signed webhook arrives, so nothing here can
+ * unlock content, and no card detail ever touches this application.
+ */
+
+import { useCallback, useSyncExternalStore } from "react";
+import { useQuery } from "@tanstack/react-query";
+import { API_BASE, apiFetch } from "@/lib/api";
+
+const CHECKOUT_SCRIPT = "https://checkout.razorpay.com/v1/checkout.js";
+
+export type TokenGetter = () => Promise<string | null>;
+
+export interface BillingConfig {
+  enabled: boolean;
+  keyId?: string;
+  mode?: "test" | "live";
+  /** Currencies a subscriber can pay in. */
+  currencies?: string[];
+  defaultCurrency?: string;
+  /** Offered first, from the visitor's country. The visitor can change it. */
+  suggestedCurrency?: string;
+  country?: string | null;
+  /** Fixed conversion table: units of each currency per one US dollar. */
+  rates?: Record<string, number>;
+}
+
+export interface StartedSubscription {
+  subscriptionId: string;
+  keyId: string;
+  amountMinor: number;
+  currency: string;
+  creatorId: string;
+  creatorName: string;
+  mode: "test" | "live";
+}
+
+export class BillingRequestError extends Error {
+  constructor(
+    public readonly status: number,
+    public readonly code: string | undefined,
+    message: string,
+  ) {
+    super(message);
+    this.name = "BillingRequestError";
+  }
+}
+
+async function request<T>(getToken: TokenGetter, path: string, init?: RequestInit): Promise<T> {
+  const token = await getToken();
+  const res = await apiFetch(`${API_BASE}${path}`, {
+    ...init,
+    credentials: "include",
+    headers: {
+      "Content-Type": "application/json",
+      ...(token ? { Authorization: `Bearer ${token}` } : {}),
+    },
+  });
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) {
+    throw new BillingRequestError(res.status, data?.code, data?.error ?? "The request could not be completed.");
+  }
+  return data as T;
+}
+
+export async function getBillingConfig(): Promise<BillingConfig> {
+  try {
+    const res = await apiFetch(`${API_BASE}/api/payments/config`);
+    if (!res.ok) return { enabled: false };
+    return (await res.json()) as BillingConfig;
+  } catch {
+    return { enabled: false };
+  }
+}
+
+export function startSubscription(getToken: TokenGetter, creatorId: string, currency: string) {
+  // The creator and the chosen currency are sent. The amount is decided by the server.
+  return request<StartedSubscription>(getToken, "/api/payments/subscriptions", {
+    method: "POST",
+    body: JSON.stringify({ creatorId, currency }),
+  });
+}
+
+/** The server's price for a creator in every offered currency (minor units). */
+export async function getQuote(creatorId: string): Promise<Record<string, number>> {
+  const res = await apiFetch(`${API_BASE}/api/payments/quote/${encodeURIComponent(creatorId)}`);
+  if (!res.ok) return {};
+  const data = (await res.json()) as { prices?: Array<{ currency: string; amountMinor: number }> };
+  return Object.fromEntries((data.prices ?? []).map((p) => [p.currency, p.amountMinor]));
+}
+
+export function cancelSubscription(getToken: TokenGetter, creatorId: string) {
+  return request<{ cancelRequested: boolean; atPeriodEnd: boolean; accessUntil: string | null }>(
+    getToken,
+    `/api/payments/subscriptions/${encodeURIComponent(creatorId)}/cancel`,
+    { method: "POST" },
+  );
+}
+
+interface CheckoutResult {
+  razorpay_payment_id: string;
+  razorpay_subscription_id: string;
+  razorpay_signature: string;
+}
+
+let scriptPromise: Promise<void> | null = null;
+function loadCheckoutScript(): Promise<void> {
+  if ((window as any).Razorpay) return Promise.resolve();
+  if (!scriptPromise) {
+    scriptPromise = new Promise<void>((resolve, reject) => {
+      const el = document.createElement("script");
+      el.src = CHECKOUT_SCRIPT;
+      el.async = true;
+      el.onload = () => resolve();
+      el.onerror = () => {
+        scriptPromise = null;
+        reject(new Error("Could not load the payment window. Check your connection and try again."));
+      };
+      document.head.appendChild(el);
+    });
+  }
+  return scriptPromise;
+}
+
+/** Opens Razorpay Checkout. Resolves with Razorpay's result, or null if the user closed it. */
+async function openCheckout(started: StartedSubscription): Promise<CheckoutResult | null> {
+  await loadCheckoutScript();
+  return new Promise<CheckoutResult | null>((resolve, reject) => {
+    const Razorpay = (window as any).Razorpay;
+    const rzp = new Razorpay({
+      key: started.keyId,
+      subscription_id: started.subscriptionId,
+      name: "DropBeynd",
+      description: `Monthly subscription to ${started.creatorName}`,
+      handler: (response: CheckoutResult) => resolve(response),
+      modal: { ondismiss: () => resolve(null) },
+    });
+    rzp.on("payment.failed", (r: any) => {
+      reject(new Error(r?.error?.description ?? "The payment did not go through. You have not been charged."));
+    });
+    rzp.open();
+  });
+}
+
+async function isEntitled(getToken: TokenGetter, creatorId: string): Promise<boolean> {
+  const sub = await request<{ entitled?: boolean }>(getToken, `/api/subscriptions/${encodeURIComponent(creatorId)}`);
+  return sub.entitled === true;
+}
+
+export type SubscribeOutcome =
+  /** The server confirms access. */
+  | "active"
+  /** Payment was submitted and verified, but the server has not confirmed access yet. */
+  | "processing"
+  /** The user closed the payment window. */
+  | "dismissed";
+
+/**
+ * Runs the whole subscribe flow. Reports "active" only when the SERVER says the
+ * user is entitled. A successful payment window alone is reported as
+ * "processing", never as success.
+ */
+export async function subscribeToCreator(
+  getToken: TokenGetter,
+  creatorId: string,
+  currency: string,
+  onStage?: (stage: "starting" | "paying" | "confirming") => void,
+): Promise<SubscribeOutcome> {
+  onStage?.("starting");
+  const started = await startSubscription(getToken, creatorId, currency);
+
+  onStage?.("paying");
+  const result = await openCheckout(started);
+  if (!result) return "dismissed";
+
+  onStage?.("confirming");
+  const confirmed = await request<{ verified: boolean; entitled: boolean }>(getToken, "/api/payments/razorpay/verify", {
+    method: "POST",
+    body: JSON.stringify(result),
+  });
+  if (confirmed.entitled) return "active";
+
+  // Access arrives with Razorpay's webhook, usually within a few seconds.
+  for (let attempt = 0; attempt < 15; attempt++) {
+    await new Promise((r) => setTimeout(r, 2000));
+    try {
+      if (await isEntitled(getToken, creatorId)) return "active";
+    } catch {
+      // keep waiting; a transient error here must not be shown as failure
+    }
+  }
+  return "processing";
+}
+
+export function formatMoney(amount: number, currency: string | null | undefined): string {
+  const value = Number.isFinite(amount) ? amount : 0;
+  if (!currency) return value.toFixed(2);
+  try {
+    return new Intl.NumberFormat(undefined, {
+      style: "currency",
+      currency: currency.toUpperCase(),
+      // Whole amounts (such as rupee prices) are shown without ".00".
+      minimumFractionDigits: Number.isInteger(value) ? 0 : 2,
+      maximumFractionDigits: 2,
+    }).format(value);
+  } catch {
+    return `${value.toFixed(2)} ${currency.toUpperCase()}`;
+  }
+}
+
+// ─── Regional currency ────────────────────────────────────────────────────────
+// A creator sets one price in their own currency. Each visitor sees, and is
+// charged, an amount in their region's currency, converted with the fixed
+// table the server publishes. The amount actually charged is always computed
+// by the server; this mirror exists only so listed prices match checkout.
+
+/** Same rule as the server: nearest minor unit, rupees to the whole rupee. */
+export function convertMinor(amountMinor: number, from: string, to: string, rates: Record<string, number>): number {
+  if (from === to) return amountMinor;
+  if (!(rates[from] > 0) || !(rates[to] > 0)) return amountMinor;
+  const converted = (amountMinor * rates[to]) / rates[from];
+  return to === "INR" ? Math.round(converted / 100) * 100 : Math.round(converted);
+}
+
+const CURRENCY_KEY = "dropbeynd-currency";
+const currencyListeners = new Set<() => void>();
+
+function readStoredCurrency(): string | null {
+  try {
+    return localStorage.getItem(CURRENCY_KEY);
+  } catch {
+    return null;
+  }
+}
+
+function subscribeToCurrency(listener: () => void) {
+  currencyListeners.add(listener);
+  return () => currencyListeners.delete(listener);
+}
+
+/** Remember the visitor's own choice of currency, overriding the regional suggestion. */
+export function setPreferredCurrency(currency: string) {
+  try {
+    localStorage.setItem(CURRENCY_KEY, currency);
+  } catch {
+    // Private mode or blocked storage: the choice simply lasts for this page.
+  }
+  currencyListeners.forEach((l) => l());
+}
+
+/**
+ * Billing availability, the visitor's currency, and a price formatter.
+ *
+ * `currency` is the visitor's saved choice if they made one, otherwise the
+ * currency suggested for their country (India INR, USA USD, UK GBP, euro
+ * countries EUR), otherwise the default.
+ */
+export function useBilling() {
+  const { data: config = null } = useQuery({
+    queryKey: ["billing-config"],
+    queryFn: getBillingConfig,
+    staleTime: 10 * 60 * 1000,
+  });
+  const stored = useSyncExternalStore(subscribeToCurrency, readStoredCurrency, () => null);
+
+  const offered = config?.enabled ? config.currencies ?? [] : [];
+  const currency = stored && offered.includes(stored) ? stored : config?.suggestedCurrency ?? null;
+  const rates = config?.enabled ? config.rates ?? null : null;
+
+  /** A creator's price, shown in the visitor's currency. */
+  const formatPrice = useCallback(
+    (amount: number | string | null | undefined, priceCurrency?: string | null) => {
+      const value = Number(amount ?? 0);
+      const from = (priceCurrency || "USD").toUpperCase();
+      if (!currency || !rates) return formatMoney(value, from);
+      return formatMoney(convertMinor(Math.round(value * 100), from, currency, rates) / 100, currency);
+    },
+    [currency, rates],
+  );
+
+  return { config, currency, currencies: offered, setCurrency: setPreferredCurrency, formatPrice };
+}
