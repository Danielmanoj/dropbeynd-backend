+  assert.match(loader, /VITE_MEDIA_COOKIE_AUTH === "true"/);
+
+  // Neither switch is turned on by any checked-in configuration.
+  for (const file of [".env.example", "vercel.json", "vite.config.ts"]) {
+    const text = read(path.join(rootDir, file));
+    assert.ok(!/^\s*VITE_MEDIA_COOKIE_AUTH\s*=\s*true/m.test(text), `${file} enables cookie media auth`);
+    assert.ok(!/^\s*VITE_MEDIA_STREAMING\s*=/m.test(text), `${file} enables worker streaming`);
+  }
+});
+
+test("a post upload asks for public or protected storage to match the post", () => {
+  const uploader = read(path.join(srcDir, "components/upload/dropzone-uploader.tsx"));
+  assert.match(uploader, /\.\.\.\(uploadType === "post" && visibility \? \{ visibility \} : \{\}\)/);
