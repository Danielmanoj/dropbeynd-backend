+/**
+ * The single place the frontend decides which backend it talks to.
+ *
+ * Every request in the app is built from API_BASE (see lib/api.ts). Nothing
+ * else may contain a backend address or build an "/api/..." URL on its own; a
+ * test scans the source to keep it that way.
+ *
+ * Rules, by deployment environment:
+ *
+ *   development (vite dev server)
+ *       VITE_API_URL if set, otherwise "" (relative), which the dev server
+ *       proxies to a local backend.
+ *
+ *   production
+ *       VITE_API_URL if set, otherwise "" (relative). Relative requests are
+ *       forwarded to the production backend by the host-restricted rewrite in
+ *       vercel.json. This is how production has always worked.
+ *
+ *   staging / preview (anything deployed that is not production)
+ *       VITE_API_URL is REQUIRED. There is no fallback of any kind: not
+ *       relative, not localhost, not production. A missing, malformed,
+ *       non-HTTPS, local, or known-production address is an error, and both
+ *       the build (vite.config.ts) and the app refuse to continue.
+ *
+ * The environment is VITE_APP_ENV when set ("production", "staging",
+ * "preview"), otherwise Vercel's own VITE_VERCEL_ENV ("production" or
+ * "preview"). A production-mode build that declares neither is treated as
+ * production; if such a build is in fact served from a non-production host,
+ * its relative requests are NOT forwarded anywhere (the rewrite only matches
+ * the production host), so it fails closed rather than reaching production.
+ *
+ * This file has no imports so it can be loaded by vite.config.ts and by the
+ * Node test runner as well as by the app.
+ */
+
+export type DeployEnv = "development" | "production" | "staging";
+
+/**
+ * Backends that serve production data. A non-production build pointed at one
+ * of these is refused. Add the production API's custom domain here if it has one.
+ */
+export const KNOWN_PRODUCTION_API_HOSTS: readonly string[] = ["dropbeynd-backend.onrender.com"];
+
+export interface ApiEnv {
+  DEV?: boolean;
+  VITE_API_URL?: string;
+  VITE_APP_ENV?: string;
+  VITE_VERCEL_ENV?: string;
+}
+
+export class ApiConfigError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "ApiConfigError";
+  }
+}
+
+export function resolveDeployEnv(env: ApiEnv): DeployEnv {
+  if (env.DEV) return "development";
+  const declared = (env.VITE_APP_ENV || env.VITE_VERCEL_ENV || "").trim().toLowerCase();
+  if (declared === "" || declared === "production") return "production";
+  // "staging", "preview", "development" on a deployed build, or anything
+  // unrecognised: not production, so the strict rules apply.
+  return "staging";
+}
+
+function isLocalHost(hostname: string): boolean {
+  return (
+    hostname === "localhost" ||
+    hostname === "127.0.0.1" ||
+    hostname === "[::1]" ||
+    hostname === "0.0.0.0" ||
+    hostname.endsWith(".localhost")
+  );
+}
+
+/**
+ * Returns the API base: an absolute origin without a trailing slash, or "" for
+ * same-origin relative requests. Throws ApiConfigError when the configuration
+ * is not safe for the environment.
+ */
+export function resolveApiBase(env: ApiEnv): string {
+  const deployEnv = resolveDeployEnv(env);
+  const raw = (env.VITE_API_URL ?? "").trim();
+
+  if (raw === "") {
+    if (deployEnv === "staging") {
+      throw new ApiConfigError(
+        "VITE_API_URL is not set. A staging or preview build must name its own backend explicitly; " +
+          "it will not fall back to a relative path, to localhost, or to production.",
+      );
+    }
+    return "";
+  }
+
+  let url: URL;
+  try {
+    url = new URL(raw);
+  } catch {
+    throw new ApiConfigError(`VITE_API_URL is not a valid URL: "${raw}"`);
+  }
+  if (url.username || url.password || url.search || url.hash) {
+    throw new ApiConfigError("VITE_API_URL must be a plain origin, without credentials, query or fragment.");
+  }
+  const path = url.pathname.replace(/\/+$/, "");
+  if (path !== "") {
+    throw new ApiConfigError('VITE_API_URL must be an origin only (no path). The app adds "/api/..." itself.');
+  }
+
+  if (deployEnv !== "development") {
+    if (url.protocol !== "https:") {
+      throw new ApiConfigError("VITE_API_URL must use https in a deployed build.");
+    }
+    if (isLocalHost(url.hostname)) {
+      throw new ApiConfigError("VITE_API_URL points at a local address in a deployed build.");
+    }
+  }
+  if (deployEnv === "staging" && KNOWN_PRODUCTION_API_HOSTS.includes(url.hostname.toLowerCase())) {
+    throw new ApiConfigError(
+      `VITE_API_URL points at the production backend (${url.hostname}) in a staging or preview build. ` +
+        "Staging must use its own backend.",
+    );
+  }
+
+  return url.origin;
+}
+
+/** Joins the API base and an "/api/..." path. Absolute URLs are returned unchanged. */
+export function joinApiUrl(base: string, pathOrUrl: string): string {
+  if (/^[a-z][a-z0-9+.-]*:/i.test(pathOrUrl)) return pathOrUrl;
+  return `${base}${pathOrUrl.startsWith("/") ? "" : "/"}${pathOrUrl}`;
+}
+
+/** True when a URL (absolute or relative) addresses this app's API. */
+export function isApiUrl(base: string, url: string): boolean {
+  if (url.startsWith("/api/")) return true;
+  return base !== "" && url.startsWith(`${base}/api/`);
+}
+
+export type MediaLoadMode =
+  /** Not this API's media (public CDN URL, avatar, cover, thumbnail): use it as-is. */
+  | "direct"
+  /** This API's media: fetch it with the viewer's session token. */
+  | "authorized-fetch"
+  /** This API's video, with the media service worker adding the token to the browser's own requests. */
+  | "worker-stream"
+  /** This API's media, same origin, session cookie confirmed to reach it: let the browser stream it. */
+  | "cookie-stream";
+
+/**
+ * How the app must load a media address. Media served by this API is
+ * authorized per viewer on every request, so it is never loaded as a bare URL
+ * unless the session cookie is known to accompany it.
+ */
+export function mediaLoadMode(
+  url: string,
+  base: string,
+  cookieStreamingEnabled: boolean,
+  /** True only while the media service worker is in control of the page (video only). */
+  workerStreamingActive = false,
+): MediaLoadMode {
+  if (!isApiUrl(base, url)) return "direct";
+  if (base === "" && cookieStreamingEnabled) return "cookie-stream";
+  return workerStreamingActive ? "worker-stream" : "authorized-fetch";
+}
+
+export class ApiTargetError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "ApiTargetError";
+  }
+}
+
+/**
+ * The address an API request will be sent to. Throws unless the address is
+ * this app's own API, so the code that attaches the signed-in user's token
+ * can never be pointed at another site.
+ */
+export function apiRequestTarget(base: string, pathOrUrl: string): string {
+  if (typeof pathOrUrl !== "string" || !isApiUrl(base, pathOrUrl) || /[\\\s]/.test(pathOrUrl)) {
+    throw new ApiTargetError("apiFetch only sends requests to this app's API; it refuses any other address.");
+  }
+  return joinApiUrl(base, pathOrUrl);
+}
