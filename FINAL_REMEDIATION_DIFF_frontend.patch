+/**
+ * Decisions about showing media, kept free of React and browser APIs so they
+ * can be tested directly (see api-base.test.ts).
+ */
+
+// ─── Thumbnails ───────────────────────────────────────────────────────────────
+
+export type ThumbnailChoice =
+  | { kind: "image"; src: string }
+  | { kind: "placeholder"; mediaType: "video" | "image" | "pdf" | "none" };
+
+export interface ThumbnailSource {
+  thumbnailUrl?: string | null;
+  mediaUrl?: string | null;
+  mediaType?: string | null;
+}
+
+const PUBLIC_CLOUDINARY_VIDEO = /^(https:\/\/res\.cloudinary\.com\/[^/]+\/video\/upload\/.+)\.(?:mp4|mov|m4v|webm)$/i;
+
+/**
+ * A still image for a PUBLIC Cloudinary video (Cloudinary renders one when
+ * the extension is an image type). Protected videos and anything else: null.
+ */
+export function cloudinaryVideoPoster(url: string | null | undefined): string | null {
+  if (!url) return null;
+  const m = PUBLIC_CLOUDINARY_VIDEO.exec(url);
+  return m ? `${m[1]}.jpg` : null;
+}
+
+/**
+ * What to show as a post's small preview.
+ *
+ * Only ever returns an address that is an IMAGE. A video or document address
+ * is never returned as an image source: when there is no real thumbnail the
+ * caller shows a neutral placeholder.
+ */
+export function pickThumbnail(post: ThumbnailSource): ThumbnailChoice {
+  const type = post.mediaType === "video" || post.mediaType === "image" || post.mediaType === "pdf" ? post.mediaType : "none";
+  if (post.thumbnailUrl) return { kind: "image", src: post.thumbnailUrl };
+  if (type === "image" && post.mediaUrl) return { kind: "image", src: post.mediaUrl };
+  if (type === "video") {
+    const poster = cloudinaryVideoPoster(post.mediaUrl);
+    if (poster) return { kind: "image", src: poster };
+  }
+  return { kind: "placeholder", mediaType: type };
+}
+
+/**
+ * Image for a card that renders a plain <img> (home page rows). Such an
+ * element cannot carry the viewer's session, so an address served by this
+ * app's API is never used there; the fallback (the creator's avatar) is.
+ */
+export function plainCardImage(
+  post: ThumbnailSource,
+  isApiAddress: (url: string) => boolean,
+  fallback: string | null | undefined,
+): string | null {
+  const choice = pickThumbnail(post);
+  if (choice.kind === "image" && !isApiAddress(choice.src)) return choice.src;
+  return fallback ?? null;
+}
+
+// ─── When to download ─────────────────────────────────────────────────────────
+
+/**
+ * "manual":    only after the viewer asks (pressing play). Used for video.
+ * "visible":   when the element is on, or close to, the screen. Used for images.
+ * "immediate": as soon as it is rendered.
+ */
+export type LoadTrigger = "immediate" | "visible" | "manual";
+
+export function shouldFetchNow(input: {
+  /** From mediaLoadMode(): only "authorized-fetch" is downloaded by the app itself. */
+  mode: string;
+  trigger: LoadTrigger;
+  visible: boolean;
+  requested: boolean;
+  /** Whether the sign-in library has finished loading (so a token can exist). */
+  authLoaded: boolean;
+}): boolean {
+  if (input.mode !== "authorized-fetch") return false;
+  // Asking before the session is known would send no token and be refused.
+  if (!input.authLoaded) return false;
+  if (input.trigger === "immediate") return true;
+  if (input.trigger === "visible") return input.visible || input.requested;
+  return input.requested;
+}
+
+// ─── Failures ─────────────────────────────────────────────────────────────────
+
+export interface MediaFailure {
+  status: "signin" | "denied" | "error";
+  message: string;
+  /** Whether trying again could succeed without the viewer doing something else first. */
+  retryable: boolean;
+}
+
+export function failureFor(httpStatus: number, signedIn: boolean): MediaFailure {
+  if (httpStatus === 401) {
+    return signedIn
+      ? { status: "error", message: "Your session could not be confirmed. Try again.", retryable: true }
+      : { status: "signin", message: "Sign in to view this content.", retryable: false };
+  }
+  if (httpStatus === 403) return { status: "denied", message: "Subscribe to view this content.", retryable: false };
+  if (httpStatus === 404) return { status: "error", message: "This content is no longer available.", retryable: false };
+  if (httpStatus === 429) return { status: "error", message: "Too many requests. Wait a moment, then try again.", retryable: true };
+  return { status: "error", message: "This content could not be loaded. Try again.", retryable: true };
+}
+
+export const NETWORK_FAILURE: MediaFailure = {
+  status: "error",
+  message: "Could not connect. Check your connection and try again.",
+  retryable: true,
+};
+
+/** Download progress from 0 to 1, or null when the total size is not known. */
+export function progressOf(loadedBytes: number, totalBytes: number): number | null {
+  if (!Number.isFinite(totalBytes) || totalBytes <= 0) return null;
+  return Math.max(0, Math.min(1, loadedBytes / totalBytes));
+}
