+function loadWorker(search: string, token: string | null = "session-token") {
+  const code = read(path.join(rootDir, "public/media-sw.js"));
+  const listeners: Record<string, (e: any) => void> = {};
+  const sent: Array<{ url: string; init: any }> = [];
+  let asked = 0;
+  // Minimal stand-in for MessageChannel so no real ports are left open.
+  class Channel {
+    port1: any = { onmessage: null };
+    port2: any = { postMessage: (data: unknown) => queueMicrotask(() => this.port1.onmessage?.({ data })) };
+  }
+  const page = { postMessage: (msg: any, ports: any[]) => { if (msg?.type === "media-token") { asked++; ports[0].postMessage({ token }); } } };
+  const self = {
+    location: { href: `https://app.example/media-sw.js${search}` },
+    addEventListener: (name: string, fn: (e: any) => void) => { listeners[name] = fn; },
+    skipWaiting() {},
+    clients: { claim() {}, get: async (id: string) => (id === "page" ? page : null) },
+  };
+  vm.runInNewContext(code, {
+    self, URL, Headers, Promise, setTimeout, clearTimeout, MessageChannel: Channel,
+    fetch: async (url: string, init: any) => { sent.push({ url, init }); return "upstream-response"; },
+  });
+  const request = async (url: string, opts: { method?: string; headers?: Record<string, string>; clientId?: string } = {}) => {
+    let answer: Promise<unknown> | null = null;
+    listeners.fetch({
+      request: { url, method: opts.method ?? "GET", headers: new Headers(opts.headers ?? {}) },
+      clientId: opts.clientId ?? "page",
+      respondWith: (p: Promise<unknown>) => { answer = p; },
+    });
+    return { handled: answer !== null, response: answer ? await answer : null };
+  };
+  return { request, sent, asked: () => asked };
+}
+
+const WORKER_PREFIX = "?prefix=" + encodeURIComponent(STAGING_API + "/api/media/");
+
+test("the streaming worker adds the token to this API's media requests only, and forwards byte ranges", async () => {
+  const w = loadWorker(WORKER_PREFIX);
+  const r = await w.request(STAGING_API + "/api/media/post/p1?x=1", { headers: { Range: "bytes=100-200" } });
+  assert.equal(r.handled, true);
+  assert.equal(r.response, "upstream-response");
+  assert.equal(w.sent.length, 1);
+  assert.equal(w.sent[0].url, STAGING_API + "/api/media/post/p1", "sent to the media address, without the query string");
+  assert.equal(w.sent[0].init.headers.get("authorization"), "Bearer session-token");
+  assert.equal(w.sent[0].init.headers.get("range"), "bytes=100-200", "seeking is passed through");
+  assert.equal(w.sent[0].init.credentials, "omit");
+  assert.equal(w.sent[0].init.cache, "no-store");
+  assert.equal(w.sent[0].init.redirect, "error", "a redirect cannot carry the token elsewhere");
+  assert.equal((await w.request(STAGING_API + "/api/media/lesson/l1")).handled, true);
+
+  // Everything else is left to the browser, and no token is asked for.
+  const before = w.asked();
+  for (const [url, method] of [
+    [STAGING_API + "/api/users/me", "GET"],
+    [STAGING_API + "/api/media/post/p1", "POST"],
+    [STAGING_API + "/api/media/album/p1", "GET"],
+    [STAGING_API + "/api/media/post/p1/extra", "GET"],
+    [STAGING_API + "/api/media/", "GET"],
+    [PROD_API + "/api/media/post/p1", "GET"],
+    [STAGING_API + ".evil.example/api/media/post/p1", "GET"],
+    ["https://evil.example/api/media/post/p1", "GET"],
+    ["https://res.cloudinary.com/demo/video/upload/v1/a.mp4", "GET"],
+    ["https://app.example/assets/index.js", "GET"],
+    ["https://app.example/api/media/post/p1", "GET"],
+  ]) {
+    assert.equal((await w.request(url, { method })).handled, false, `${method} ${url} must not be handled`);
+  }
+  assert.equal(w.asked(), before);
+  assert.equal(w.sent.length, 2, "nothing else was fetched by the worker");
+});
+
+test("the streaming worker sends no token when signed out, and does nothing when misconfigured", async () => {
+  const signedOut = loadWorker(WORKER_PREFIX, null);
+  const r = await signedOut.request(STAGING_API + "/api/media/post/p1");
+  assert.equal(r.handled, true);
+  assert.equal(signedOut.sent[0].init.headers.get("authorization"), null, "the server will answer 401");
+
+  // No page to ask: still no token is invented.
+  const orphan = loadWorker(WORKER_PREFIX);
+  await orphan.request(STAGING_API + "/api/media/post/p1", { clientId: "" });
+  assert.equal(orphan.sent[0].init.headers.get("authorization"), null);
+
+  for (const search of [
+    "",
+    "?prefix=",
+    "?prefix=not-a-url",
+    "?prefix=" + encodeURIComponent("http://insecure.example/api/media/"),
+    "?prefix=" + encodeURIComponent(STAGING_API + "/"),
+    "?prefix=" + encodeURIComponent(STAGING_API + "/api/"),
+    "?prefix=" + encodeURIComponent(STAGING_API + "/api/media/?x=1"),
+    "?prefix=" + encodeURIComponent("https://user:pw@evil.example/api/media/"),
+  ]) {
+    const w = loadWorker(search);
+    assert.equal((await w.request(STAGING_API + "/api/media/post/p1")).handled, false, `prefix ${search}`);
+    assert.equal((await w.request("https://evil.example/api/media/post/p1")).handled, false);
+    assert.equal(w.sent.length, 0);
+  }
+});
+
+test("streaming is opt-in, falls back to on-demand download, and cookie streaming stays off", () => {
+  // The worker mode is used only for this API's media and only while the worker is active.
+  assert.equal(mediaLoadMode(API_VIDEO, STAGING_API, false, true), "worker-stream");
+  assert.equal(mediaLoadMode(API_VIDEO, STAGING_API, false, false), "authorized-fetch", "falls back when the worker is not in control");
+  assert.equal(mediaLoadMode(API_VIDEO, STAGING_API, false), "authorized-fetch", "off by default");
+  assert.equal(mediaLoadMode(CDN_VIDEO, STAGING_API, false, true), "direct", "public media never goes through the worker or the backend");
+
+  const streaming = read(path.join(srcDir, "lib/media-streaming.ts"));
+  assert.match(streaming, /VITE_MEDIA_STREAMING === "service-worker"/);
