+/**
+ * The small preview of a post, used in lists (a creator's own posts, saved
+ * and liked posts).
+ *
+ * It shows a real image when there is one: the post's thumbnail, or the post
+ * itself when it is an image. It goes through ProtectedImage, so an address
+ * served by the API is loaded with the viewer's session and a public CDN
+ * address is loaded directly. A video or document address is never used as an
+ * image; without a usable thumbnail a neutral placeholder is shown.
+ */
+import { FileText, Image as ImageIcon, Play } from "lucide-react";
+import { ProtectedImage } from "@/components/protected-media";
+import { pickThumbnail, type ThumbnailSource } from "@/lib/media-logic";
+
+export function PostThumbnail({ post, className = "" }: { post: ThumbnailSource; className?: string }) {
+  const choice = pickThumbnail(post);
+  if (choice.kind === "image") {
+    return <ProtectedImage src={choice.src} alt="" className={`h-full w-full object-cover ${className}`} />;
+  }
+  const Icon = choice.mediaType === "video" ? Play : choice.mediaType === "image" ? ImageIcon : FileText;
+  return (
+    <div
+      aria-hidden
+      className={`h-full w-full flex items-center justify-center bg-muted text-muted-foreground/60 ${className}`}
+    >
+      <Icon className="h-5 w-5" />
+    </div>
+  );
+}
