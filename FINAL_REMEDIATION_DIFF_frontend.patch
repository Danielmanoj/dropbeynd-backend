+import { AlertCircle } from "lucide-react";
+
+// Phase 1A containment: the single source for the wording shown wherever a
+// payment-dependent action (subscribing, tipping, cards, billing) is disabled.
+export const PAYMENTS_UNAVAILABLE_TITLE = "Payments are temporarily unavailable";
+export const PAYMENTS_UNAVAILABLE_MESSAGE =
+  "We're upgrading our payment system. Subscriptions, tips and billing changes can't be made right now, and you won't be charged.";
+
+export function PaymentsUnavailableNotice({
+  message = PAYMENTS_UNAVAILABLE_MESSAGE,
+  className = "",
+}: {
+  message?: string;
+  className?: string;
+}) {
+  return (
+    <div
+      role="status"
+      className={`flex items-start gap-3 rounded-xl border border-amber-500/40 bg-amber-500/10 p-4 text-left ${className}`}
+    >
+      <AlertCircle className="h-5 w-5 shrink-0 text-amber-500 mt-0.5" />
+      <div>
+        <p className="text-sm font-semibold text-foreground">{PAYMENTS_UNAVAILABLE_TITLE}</p>
+        <p className="text-xs text-muted-foreground mt-1 leading-relaxed">{message}</p>
+      </div>
+    </div>
+  );
+}
