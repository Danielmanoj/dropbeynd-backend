+/**
+ * The app's one way to reach the backend.
+ *
+ *   API_BASE   the configured backend origin ("" means same-origin)
+ *   apiUrl()   builds a URL for an "/api/..." path
+ *   apiFetch() fetch() that always targets API_BASE and always sends the
+ *              signed-in user's Clerk token
+ *
+ * Because every request carries the token in a header, requests work the same
+ * whether the backend is on this site's origin or on another one, and no
+ * request depends on a cookie reaching a different site.
+ */
+import { apiRequestTarget, isApiUrl, joinApiUrl, resolveApiBase, resolveDeployEnv } from "./api-base";
+
+const env = import.meta.env as unknown as {
+  DEV?: boolean;
+  VITE_API_URL?: string;
+  VITE_APP_ENV?: string;
+  VITE_VERCEL_ENV?: string;
+};
+
+/** Throws at startup if the configuration is unsafe for this environment. */
+export const API_BASE: string = resolveApiBase(env);
+export const DEPLOY_ENV = resolveDeployEnv(env);
+
+/** URL for an API path such as "/api/users/me". Absolute URLs pass through. */
+export function apiUrl(pathOrUrl: string): string {
+  return joinApiUrl(API_BASE, pathOrUrl);
+}
+
+/** Whether a URL returned by the backend (possibly relative) points at this API. */
+export function isOwnApiUrl(url: string): boolean {
+  return isApiUrl(API_BASE, url);
+}
+
+/** The signed-in user's session token, or null when signed out. */
+export async function getAuthToken(): Promise<string | null> {
+  try {
+    return (await (window as any).Clerk?.session?.getToken()) ?? null;
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * fetch() for the API. Accepts an "/api/..." path or a URL built with apiUrl().
+ * Adds the Clerk bearer token unless the caller already set Authorization.
+ *
+ * Refuses any other address (it throws before anything is sent), so the
+ * token cannot be delivered to a third party by passing the wrong URL.
+ */
+export async function apiFetch(pathOrUrl: string, init: RequestInit = {}): Promise<Response> {
+  const target = apiRequestTarget(API_BASE, pathOrUrl);
+  const headers = new Headers(init.headers);
+  if (!headers.has("authorization")) {
+    const token = await getAuthToken();
+    if (token) headers.set("authorization", `Bearer ${token}`);
+  }
+  return fetch(target, { credentials: "include", ...init, headers });
+}
