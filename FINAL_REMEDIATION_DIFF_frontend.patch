@@ -0,0 +1,360 @@
+/**
+ * Displaying media that the API authorizes per viewer.
+ *
+ * The backend addresses protected media as /api/media/post/<id> (or lesson).
+ * That address is not a credential: the server decides on every request
+ * whether the person asking may see the file, so the request has to carry the
+ * signed-in user's session. An <img> or <video> tag cannot send an
+ * Authorization header, so for these addresses the file is fetched here with
+ * the user's Clerk token and shown from an in-memory object URL.
+ *
+ * What is downloaded, and when:
+ *   - Public media (Cloudinary avatars, covers, thumbnails, public posts) is
+ *     never routed through here: the browser loads it straight from the CDN.
+ *   - Protected IMAGES are downloaded when they come near the screen.
+ *   - Protected VIDEO is downloaded only when the viewer presses play. Until
+ *     then only the poster is shown. Progress is reported while it downloads.
+ *   - Nothing is requested until the sign-in library has loaded, and a
+ *     refused request is repeated when the viewer's sign-in state changes.
+ *   - Downloads are cancelled, and object URLs released, when the element
+ *     goes away or the address changes.
+ *
+ * Streaming (seeking without a full download) needs the browser's own media
+ * requests to be authorized. Two opt-in ways exist, both off by default
+ * because neither has been verified in a real browser:
+ *   VITE_MEDIA_STREAMING=service-worker  (see lib/media-streaming.ts)
+ *   VITE_MEDIA_COOKIE_AUTH=true          (API on this site's own origin only)
+ */
+import {
+  useCallback,
+  useEffect,
+  useRef,
+  useState,
+  type ImgHTMLAttributes,
+  type ReactNode,
+  type VideoHTMLAttributes,
+} from "react";
+import { useAuth } from "@clerk/react";
+import { API_BASE, apiFetch, apiUrl, isOwnApiUrl } from "@/lib/api";
+import { mediaLoadMode } from "@/lib/api-base";
+import { isMediaStreamingActive } from "@/lib/media-streaming";
+import {
+  NETWORK_FAILURE,
+  cloudinaryVideoPoster,
+  failureFor,
+  progressOf,
+  shouldFetchNow,
+  type LoadTrigger,
+} from "@/lib/media-logic";
+
+const COOKIE_STREAMING_ENABLED =
+  (import.meta.env as unknown as { VITE_MEDIA_COOKIE_AUTH?: string }).VITE_MEDIA_COOKIE_AUTH === "true";
+
+/** How far outside the screen an image may be before it starts loading. */
+const NEAR_VIEWPORT_MARGIN = "400px";
+
+type Inner =
+  | { status: "idle" | "waiting" }
+  | { status: "loading"; progress: number | null }
+  | { status: "ready"; src: string }
+  | { status: "signin" | "denied" | "error"; message: string; retryable: boolean };
+
+export interface MediaState {
+  /**
+   * idle: no address. waiting: not requested yet (show the poster).
+   * loading / ready. signin, denied, error: see `message`.
+   */
+  status: Inner["status"];
+  src: string | undefined;
+  /** 0 to 1 while loading, or null when the size is not known. */
+  progress: number | null;
+  message: string | undefined;
+  retryable: boolean;
+  /** True when the browser streams the media itself (public, or an opt-in streaming mode). */
+  streamed: boolean;
+  /** Ask for the media now (for example when play is pressed). */
+  load: () => void;
+  /** Try again after an error. */
+  retry: () => void;
+  /** Ref callback: attach to the element whose visibility should trigger loading. */
+  observe: (element: Element | null) => void;
+}
+
+export interface MediaOptions {
+  kind?: "image" | "video";
+  /** Defaults: images load when near the screen; video only when asked. */
+  trigger?: LoadTrigger;
+}
+
+/** Resolves a media address from the API into something a media element can show. */
+export function useMediaSrc(url: string | null | undefined, options: MediaOptions = {}): MediaState {
+  const kind = options.kind ?? "image";
+  const trigger: LoadTrigger = options.trigger ?? (kind === "video" ? "manual" : "visible");
+  const { isLoaded: authLoaded, isSignedIn, userId } = useAuth();
+
+  const mode = url
+    ? mediaLoadMode(url, API_BASE, COOKIE_STREAMING_ENABLED, kind === "video" && isMediaStreamingActive())
+    : "direct";
+
+  const [requested, setRequested] = useState(false);
+  const [visible, setVisible] = useState(false);
+  const [attempt, setAttempt] = useState(0);
+  const [state, setState] = useState<Inner>({ status: "idle" });
+
+  // A new address starts from nothing.
+  useEffect(() => {
+    setRequested(false);
+    setAttempt(0);
+  }, [url]);
+
+  // Visibility, for images that load when they come near the screen.
+  const observer = useRef<IntersectionObserver | null>(null);
+  const observe = useCallback((element: Element | null) => {
+    observer.current?.disconnect();
+    observer.current = null;
+    if (!element) return;
+    if (typeof IntersectionObserver === "undefined") {
+      setVisible(true);
+      return;
+    }
+    observer.current = new IntersectionObserver(
+      (entries) => {
+        if (entries.some((e) => e.isIntersecting)) {
+          setVisible(true);
+          observer.current?.disconnect();
+        }
+      },
+      { rootMargin: NEAR_VIEWPORT_MARGIN },
+    );
+    observer.current.observe(element);
+  }, []);
+  useEffect(() => () => observer.current?.disconnect(), []);
+
+  const fetchNow = shouldFetchNow({ mode, trigger, visible, requested, authLoaded: !!authLoaded });
+
+  useEffect(() => {
+    if (!url) {
+      setState({ status: "idle" });
+      return;
+    }
+    if (mode !== "authorized-fetch") {
+      // Public media, or API media the browser is able to authorize itself.
+      setState({ status: "ready", src: isOwnApiUrl(url) ? apiUrl(url) : url });
+      return;
+    }
+    if (!fetchNow) {
+      setState({ status: "waiting" });
+      return;
+    }
+
+    const controller = new AbortController();
+    let cancelled = false;
+    let objectUrl: string | null = null;
+    setState({ status: "loading", progress: null });
+
+    (async () => {
+      const res = await apiFetch(url, { signal: controller.signal });
+      if (cancelled) return;
+      if (!res.ok) {
+        const failure = failureFor(res.status, !!isSignedIn);
+        setState(failure);
+        return;
+      }
+      const type = res.headers.get("content-type") ?? "";
+      const total = Number(res.headers.get("content-length") ?? "0");
+      let blob: Blob;
+      if (res.body) {
+        const reader = res.body.getReader();
+        const chunks: BlobPart[] = [];
+        let loaded = 0;
+        let shown = -1;
+        for (;;) {
+          const { done, value } = await reader.read();
+          if (done) break;
+          chunks.push(value);
+          loaded += value.byteLength;
+          const progress = progressOf(loaded, total);
+          const step = progress === null ? -1 : Math.floor(progress * 50);
+          if (step !== shown && !cancelled) {
+            shown = step;
+            setState({ status: "loading", progress });
+          }
+        }
+        blob = new Blob(chunks, { type });
+      } else {
+        blob = await res.blob();
+      }
+      if (cancelled) return;
+      objectUrl = URL.createObjectURL(blob);
+      setState({ status: "ready", src: objectUrl });
+    })().catch(() => {
+      if (!cancelled) setState(NETWORK_FAILURE);
+    });
+
+    return () => {
+      cancelled = true;
+      controller.abort();
+      if (objectUrl) URL.revokeObjectURL(objectUrl);
+    };
+    // userId / isSignedIn: when the viewer signs in or out, ask again as them.
+  }, [url, mode, fetchNow, attempt, userId, isSignedIn]);
+
+  const load = useCallback(() => setRequested(true), []);
+  const retry = useCallback(() => {
+    setRequested(true);
+    setAttempt((n) => n + 1);
+  }, []);
+
+  return {
+    status: state.status,
+    src: state.status === "ready" ? state.src : undefined,
+    progress: state.status === "loading" ? state.progress : null,
+    message: "message" in state ? state.message : undefined,
+    retryable: "retryable" in state ? state.retryable : false,
+    streamed: mode !== "authorized-fetch",
+    load,
+    retry,
+    observe,
+  };
+}
+
+/** Shown in place of media that is not (yet) available. */
+export function MediaNotice({
+  media,
+  className,
+  children,
+}: {
+  media: Pick<MediaState, "status" | "progress" | "message" | "retryable" | "retry" | "observe">;
+  className?: string;
+  children?: ReactNode;
+}) {
+  const percent = media.progress === null ? null : Math.round(media.progress * 100);
+  return (
+    <div
+      ref={media.observe}
+      role="status"
+      aria-busy={media.status === "loading"}
+      className={`flex flex-col items-center justify-center gap-2 bg-muted text-muted-foreground text-xs text-center p-2 ${className ?? ""}`}
+      style={{ minHeight: 48 }}
+    >
+      {media.status === "loading" && <span>{percent === null ? "Loading…" : `Loading… ${percent}%`}</span>}
+      {media.status === "loading" && percent !== null && (
+        <span className="block h-1 w-24 max-w-full rounded-full bg-border overflow-hidden" aria-hidden>
+          <span className="block h-full bg-primary" style={{ width: `${percent}%` }} />
+        </span>
+      )}
+      {media.message && <span>{media.message}</span>}
+      {media.retryable && (
+        <button
+          type="button"
+          className="underline text-foreground"
+          onClick={(e) => {
+            e.stopPropagation();
+            e.preventDefault();
+            media.retry();
+          }}
+        >
+          Try again
+        </button>
+      )}
+      {children}
+    </div>
+  );
+}
+
+/**
+ * <img> for a media address from the API. Public URLs behave exactly like a
+ * lazily loaded <img>. Protected ones load when they come near the screen.
+ */
+export function ProtectedImage({
+  src,
+  className,
+  eager,
+  ...rest
+}: ImgHTMLAttributes<HTMLImageElement> & { src?: string | null; eager?: boolean }) {
+  const media = useMediaSrc(src, { kind: "image", trigger: eager ? "immediate" : "visible" });
+  if (media.status === "idle") return null;
+  if (media.status !== "ready") return <MediaNotice media={media} className={className} />;
+  return <img loading={eager ? "eager" : "lazy"} decoding="async" {...rest} src={media.src} className={className} />;
+}
+
+/**
+ * <video> for a media address from the API.
+ *
+ * Nothing is downloaded until the viewer presses play. A protected video is
+ * then fetched with their session (showing progress) and starts playing; a
+ * public or streamed one is left to the browser, which fetches it in ranges.
+ */
+export function ProtectedVideo({
+  src,
+  className,
+  poster,
+  ...rest
+}: VideoHTMLAttributes<HTMLVideoElement> & { src?: string | null }) {
+  const media = useMediaSrc(src, { kind: "video" });
+  const startedByViewer = useRef(false);
+  const posterSrc = poster ?? cloudinaryVideoPoster(src) ?? undefined;
+
+  if (media.status === "idle") return null;
+
+  if (media.status === "waiting") {
+    return (
+      <button
+        type="button"
+        aria-label="Play video"
+        onClick={() => {
+          startedByViewer.current = true;
+          media.load();
+        }}
+        className={`relative flex items-center justify-center bg-black text-white ${className ?? ""}`}
+        style={{ minHeight: 120 }}
+      >
+        {posterSrc && <img src={posterSrc} alt="" className="absolute inset-0 h-full w-full object-contain" />}
+        <span className="relative rounded-full bg-black/60 border border-white/30 px-5 py-3 text-sm font-medium">▶ Play</span>
+      </button>
+    );
+  }
+
+  if (media.status !== "ready") return <MediaNotice media={media} className={className} />;
+
+  return (
+    <video
+      {...rest}
+      src={media.src}
+      poster={posterSrc}
+      // A streamed video must not start downloading until play is pressed.
+      preload={media.streamed ? "none" : "auto"}
+      autoPlay={startedByViewer.current}
+      className={className}
+    />
+  );
+}
+
+/**
+ * Opens a protected file (such as a course PDF) in a new tab. A plain link
+ * cannot carry the user's session, so the file is fetched with it first.
+ * Returns false if the viewer is not allowed or the file cannot be loaded.
+ */
+export async function openProtectedFile(url: string): Promise<boolean> {
+  if (!isOwnApiUrl(url)) {
+    window.open(url, "_blank", "noopener,noreferrer");
+    return true;
+  }
+  // Open the tab synchronously so pop-up blockers treat it as user-initiated.
+  const tab = window.open("", "_blank");
+  try {
+    const res = await apiFetch(url);
+    if (!res.ok) {
+      tab?.close();
+      return false;
+    }
+    const objectUrl = URL.createObjectURL(await res.blob());
+    if (tab) tab.location.href = objectUrl;
+    else window.open(objectUrl, "_blank");
+    setTimeout(() => URL.revokeObjectURL(objectUrl), 60_000);
+    return true;
+  } catch {
+    tab?.close();
+    return false;
+  }
+}
