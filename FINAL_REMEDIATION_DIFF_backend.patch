+/**
+ * Internal, machine-to-machine routes. Not for browsers.
+ *
+ * POST /api/internal/reconcile runs one reconciliation pass. It is how a
+ * scheduler (a free external cron, a GitHub Actions schedule, or a Render cron
+ * job) triggers the job on a host that may be asleep.
+ *
+ * It is closed by default: with RECONCILE_SECRET unset the route does not
+ * exist (404). With it set, the caller must present it as a bearer token,
+ * compared in constant time. It accepts no parameters that affect what is
+ * written, and running it repeatedly is harmless.
+ */
+import crypto from "crypto";
+import { Router, type Request, type Response } from "express";
+import rateLimit from "express-rate-limit";
+import { billing as sharedBilling } from "../lib/billing/instance";
+import { BillingError, type BillingService } from "../lib/billing/service";
+
+function bearerMatches(header: string | undefined, secret: string): boolean {
+  const presented = header?.startsWith("Bearer ") ? header.slice(7).trim() : "";
+  if (!presented) return false;
+  const a = crypto.createHash("sha256").update(presented).digest();
+  const b = crypto.createHash("sha256").update(secret).digest();
+  return crypto.timingSafeEqual(a, b);
+}
+
+export function createInternalRouter(deps: { billing: Pick<BillingService, "reconcile">; secret: () => string | undefined }) {
+  const router = Router();
+
+  router.post(
+    "/reconcile",
+    rateLimit({ windowMs: 60_000, limit: 6, standardHeaders: true, legacyHeaders: false }),
+    async (req: Request, res: Response) => {
+      const secret = deps.secret()?.trim();
+      if (!secret || secret.length < 24) {
+        res.status(404).json({ error: "Not found" });
+        return;
+      }
+      if (!bearerMatches(req.headers.authorization, secret)) {
+        res.status(401).json({ error: "Unauthorized" });
+        return;
+      }
+      try {
+        const summary = await deps.billing.reconcile({
+          log: (entry) => (req as any).log?.info(entry, "Reconciliation"),
+        });
+        (req as any).log?.info(summary, "Reconciliation pass finished");
+        res.json(summary);
+      } catch (err) {
+        if (err instanceof BillingError) {
+          res.status(err.status).json({ error: err.message, code: err.code });
+          return;
+        }
+        (req as any).log?.error({ err }, "Reconciliation pass failed");
+        res.status(500).json({ error: "Reconciliation failed" });
+      }
+    },
+  );
+
+  return router;
+}
+
+export default createInternalRouter({ billing: sharedBilling, secret: () => process.env.RECONCILE_SECRET });
