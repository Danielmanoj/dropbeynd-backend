@@ -0,0 +1,134 @@
+/**
+ * Entitlement: the single definition of "this user may see this creator's paid
+ * content". Every access check in the API goes through this module.
+ *
+ * A subscription grants access only while ALL of these hold:
+ *   1. it was created through the payment provider (`provider = 'razorpay'`);
+ *   2. a signature-verified webhook has confirmed a captured payment
+ *      (`provider_verified_at` is set);
+ *   3. the provider reports it active (`status = 'active'`);
+ *   4. the paid period has not ended (`current_period_end`, plus a short grace
+ *      for the renewal webhook to arrive);
+ *   5. access has not been withdrawn, e.g. by a refund (`access_revoked_at`).
+ *
+ * Rows that predate provider billing have `provider` NULL and therefore never
+ * grant access, whatever their status column says.
+ *
+ * Imports the schema only, never the database connection, so it can be tested
+ * against any Postgres-compatible Drizzle database.
+ */
+import { and, eq, gt, isNotNull, isNull, or, type SQL } from "drizzle-orm";
+import type { PgDatabase, PgQueryResultHKT } from "drizzle-orm/pg-core";
+import { subscriptionsTable } from "../../db/schema/subscriptions";
+
+export const BILLING_PROVIDER = "razorpay";
+
+/**
+ * Razorpay charges a renewal at `current_end`; the "charged" webhook that moves
+ * the period forward normally follows within seconds. The grace keeps a paying
+ * subscriber from being locked out in that gap. A failed renewal does not
+ * benefit: it flips the status away from "active" as soon as it is reported.
+ */
+export const RENEWAL_GRACE_MS = 6 * 60 * 60 * 1000;
+
+// Any Drizzle Postgres database (node-postgres in production, PGlite in tests).
+export type BillingDb = PgDatabase<PgQueryResultHKT, any, any>;
+
+/**
+ * Temporary grace for subscriptions that predate provider billing.
+ *
+ * OFF unless LEGACY_SUBSCRIPTION_GRACE_UNTIL holds a date in the future. While
+ * it does, a pre-Razorpay row with status "active" also grants access, clearly
+ * as a legacy allowance: such rows are never marked verified and never count
+ * as revenue. When the date passes, the allowance ends by itself. No row is
+ * changed either way.
+ */
+export function legacyGraceUntil(env: Record<string, string | undefined> = process.env): Date | null {
+  const raw = env.LEGACY_SUBSCRIPTION_GRACE_UNTIL?.trim();
+  if (!raw) return null;
+  const date = new Date(raw);
+  return Number.isNaN(date.getTime()) ? null : date;
+}
+
+function graceActive(now: Date, graceUntil: Date | null): boolean {
+  return graceUntil != null && graceUntil.getTime() > now.getTime();
+}
+
+export function entitledSubscriptionWhere(
+  now: Date = new Date(),
+  graceUntil: Date | null = legacyGraceUntil(),
+): SQL {
+  const paid = and(
+    eq(subscriptionsTable.provider, BILLING_PROVIDER),
+    isNotNull(subscriptionsTable.providerVerifiedAt),
+    eq(subscriptionsTable.status, "active"),
+    gt(subscriptionsTable.currentPeriodEnd, new Date(now.getTime() - RENEWAL_GRACE_MS)),
+    isNull(subscriptionsTable.accessRevokedAt),
+  )!;
+  if (!graceActive(now, graceUntil)) return paid;
+  return or(paid, and(isNull(subscriptionsTable.provider), eq(subscriptionsTable.status, "active")))!;
+}
+
+/** True only for a subscription backed by a verified provider payment. */
+export function isPaidEntitlement(
+  sub: {
+    provider: string | null;
+    providerVerifiedAt: Date | null;
+    status: string;
+    currentPeriodEnd: Date | null;
+    accessRevokedAt: Date | null;
+  } | null | undefined,
+  now: Date = new Date(),
+): boolean {
+  if (!sub) return false;
+  return (
+    sub.provider === BILLING_PROVIDER &&
+    sub.providerVerifiedAt != null &&
+    sub.status === "active" &&
+    sub.currentPeriodEnd != null &&
+    sub.currentPeriodEnd.getTime() > now.getTime() - RENEWAL_GRACE_MS &&
+    sub.accessRevokedAt == null
+  );
+}
+
+/** The same rule as entitledSubscriptionWhere, applied to a row already in memory. */
+export function isSubscriptionEntitled(
+  sub: Parameters<typeof isPaidEntitlement>[0],
+  now: Date = new Date(),
+  graceUntil: Date | null = legacyGraceUntil(),
+): boolean {
+  if (!sub) return false;
+  if (isPaidEntitlement(sub, now)) return true;
+  return graceActive(now, graceUntil) && sub.provider == null && sub.status === "active";
+}
+
+export async function isEntitled(
+  db: BillingDb,
+  userId: string,
+  creatorId: string,
+  now: Date = new Date(),
+): Promise<boolean> {
+  const rows = await db
+    .select({ id: subscriptionsTable.id })
+    .from(subscriptionsTable)
+    .where(and(
+      eq(subscriptionsTable.userId, userId),
+      eq(subscriptionsTable.creatorId, creatorId),
+      entitledSubscriptionWhere(now),
+    ))
+    .limit(1);
+  return rows.length > 0;
+}
+
+/** Every creator whose paid content this user may currently see. */
+export async function entitledCreatorIds(
+  db: BillingDb,
+  userId: string,
+  now: Date = new Date(),
+): Promise<Set<string>> {
+  const rows = await db
+    .selectDistinct({ creatorId: subscriptionsTable.creatorId })
+    .from(subscriptionsTable)
+    .where(and(eq(subscriptionsTable.userId, userId), entitledSubscriptionWhere(now)));
+  return new Set(rows.map((r) => r.creatorId));
+}
