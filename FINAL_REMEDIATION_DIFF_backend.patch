+import crypto from "crypto";
+
+function hmacSha256Hex(message: string | Buffer, secret: string): string {
+  return crypto.createHmac("sha256", secret).update(message).digest("hex");
+}
+
+/** Constant-time comparison of two hex digests. False for any malformed input. */
+function safeEqualHex(a: string, b: string): boolean {
+  if (typeof a !== "string" || typeof b !== "string") return false;
+  if (!/^[0-9a-f]+$/i.test(a) || !/^[0-9a-f]+$/i.test(b)) return false;
+  const ba = Buffer.from(a.toLowerCase(), "hex");
+  const bb = Buffer.from(b.toLowerCase(), "hex");
+  if (ba.length !== bb.length || ba.length === 0) return false;
+  return crypto.timingSafeEqual(ba, bb);
+}
+
+/**
+ * Razorpay signs a webhook as HMAC-SHA256 of the exact request body bytes,
+ * keyed with the webhook secret, sent in the X-Razorpay-Signature header.
+ * The body must be the raw bytes received, never re-serialised JSON.
+ */
+export function verifyWebhookSignature(
+  rawBody: Buffer | string,
+  signature: string | undefined,
+  webhookSecret: string,
+): boolean {
+  if (!signature || !webhookSecret) return false;
+  return safeEqualHex(hmacSha256Hex(rawBody, webhookSecret), signature);
+}
+
+/**
+ * After Checkout completes for a subscription, Razorpay returns a signature of
+ * "<payment_id>|<subscription_id>" keyed with the API key secret.
+ */
+export function verifySubscriptionCheckoutSignature(
+  params: { paymentId: string; subscriptionId: string; signature: string | undefined },
+  keySecret: string,
+): boolean {
+  if (!params.signature || !params.paymentId || !params.subscriptionId || !keySecret) return false;
+  const expected = hmacSha256Hex(`${params.paymentId}|${params.subscriptionId}`, keySecret);
+  return safeEqualHex(expected, params.signature);
+}
+
+export function sha256Hex(data: Buffer | string): string {
+  return crypto.createHash("sha256").update(data).digest("hex");
+}
