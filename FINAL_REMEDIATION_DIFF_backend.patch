+import rateLimit, { ipKeyGenerator } from "express-rate-limit";
+import type { Request, RequestHandler } from "express";
+
+/**
+ * Per-account limits for actions that cost money, send something to another
+ * person, or write to the database. They sit on top of the global per-IP limit
+ * in app.ts and are keyed by the signed-in user, so they hold even when many
+ * users share one address (for example behind the Vercel proxy).
+ *
+ * Use AFTER requireAuth in a route's middleware chain.
+ */
+function perUser(options: { windowMs: number; limit: number; message: string }) {
+  return rateLimit({
+    windowMs: options.windowMs,
+    limit: options.limit,
+    standardHeaders: true,
+    legacyHeaders: false,
+    keyGenerator: (req: Request) => {
+      const id = (req as any).dbUser?.id;
+      return id ? `user:${id}` : ipKeyGenerator(req.ip ?? "");
+    },
+    message: { error: options.message, code: "RATE_LIMITED" },
+  });
+}
+
+/** Starting, confirming and cancelling subscriptions. */
+export const billingLimiter = perUser({
+  windowMs: 10 * 60_000,
+  limit: 30,
+  message: "Too many payment requests. Please wait a few minutes and try again.",
+});
+
+/** Direct messages: limits spam and harassment volume. */
+export const messageLimiter = perUser({
+  windowMs: 60_000,
+  limit: 20,
+  message: "You're sending messages too quickly. Please slow down.",
+});
+
+/** Comments, reports, support tickets and similar user-generated writes. */
+export const writeLimiter = perUser({
+  windowMs: 60_000,
+  limit: 30,
+  message: "Too many requests. Please slow down and try again shortly.",
+});
+
+// ─── Media ────────────────────────────────────────────────────────────────────
+
+export interface MediaLimits {
+  windowMs: number;
+  /** Whole-file requests per window for a signed-in viewer / for an anonymous address. */
+  authenticated: number;
+  anonymous: number;
+  /** Byte-range requests per window (video playback and seeking). */
+  authenticatedRange: number;
+  anonymousRange: number;
+}
+
+export const DEFAULT_MEDIA_LIMITS: MediaLimits = {
+  windowMs: 60_000,
+  authenticated: 300,
+  anonymous: 60,
+  authenticatedRange: 1500,
+  anonymousRange: 240,
+};
+
+/**
+ * Limits for /api/media. Use AFTER the viewer has been identified.
+ *
+ * - The key is the signed-in user's id, or the client address when signed
+ *   out. It never includes the path, the query string or any header the
+ *   client controls, so asking for a different item, adding parameters or
+ *   changing headers does not give a fresh allowance.
+ * - Signed-in viewers get a generous allowance; anonymous addresses a
+ *   tighter one.
+ * - A video player fetches one file as many byte-range requests. Those are
+ *   counted in their own, larger allowance so normal playback and seeking is
+ *   not throttled. Sending a Range header is therefore not a way around the
+ *   limit: it only moves the request to another bounded allowance.
+ * - A refused request is answered 429 before the database or storage is touched.
+ */
+export function createMediaLimiter(limits: MediaLimits = DEFAULT_MEDIA_LIMITS): RequestHandler[] {
+  const viewerKey = (req: Request) => {
+    const id = (req as any).dbUser?.id;
+    return id ? `user:${id}` : `ip:${ipKeyGenerator(req.ip ?? "")}`;
+  };
+  const isRange = (req: Request) => typeof req.headers.range === "string" && req.headers.range.length > 0;
+  const signedIn = (req: Request) => !!(req as any).dbUser?.id;
+  const make = (range: boolean) =>
+    rateLimit({
+      windowMs: limits.windowMs,
+      limit: (req: Request) =>
+        range
+          ? (signedIn(req) ? limits.authenticatedRange : limits.anonymousRange)
+          : (signedIn(req) ? limits.authenticated : limits.anonymous),
+      standardHeaders: true,
+      legacyHeaders: false,
+      keyGenerator: (req: Request) => `${range ? "range" : "file"}:${viewerKey(req)}`,
+      skip: (req: Request) => isRange(req) !== range,
+      message: { error: "Too many media requests. Please wait a moment and try again.", code: "RATE_LIMITED" },
+    });
+  return [make(false), make(true)];
+}
