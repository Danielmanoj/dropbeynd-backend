+    await tx.update(subscriptionsTable).set(patch).where(eq(subscriptionsTable.id, row.id));
+    await recountSubscribers(tx, row.creatorId);
+
+    const outcome: WebhookOutcome = stale && !recordedPayment ? "ignored_stale" : "applied";
+    return { outcome, subjectId: entity.id };
+  }
+
+  async function applyRefundEvent(tx: BillingDb, body: any) {
+    const refund = body?.payload?.refund?.entity;
+    const paymentEntity = body?.payload?.payment?.entity;
