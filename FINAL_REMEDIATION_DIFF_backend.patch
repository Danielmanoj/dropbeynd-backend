+      assert.ok(!/insert\(\s*(subscriptionsTable|paymentsTable)\s*\)/.test(text), `${path.relative(src, f)} inserts billing rows`);
+      assert.ok(!/update\(\s*(subscriptionsTable|paymentsTable)\s*\)/.test(text), `${path.relative(src, f)} updates billing rows`);
+    }
+  }
+  const pkg = readFileSync(path.join(src, "../package.json"), "utf8");
+  assert.ok(!/"stripe"/.test(pkg), "the Stripe SDK must not be a dependency");
+});
