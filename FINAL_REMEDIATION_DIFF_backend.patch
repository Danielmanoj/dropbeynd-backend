+/**
+ * Protected media: addressing and authorization rules.
+ *
+ * The problem: media used to be handed to the browser as a URL that worked for
+ * anyone who held it. First a permanent public Cloudinary URL, then a signed
+ * link that expired after an hour. Either way the URL itself was the
+ * credential, so a copied link gave a stranger the file.
+ *
+ * How it works now:
+ *   1. Post and course media is stored at Cloudinary as type "authenticated",
+ *      which Cloudinary will not serve without a signature made with the API
+ *      secret. Only this server has that secret.
+ *   2. The API gives the browser a plain, stable address for the media:
+ *      /api/media/post/<postId> or /api/media/lesson/<lessonId>. It contains
+ *      no secret and grants nothing by itself.
+ *   3. routes/media.ts identifies WHO is asking, from their Clerk session, on
+ *      every request, and decides with canViewMedia() below whether that
+ *      person may see that item right now. Only then does it fetch the file
+ *      from Cloudinary with a server-made signature and stream it back.
+ *
+ * So access belongs to the viewer, not to the URL. Sending someone the address
+ * gives them nothing unless they sign in and are entitled themselves, and a
+ * subscriber whose access ends is refused on their very next request.
+ *
+ * This module has no database or network access, so it is unit-testable.
+ */
+
+export type MediaKind = "post" | "lesson";
+
+export interface MediaViewer {
+  id: string;
+  role: string;
+}
+
+/** What the authorization decision needs to know about one piece of media. */
+export interface MediaSubject {
+  kind: MediaKind;
+  /** creators.id of the owning creator. */
+  creatorId: string;
+  /** users.id of the account that owns that creator profile. */
+  creatorUserId: string;
+  /** Subscriber-only. Lessons always are. */
+  locked: boolean;
+  /** Approved and published for other people to see. */
+  visibleToOthers: boolean;
+  /** Taken down by moderation. Served to nobody. */
+  removed: boolean;
+}
+
+export type MediaDecision =
+  | { allow: true }
+  | { allow: false; status: 401 | 403 | 404; reason: string };
+
+/**
+ * May this viewer see this media right now?
+ *
+ *   - Removed content: nobody, not even with a previously working address.
+ *   - The creator who owns it, and administrators: yes (so creators can see
+ *     their own drafts and moderators can review).
+ *   - Content not yet approved or published: nobody else, and its existence
+ *     is not revealed (404).
+ *   - Public content: anyone, signed in or not.
+ *   - Subscriber-only content: only a signed-in viewer who is currently
+ *     entitled. `entitled` must come from lib/billing/entitlements.ts, checked
+ *     for THIS viewer at the time of THIS request.
+ */
+export function canViewMedia(
+  subject: MediaSubject | null | undefined,
+  viewer: MediaViewer | null | undefined,
+  entitled: boolean,
+): MediaDecision {
+  if (!subject || subject.removed) return { allow: false, status: 404, reason: "not_found" };
+
+  const isOwner = !!viewer && viewer.id === subject.creatorUserId;
+  const isAdmin = viewer?.role === "admin";
+  if (isOwner || isAdmin) return { allow: true };
+
+  if (!subject.visibleToOthers) return { allow: false, status: 404, reason: "not_found" };
+  if (!subject.locked) return { allow: true };
+
+  if (!viewer) return { allow: false, status: 401, reason: "sign_in_required" };
+  if (!entitled) return { allow: false, status: 403, reason: "not_entitled" };
+  return { allow: true };
+}
+
+/** True for a Cloudinary delivery URL of an "authenticated" asset. */
+export function isAuthenticatedCloudinaryUrl(url: string): boolean {
+  return /^https:\/\/res\.cloudinary\.com\/[^/]+\/(image|video|raw)\/authenticated\//.test(url);
+}
+
+/** Only Cloudinary delivery URLs are ever fetched by the media route. */
+export function isCloudinaryDeliveryUrl(url: string, cloudName?: string | null): boolean {
+  let parsed: URL;
+  try {
+    parsed = new URL(url);
+  } catch {
+    return false;
+  }
+  if (parsed.protocol !== "https:" || parsed.hostname !== "res.cloudinary.com") return false;
+  if (parsed.username || parsed.password || parsed.port) return false;
+  if (cloudName && !parsed.pathname.startsWith(`/${cloudName}/`)) return false;
+  return true;
+}
+
+/**
+ * The address the API gives the browser for a piece of media, or null.
+ *
+ *   - caller has no access      → null (the API omits it entirely)
+ *   - public post, public asset → the Cloudinary URL as-is (served by the CDN)
+ *   - anything else             → /api/media/<kind>/<id>, which authorizes the
+ *                                 viewer on every request
+ *
+ * A locked post whose media is not on Cloudinary (old seed content on other
+ * hosts) cannot be served through this server; it is returned as-is to
+ * entitled viewers only, as before.
+ */
+export function deliveryUrl(input: {
+  kind: MediaKind;
+  id: string;
+  rawUrl: string | null | undefined;
+  locked: boolean;
+  canAccess: boolean;
+  env?: Record<string, string | undefined>;
+}): string | null {
+  const env = input.env ?? process.env;
+  if (!input.rawUrl || !input.canAccess) return null;
+
+  const needsProtection = input.locked || isAuthenticatedCloudinaryUrl(input.rawUrl);
+  if (!needsProtection) return input.rawUrl;
+  if (!isCloudinaryDeliveryUrl(input.rawUrl)) return input.rawUrl;
+
+  // Normally relative: the frontend resolves it against its configured API
+  // base. MEDIA_BASE_URL is only for clients that cannot do that.
+  const base = (env.MEDIA_BASE_URL ?? "").replace(/\/+$/, "");
