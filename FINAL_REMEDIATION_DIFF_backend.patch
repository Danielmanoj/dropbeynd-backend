 const router = Router();
 
+type SubscriptionRow = typeof subscriptionsTable.$inferSelect;
+
+/**
+ * What the subscriber is shown. `entitled` is the only field that means "you
+ * have access"; it comes from the single entitlement rule. `status` is a
+ * display value derived from it, so a row can never read "active" while its
+ * content is locked.
+ */
+export function toSubscriptionView(
+  sub: SubscriptionRow,
+  creator: { name: string; avatarUrl: string | null; monthlyPrice: unknown; priceCurrency?: string | null } | null | undefined,
+  now: Date = new Date(),
+) {
+  const entitled = isSubscriptionEntitled(sub, now);
+  let status: string = sub.status;
+  if (entitled) status = "active";
+  // "active" without entitlement: an older record with no verified payment, or
+  // a paid period that has lapsed.
+  else if (sub.status === "active") status = "expired";
+
+  return {
+    id: sub.id,
+    userId: sub.userId,
+    creatorId: sub.creatorId,
+    creatorName: creator?.name ?? "Unknown",
+    creatorAvatarUrl: creator?.avatarUrl ?? null,
+    // The subscriber's own agreed amount and currency when known; otherwise
+    // (records from before provider billing) the creator's list price.
+    monthlyPrice: sub.amountMinor != null ? sub.amountMinor / 100 : parseFloat(String(creator?.monthlyPrice ?? "0")),
+    currency: sub.amountMinor != null && sub.currency ? sub.currency : normalizeCurrency(creator?.priceCurrency),
+    status,
+    entitled,
+    cancelRequested: sub.cancelRequestedAt != null,
+    currentPeriodEnd: entitled ? sub.currentPeriodEnd : null,
+    createdAt: sub.createdAt,
+  };
+}
+
+/** Best row to represent a user's relationship with one creator. */
+function pickRepresentative(rows: SubscriptionRow[], now: Date): SubscriptionRow | undefined {
+  return (
+    rows.find((r) => isSubscriptionEntitled(r, now)) ??
+    // Unpaid checkouts are not subscriptions; do not present them as one.
+    rows.find((r) => r.status !== "pending") ??
+    undefined
+  );
+}
