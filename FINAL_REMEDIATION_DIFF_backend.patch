+        status: "pending",
+        provider: BILLING_PROVIDER,
+        providerSubscriptionId: created.id,
+        providerPlanId: planId,
+        providerStatus: "created",
+        currency,
+        amountMinor,
+        createdAt: now(),
+        updatedAt: now(),
