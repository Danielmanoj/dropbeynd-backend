+# Calls the reconciliation endpoint on a schedule. The host may be asleep
+# between requests, so an external trigger is what guarantees it runs.
+#
+# Repository secrets required:
+#   API_BASE_URL      e.g. https://your-backend.onrender.com
+#   RECONCILE_SECRET  the same value set on the backend
+name: Reconcile subscriptions
+on:
+  schedule:
+    - cron: "17 * * * *"   # hourly
+  workflow_dispatch: {}
+jobs:
+  reconcile:
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      - name: Run one reconciliation pass
+        env:
+          API_BASE_URL: ${{ secrets.API_BASE_URL }}
+          RECONCILE_SECRET: ${{ secrets.RECONCILE_SECRET }}
+        run: |
+          test -n "$API_BASE_URL" && test -n "$RECONCILE_SECRET"
+          curl --fail --silent --show-error --max-time 240 \
+            -X POST "$API_BASE_URL/api/internal/reconcile" \
+            -H "Authorization: Bearer $RECONCILE_SECRET"
