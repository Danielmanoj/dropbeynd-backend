+-- 0004_reconciliation_and_safety.sql
+--
+-- ADDITIVE and safe to re-run. Requires 0001 and 0003. No row is updated or
+-- deleted, and no column or table is dropped.
+
+-- When each subscription was last compared with Razorpay.
+ALTER TABLE subscriptions
+  ADD COLUMN IF NOT EXISTS last_reconciled_at timestamp;
+
+CREATE INDEX IF NOT EXISTS subscriptions_reconcile_idx
+  ON subscriptions (last_reconciled_at)
+  WHERE provider IS NOT NULL;
+
+-- Payment records must outlive the account that made them. Until now deleting
+-- a user deleted their payments (ON DELETE CASCADE). The payer reference
+-- becomes optional and is cleared instead, so the financial record remains.
+ALTER TABLE payments ALTER COLUMN user_id DROP NOT NULL;
+
+DO $$
+DECLARE
+  fk record;
+BEGIN
+  FOR fk IN
+    SELECT con.conname
+    FROM pg_constraint con
+    JOIN pg_attribute att ON att.attrelid = con.conrelid AND att.attnum = ANY (con.conkey)
+    WHERE con.conrelid = 'payments'::regclass
+      AND con.contype = 'f'
+      AND con.confrelid = 'users'::regclass
+      AND att.attname = 'user_id'
+      AND con.confdeltype <> 'n'
+  LOOP
+    EXECUTE format('ALTER TABLE payments DROP CONSTRAINT %I', fk.conname);
+    EXECUTE 'ALTER TABLE payments ADD CONSTRAINT payments_user_id_users_id_fk
+             FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE SET NULL';
+  END LOOP;
+END $$;
+
+-- Indexes for the lookups the application performs on every page. Each is
+-- created only if its table exists, so this file also runs on a partial schema.
+DO $$
+BEGIN
+  IF to_regclass('public.posts') IS NOT NULL THEN
+    CREATE INDEX IF NOT EXISTS posts_creator_created_idx ON posts (creator_id, created_at DESC);
+    CREATE INDEX IF NOT EXISTS posts_status_created_idx  ON posts (moderation_status, created_at DESC);
+  END IF;
+  IF to_regclass('public.comments') IS NOT NULL THEN
+    CREATE INDEX IF NOT EXISTS comments_post_created_idx ON comments (post_id, created_at DESC);
+  END IF;
+  IF to_regclass('public.messages') IS NOT NULL THEN
+    CREATE INDEX IF NOT EXISTS messages_receiver_unread_idx ON messages (receiver_id, is_read);
+    CREATE INDEX IF NOT EXISTS messages_pair_created_idx    ON messages (sender_id, receiver_id, created_at DESC);
+  END IF;
+  IF to_regclass('public.notifications') IS NOT NULL THEN
+    CREATE INDEX IF NOT EXISTS notifications_user_unread_idx ON notifications (user_id, is_read);
+  END IF;
+  IF to_regclass('public.courses') IS NOT NULL THEN
+    CREATE INDEX IF NOT EXISTS courses_creator_idx ON courses (creator_id);
+  END IF;
+  IF to_regclass('public.lessons') IS NOT NULL THEN
+    CREATE INDEX IF NOT EXISTS lessons_course_order_idx ON lessons (course_id, order_index);
+  END IF;
+  IF to_regclass('public.creators') IS NOT NULL THEN
+    CREATE INDEX IF NOT EXISTS creators_user_idx ON creators (user_id);
+  END IF;
+  IF to_regclass('public.stories') IS NOT NULL THEN
+    CREATE INDEX IF NOT EXISTS stories_expires_idx ON stories (expires_at);
+  END IF;
+END $$;
