+    // larger of what is stored and this refund, so "created" followed by
+    // "processed" for the same refund is not counted twice.
+    const reported = Number.isInteger(paymentEntity?.amount_refunded)
+      ? paymentEntity.amount_refunded
+      : Number.isInteger(refund?.amount) ? refund.amount : 0;
+    const refundedMinor = Math.min(amountMinor, Math.max(alreadyMinor, reported));
+    const fullyRefunded = amountMinor > 0 && refundedMinor >= amountMinor;
+
+    await tx
+      .update(paymentsTable)
+      .set({ refundedAmount: minorToDecimal(refundedMinor), status: fullyRefunded ? "refunded" : payment.status })
+      .where(eq(paymentsTable.id, payment.id));
+
+    // Refunding the charge that paid for the current period ends access now.
+    if (fullyRefunded && payment.subscriptionId) {
+      const [latest] = await tx
+        .select({ id: paymentsTable.id })
+        .from(paymentsTable)
+        .where(eq(paymentsTable.subscriptionId, payment.subscriptionId))
+        .orderBy(desc(paymentsTable.createdAt))
+        .limit(1);
+      if (latest?.id === payment.id) {
+        await tx
+          .update(subscriptionsTable)
+          .set({ accessRevokedAt: now(), updatedAt: now() })
+          .where(eq(subscriptionsTable.id, payment.subscriptionId));
+        if (payment.creatorId) await recountSubscribers(tx, payment.creatorId);
+      }
+    }
+
+    return { outcome: "applied" as WebhookOutcome, subjectId: providerPaymentId };
+  }
+
+  /**
+   * @param rawBody   the exact bytes of the request body
+   * @param signature the X-Razorpay-Signature header
+   * @param eventId   the X-Razorpay-Event-Id header, when present
+   */
+  async function handleWebhook(
+    rawBody: Buffer,
+    signature: string | undefined,
+    eventId: string | undefined,
+  ): Promise<{ outcome: WebhookOutcome; eventType: string }> {
+    const config = requireConfig();
+
+    // Nothing in the body is read until the signature over its bytes checks out.
+    if (!Buffer.isBuffer(rawBody) || !verifyWebhookSignature(rawBody, signature, config.webhookSecret)) {
+      throw new BillingError(400, "INVALID_SIGNATURE", "Webhook signature verification failed");
+    }
+
+    let body: any;
+    try {
+      body = JSON.parse(rawBody.toString("utf8"));
+    } catch {
+      throw new BillingError(400, "INVALID_PAYLOAD", "Webhook body is not valid JSON");
+    }
+    const eventType = typeof body?.event === "string" ? body.event : "unknown";
+    const payloadSha256 = sha256Hex(rawBody);
+    // Razorpay sends a unique id per event; retries of an event repeat it.
+    // Fall back to the body hash so an identical redelivery is still caught.
+    const id = eventId?.trim() || `sha256:${payloadSha256}`;
+    const eventAt = unixToDate(body?.created_at) ?? now();
+
+    const outcome = await db.transaction(async (tx: BillingDb): Promise<WebhookOutcome> => {
+      const claimed = await tx
+        .insert(paymentEventsTable)
+        .values({ id, provider: BILLING_PROVIDER, eventType, outcome: "processing", payloadSha256, receivedAt: now() })
+        .onConflictDoNothing()
+        .returning({ id: paymentEventsTable.id });
+      if (claimed.length === 0) return "duplicate";
+
+      let result: { outcome: WebhookOutcome; subjectId: string | null };
+      if (eventType.startsWith("subscription.")) {
+        result = await applySubscriptionEvent(tx, eventType, body, eventAt);
+      } else if (eventType === "refund.created" || eventType === "refund.processed") {
+        result = await applyRefundEvent(tx, body);
+      } else if (eventType === "payment.failed") {
+        // Kept in the ledger for audit. A failed renewal reaches subscription
+        // state through subscription.pending / subscription.halted.
+        result = { outcome: "recorded", subjectId: body?.payload?.payment?.entity?.id ?? null };
+      } else {
+        result = { outcome: "ignored_unhandled", subjectId: null };
+      }
+
+      await tx
+        .update(paymentEventsTable)
+        .set({ outcome: result.outcome, subjectId: result.subjectId })
+        .where(eq(paymentEventsTable.id, id));
+      return result.outcome;
+    });
+
+    return { outcome, eventType };
+  }
+
+  // ─── Reconciliation ─────────────────────────────────────────────────────────
+
+  /**
+   * Compares local subscriptions with Razorpay and corrects drift, for the
+   * case where a webhook never arrived. Razorpay's API, called with this
+   * server's credentials, is the authority; nothing from a browser is involved.
+   *
+   *   - Only subscriptions this server created, not yet finished, and not
+   *     checked recently, are examined, oldest check first.
+   *   - State is applied through the same rules as webhooks: it cannot revive
+   *     a finished subscription, and if a webhook landed after the provider
+   *     was read, the webhook's newer state wins.
+   *   - Paid invoices are recorded as payments by provider payment id, so
+   *     running this any number of times never double-counts.
+   *   - A provider failure for one subscription is logged and skipped.
+   */
+  async function reconcile(
+    options: { limit?: number; minAgeMs?: number; log?: (entry: Record<string, unknown>) => void } = {},
+  ) {
+    const config = requireConfig();
+    const razorpay = deps.razorpay(config);
+    const cutoff = new Date(now().getTime() - (options.minAgeMs ?? 30 * 60 * 1000));
+    const summary = { checked: 0, updated: 0, unchanged: 0, failed: 0, paymentsRecorded: 0 };
+
+    const candidates = await db
+      .select({ id: subscriptionsTable.id, providerSubscriptionId: subscriptionsTable.providerSubscriptionId })
+      .from(subscriptionsTable)
+      .where(and(
+        eq(subscriptionsTable.provider, BILLING_PROVIDER),
+        isNotNull(subscriptionsTable.providerSubscriptionId),
+        or(
+          isNull(subscriptionsTable.providerStatus),
+          notInArray(subscriptionsTable.providerStatus, [...TERMINAL_PROVIDER_STATUSES]),
+        ),
+        or(isNull(subscriptionsTable.lastReconciledAt), lt(subscriptionsTable.lastReconciledAt, cutoff)),
+      ))
+      .orderBy(sql`${subscriptionsTable.lastReconciledAt} ASC NULLS FIRST`)
+      .limit(Math.min(Math.max(options.limit ?? 50, 1), 500));
+
+    for (const candidate of candidates) {
+      summary.checked++;
+      try {
+        const readAt = now();
+        const remote = await razorpay.fetchSubscription(candidate.providerSubscriptionId!);
+        const invoices = await razorpay.fetchInvoices(candidate.providerSubscriptionId!);
+        if (remote?.id !== candidate.providerSubscriptionId || typeof remote.status !== "string") {
+          throw new Error("Provider returned an unexpected subscription");
+        }
+
+        const result = await db.transaction(async (tx: BillingDb) => {
+          const [row] = await tx.select().from(subscriptionsTable).where(eq(subscriptionsTable.id, candidate.id)).for("update");
+          if (!row) return { changed: false, payments: 0 };
+
+          const patch: Partial<typeof subscriptionsTable.$inferInsert> = { lastReconciledAt: now(), updatedAt: now() };
+          let changed = false;
+          // A webhook applied after the provider was read is newer than what was read.
+          const superseded = row.providerEventAt != null && row.providerEventAt.getTime() > readAt.getTime();
+          if (!superseded) {
+            const next = statePatch(row, remote, readAt);
+            if (!next.stale) {
+              changed =
+                next.patch.providerStatus !== row.providerStatus ||
+                (next.patch.currentPeriodEnd?.getTime() ?? row.currentPeriodEnd?.getTime()) !== row.currentPeriodEnd?.getTime();
+              Object.assign(patch, next.patch);
+            }
+          }
+
+          let payments = 0;
+          for (const invoice of invoices) {
+            if (invoice.status !== "paid" || typeof invoice.payment_id !== "string") continue;
+            if (!Number.isInteger(invoice.amount_paid) || (invoice.amount_paid as number) <= 0) continue;
+            const inserted = await tx
+              .insert(paymentsTable)
+              .values({
+                id: crypto.randomUUID(),
+                userId: row.userId,
+                creatorId: row.creatorId,
+                amount: minorToDecimal(invoice.amount_paid as number),
+                currency: (String(invoice.currency ?? "") || row.currency || "").toLowerCase().slice(0, 3) || "usd",
+                status: "succeeded",
+                provider: BILLING_PROVIDER,
+                providerPaymentId: invoice.payment_id,
+                providerVerifiedAt: now(),
+                subscriptionId: row.id,
+                createdAt: unixToDate(invoice.paid_at) ?? now(),
+              })
+              .onConflictDoNothing()
+              .returning({ id: paymentsTable.id });
+            payments += inserted.length;
+            // A paid invoice is provider proof of a captured charge.
+            patch.providerVerifiedAt = row.providerVerifiedAt ?? now();
+          }
+          if (payments > 0) changed = true;
+
+          await tx.update(subscriptionsTable).set(patch).where(eq(subscriptionsTable.id, row.id));
+          await recountSubscribers(tx, row.creatorId);
+          return { changed, payments };
+        });
+
+        summary.paymentsRecorded += result.payments;
+        if (result.changed) summary.updated++;
+        else summary.unchanged++;
+        if (result.changed) options.log?.({ subscription: candidate.providerSubscriptionId, outcome: "corrected", payments: result.payments });
+      } catch (err) {
+        summary.failed++;
+        options.log?.({ subscription: candidate.providerSubscriptionId, outcome: "failed", error: err instanceof Error ? err.message : String(err) });
+      }
+    }
+    return summary;
+  }
+
+  return { publicConfig, quote, startSubscription, confirmCheckout, requestCancellation, handleWebhook, reconcile };
+}
+
+export type BillingService = ReturnType<typeof createBillingService>;
