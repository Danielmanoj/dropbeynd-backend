+import {
+  BILLING_PROVIDER,
+  entitledSubscriptionWhere,
+  isEntitled,
+  isSubscriptionEntitled,
+  type BillingDb,
+} from "./entitlements";
+import { RazorpayApiError, type RazorpayClient } from "./razorpayClient";
+import {
+  sha256Hex,
+  verifySubscriptionCheckoutSignature,
+  verifyWebhookSignature,
+} from "./signatures";
+
+export class BillingError extends Error {
+  constructor(
+    public readonly status: number,
+    public readonly code: string,
+    message: string,
+  ) {
+    super(message);
+    this.name = "BillingError";
+  }
+}
+
+export const PAYMENTS_UNAVAILABLE_MESSAGE =
+  "Payments are temporarily unavailable. No charge was made and nothing was changed.";
+
+type LocalStatus = "active" | "cancelled" | "expired" | "past_due" | "pending";
+
+/** Razorpay subscription status → local status. Only "active" can grant access. */
+export function mapProviderStatus(providerStatus: string): LocalStatus {
+  switch (providerStatus) {
+    case "active":
+      return "active";
+    case "created":
+    case "authenticated":
+      return "pending";
+    case "cancelled":
+      return "cancelled";
+    case "completed":
+    case "expired":
+      return "expired";
+    // "pending" (a renewal charge failed and is being retried), "halted"
+    // (retries exhausted), "paused", and anything unrecognised: no access.
+    default:
+      return "past_due";
+  }
+}
+
+const TERMINAL_PROVIDER_STATUSES = new Set(["cancelled", "completed", "expired"]);
+const CANCELLABLE_PROVIDER_STATUSES = ["created", "authenticated", "active", "pending", "halted", "paused"];
+const REUSE_PENDING_CHECKOUT_MS = 30 * 60 * 1000;
+/** Razorpay's minimum chargeable amount is one major unit (100 minor units). */
+const MIN_AMOUNT_MINOR = 100;
+
+/** "9.99" → 999. Null for anything that is not a plain non-negative 2-decimal amount. */
+export function toMinorUnits(amount: string | number | null | undefined): number | null {
+  const text = String(amount ?? "").trim();
+  const m = /^(\d{1,9})(?:\.(\d{1,2}))?$/.exec(text);
+  if (!m) return null;
+  return Number(m[1]) * 100 + Number((m[2] ?? "").padEnd(2, "0"));
+}
+
+/** 999 → "9.99". */
+export function minorToDecimal(minor: number): string {
+  const whole = Math.trunc(minor / 100);
+  return `${whole}.${String(Math.abs(minor % 100)).padStart(2, "0")}`;
+}
+
+function unixToDate(seconds: unknown): Date | null {
+  return typeof seconds === "number" && Number.isFinite(seconds) && seconds > 0
+    ? new Date(seconds * 1000)
+    : null;
+}
+
+export interface BillingUser {
+  id: string;
+}
+
+export interface BillingServiceDeps {
+  db: BillingDb;
+  getConfig: () => BillingConfig | BillingDisabled;
+  razorpay: (config: BillingConfig) => RazorpayClient;
+  now?: () => Date;
+}
+
+export type WebhookOutcome =
+  | "applied"
+  | "duplicate"
+  | "ignored_stale"
+  | "ignored_unknown_subscription"
+  | "ignored_unknown_payment"
+  | "ignored_malformed"
+  | "ignored_unhandled"
+  | "recorded";
+
+export function createBillingService(deps: BillingServiceDeps) {
+  const { db } = deps;
+  const now = deps.now ?? (() => new Date());
+
+  function requireConfig(): BillingConfig {
+    const config = deps.getConfig();
+    if (!config.enabled) {
+      throw new BillingError(503, "PAYMENTS_UNAVAILABLE", PAYMENTS_UNAVAILABLE_MESSAGE);
+    }
