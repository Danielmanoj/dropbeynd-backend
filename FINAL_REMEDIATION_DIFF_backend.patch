+test("every refusal and failure from the media route is uncacheable, and Vary keeps what was already set", async () => {
+  const m = await mediaServer({
+    "post:p1": lockedPost,
+    "post:internal": { ...lockedPost, rawUrl: "http://169.254.169.254/latest/meta-data/" },
+    "post:down": { ...lockedPost, rawUrl: "https://res.cloudinary.com/demo/video/authenticated/v1/storage-down.mp4" },
+    "post:removed": { ...lockedPost, removed: true },
+  }, new Set(["fan-user"]));
+  try {
+    const cases: Array<[string, string | undefined, number]> = [
+      ["post/p1", undefined, 401],
+      ["post/p1", "other-user", 403],
+      ["post/removed", "fan-user", 404],
+      ["post/missing", "fan-user", 404],
+      ["album/p1", "fan-user", 404],
+      ["post/internal", "fan-user", 404],
+      ["post/down", "fan-user", 502],
+    ];
+    for (const [path, user, status] of cases) {
+      const r = await m.get(path, user);
+      assert.equal(r.status, status, path);
+      assert.equal(r.headers.get("cache-control"), "no-store", `${path} (${status}) must not be cached`);
+      const vary = (r.headers.get("vary") ?? "").toLowerCase();
+      for (const v of ["origin", "authorization", "cookie"]) assert.ok(vary.includes(v), `${path}: Vary lost "${v}" (${vary})`);
+      assert.ok(!leaks((await r.text()).replace(/https?:\/\/127\.0\.0\.1\S*/g, "")), `${path}: body reveals storage`);
+    }
+    const ok = await m.get("post/p1", "fan-user");
+    assert.equal(ok.status, 200);
+    const vary = (ok.headers.get("vary") ?? "").toLowerCase();
+    for (const v of ["origin", "authorization", "cookie"]) assert.ok(vary.includes(v));
+
+    // Refused range requests never reach storage.
+    const before = m.fetched.length;
+    assert.equal((await m.get("post/p1", undefined, { Range: "bytes=0-100" })).status, 401);
+    assert.equal((await m.get("post/p1", "other-user", { Range: "bytes=0-100" })).status, 403);
+    assert.equal(m.fetched.length, before);
+  } finally {
+    await m.close();
+  }
+});
