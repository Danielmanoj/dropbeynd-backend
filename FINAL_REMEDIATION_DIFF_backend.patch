+-- 0003_regional_currency.sql
+--
+-- Regional currency support. ADDITIVE ONLY and safe to re-run. Requires 0001.
+-- No existing row is updated or deleted.
+--
+-- Existing creators get price_currency 'USD' through the column default. That
+-- matches how their prices have always been presented (with a "$" sign); it
+-- reinterprets nothing.
+
+-- The currency a creator's monthly_price is expressed in.
+ALTER TABLE creators
+  ADD COLUMN IF NOT EXISTS price_currency varchar(3) NOT NULL DEFAULT 'USD';
+
+-- What a subscriber agreed to pay, fixed when the checkout was started.
+ALTER TABLE subscriptions
+  ADD COLUMN IF NOT EXISTS currency     varchar(3),
+  ADD COLUMN IF NOT EXISTS amount_minor integer;
+
+-- One Razorpay plan per creator, currency and amount. Razorpay plans are
+-- immutable, so a change of price or of the conversion table adds a row here
+-- rather than editing one. (The razorpay_plan_* columns that 0001 added to
+-- creators are superseded by this table and are no longer used.)
+CREATE TABLE IF NOT EXISTS billing_plans (
+  id               text PRIMARY KEY,
+  creator_id       text NOT NULL REFERENCES creators(id) ON DELETE CASCADE,
+  provider         text NOT NULL,
+  provider_plan_id text NOT NULL,
+  currency         varchar(3) NOT NULL,
+  amount_minor     integer NOT NULL,
+  created_at       timestamp NOT NULL DEFAULT now()
+);
+
+CREATE UNIQUE INDEX IF NOT EXISTS billing_plans_creator_currency_amount_uq
+  ON billing_plans (provider, creator_id, currency, amount_minor);
