+/**
+ * GET /api/media/post/:id and /api/media/lesson/:id — serves protected media
+ * to a viewer who is authorized to see it.
+ *
+ * On EVERY request, including each byte-range request a video player makes:
+ *   1. the viewer is identified from their Clerk session (Authorization
+ *      bearer token, or Clerk's session cookie when the API is same-site);
+ *   2. the item is loaded from the database as it is now;
+ *   3. canViewMedia() decides, using the viewer's CURRENT entitlement;
+ *   4. only then is the file fetched from Cloudinary, with a signature made
+ *      here, and streamed back.
+ *
+ * The address carries no secret. Copying it to someone else gives them a
+ * request that is evaluated as THEM: signed out → 401, not entitled → 403.
+ */
+import { Router, type Request, type RequestHandler, type Response } from "express";
+import { Readable } from "stream";
+import { eq } from "drizzle-orm";
+import { db, postsTable, lessonsTable } from "../db";
+import { optionalAuth } from "../lib/auth";
+import { createMediaLimiter } from "../lib/rateLimits";
+import { isEntitled } from "../lib/billing/entitlements";
+import { signedDeliveryUrl } from "../lib/cloudinary";
+import {
+  canViewMedia,
+  isCloudinaryDeliveryUrl,
+  type MediaKind,
+  type MediaSubject,
+  type MediaViewer,
+} from "../lib/mediaAccess";
+
+export interface StoredMedia extends MediaSubject {
+  /** The stored media URL. Never sent to the client by this route. */
+  rawUrl: string | null;
+}
+
+export interface MediaRouterDeps {
+  /** Establishes req.dbUser when the request carries a valid session; never rejects. */
+  identify: RequestHandler;
+  /** The item as it is in the database now, or null. */
+  load: (kind: MediaKind, id: string) => Promise<StoredMedia | null>;
+  /** Whether this user is entitled to this creator's paid content right now. */
+  isEntitled: (userId: string, creatorId: string) => Promise<boolean>;
+  /** Turns a stored URL into one Cloudinary will serve to this server. */
+  sign: (rawUrl: string) => string;
+  fetch: typeof globalThis.fetch;
+  /** Rate limiting, run after the viewer is identified and before anything is loaded. */
+  limiter?: RequestHandler[];
+}
+
+const PASS_THROUGH_HEADERS = ["content-type", "content-length", "content-range", "accept-ranges", "last-modified", "etag"];
+
+const DENIAL_MESSAGES: Record<string, string> = {
+  not_found: "Media not found",
+  sign_in_required: "Sign in to view this content.",
+  not_entitled: "An active subscription is required to view this content.",
+};
+
+export function createMediaRouter(deps: MediaRouterDeps) {
+  const router = Router();
+
+  // Defaults for EVERY response from this router, including refusals, rate
+  // limiting and upstream failures: never stored, and never reused for a
+  // different viewer. Only a successful response replaces Cache-Control.
+  // res.vary() ADDS to the header, so the CORS layer's "Vary: Origin" is kept.
+  const safeDefaults: RequestHandler = (_req, res, next) => {
+    res.vary("Authorization");
+    res.vary("Cookie");
+    res.setHeader("Cache-Control", "no-store");
+    next();
+  };
+
+  router.get("/:kind/:id", safeDefaults, deps.identify, ...(deps.limiter ?? []), async (req: Request, res: Response) => {
+    const kind = req.params.kind;
+    if (kind !== "post" && kind !== "lesson") {
+      res.status(404).json({ error: DENIAL_MESSAGES.not_found });
+      return;
+    }
+
+    const viewer = ((req as any).dbUser ?? null) as MediaViewer | null;
+    const item = await deps.load(kind, String(req.params.id));
+
+    // Entitlement is looked up for THIS viewer on THIS request, and only when
+    // it can matter.
+    const needsEntitlement =
+      !!item && !!viewer && item.locked && viewer.id !== item.creatorUserId && viewer.role !== "admin";
+    const entitled = needsEntitlement ? await deps.isEntitled(viewer!.id, item!.creatorId) : false;
+
+    const decision = canViewMedia(item, viewer, entitled);
+    if (!decision.allow) {
+      res.status(decision.status).json({ error: DENIAL_MESSAGES[decision.reason] ?? "Not available", code: decision.reason });
+      return;
+    }
+
+    // Never fetch anything but a Cloudinary delivery URL, whatever is stored.
+    if (!item!.rawUrl || !isCloudinaryDeliveryUrl(item!.rawUrl)) {
+      res.status(404).json({ error: DENIAL_MESSAGES.not_found });
+      return;
+    }
+
+    const headers: Record<string, string> = {};
+    const range = req.headers.range;
+    // Forward byte ranges so video can seek.
+    if (typeof range === "string" && /^bytes=\d*-\d*$/.test(range)) headers.Range = range;
+
+    let upstream: globalThis.Response;
+    try {
+      upstream = await deps.fetch(deps.sign(item!.rawUrl), { headers, redirect: "error" });
+    } catch (err) {
+      // Log the failure, never the upstream URL: it carries a signature.
+      (req as any).log?.warn({ kind, err: err instanceof Error ? err.name : "error" }, "Protected media fetch failed");
+      res.status(502).json({ error: "Media is temporarily unavailable." });
+      return;
+    }
+    if (!upstream.ok && upstream.status !== 206) {
+      res.status(upstream.status === 404 ? 404 : 502).json({ error: "Media is temporarily unavailable." });
+      return;
+    }
+
+    res.status(upstream.status);
+    for (const name of PASS_THROUGH_HEADERS) {
+      const value = upstream.headers.get(name);
+      if (value) res.setHeader(name, value);
+    }
+    // Subscriber-only bytes must not be stored where another person could get
+    // them, so they are never cached. Public content may be cached briefly by
+    // the viewer's own browser.
+    res.setHeader("Cache-Control", item!.locked ? "private, no-store" : "private, max-age=300");
+    res.setHeader("X-Content-Type-Options", "nosniff");
+    res.setHeader("Referrer-Policy", "no-referrer");
+    res.setHeader("Content-Disposition", "inline");
+    res.setHeader("Cross-Origin-Resource-Policy", "cross-origin");
+
+    if (!upstream.body) {
+      res.end();
+      return;
+    }
+    const stream = Readable.fromWeb(upstream.body as any);
+    stream.on("error", () => res.destroy());
+    req.on("close", () => stream.destroy());
+    stream.pipe(res);
+  });
+
+  return router;
+}
+
+async function loadStoredMedia(kind: MediaKind, id: string): Promise<StoredMedia | null> {
+  if (kind === "post") {
+    const post = await db.query.postsTable.findFirst({ where: eq(postsTable.id, id), with: { creator: true } });
+    const creator = (post as any)?.creator;
+    if (!post || !creator) return null;
+    return {
+      kind,
+      rawUrl: post.mediaUrl ?? null,
+      creatorId: post.creatorId,
+      creatorUserId: creator.userId,
+      locked: post.isLocked,
+      visibleToOthers: post.moderationStatus === "active",
+      removed: post.moderationStatus === "removed",
+    };
+  }
+  const lesson = await db.query.lessonsTable.findFirst({
+    where: eq(lessonsTable.id, id),
+    with: { course: { with: { creator: true } } },
+  });
+  const course = (lesson as any)?.course;
+  if (!lesson || !course?.creator) return null;
+  return {
+    kind,
+    rawUrl: lesson.contentUrl ?? null,
+    creatorId: course.creatorId,
+    creatorUserId: course.creator.userId,
+    // Course material is always for subscribers.
+    locked: true,
+    visibleToOthers: course.isPublished === true,
+    removed: false,
+  };
+}
+
+export default createMediaRouter({
+  identify: optionalAuth,
+  load: loadStoredMedia,
+  isEntitled: (userId, creatorId) => isEntitled(db, userId, creatorId),
+  sign: signedDeliveryUrl,
+  fetch: (...args) => globalThis.fetch(...args),
+  limiter: createMediaLimiter(),
+});
