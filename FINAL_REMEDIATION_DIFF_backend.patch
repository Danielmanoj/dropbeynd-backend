+/**
+ * Runs reconciliation periodically while the server is up.
+ * RECONCILE_INTERVAL_MINUTES sets the period (default 60; 0 disables). On a
+ * host that sleeps when idle this cannot run during sleep; pair it with the
+ * scheduled trigger described in routes/internal.ts.
+ */
+function startReconciliationTimer() {
+  const minutes = Number(process.env.RECONCILE_INTERVAL_MINUTES ?? "60");
+  if (!Number.isFinite(minutes) || minutes <= 0) return;
+  let running = false;
+  const timer = setInterval(async () => {
+    if (running || !readBillingConfig().enabled) return;
+    running = true;
+    try {
+      const summary = await billing.reconcile({ log: (entry) => logger.info(entry, "Reconciliation") });
+      if (summary.checked > 0) logger.info(summary, "Reconciliation pass finished");
+    } catch (err) {
+      logger.error({ err }, "Reconciliation pass failed");
+    } finally {
+      running = false;
+    }
+  }, minutes * 60_000);
+  timer.unref();
+}
