+    }
+    throw err;
+  }
+
+  /**
+   * What the browser needs to open Checkout and show prices. Contains no secret.
+   * `country` is the caller's detected country, if any; it only chooses which
+   * currency is offered first.
+   */
+  function publicConfig(country: string | null = null) {
+    const config = deps.getConfig();
+    if (!config.enabled) return { enabled: false as const };
+    return {
+      enabled: true as const,
+      keyId: config.keyId,
+      mode: config.mode,
+      // In "region" mode only the visitor's regional currency is offered.
+      currencies: config.currencySelection === "region" ? [regionalCurrency(country, config)] : config.currencies,
+      currencySelection: config.currencySelection,
+      defaultCurrency: config.defaultCurrency,
+      suggestedCurrency: regionalCurrency(country, config),
