+# Staging backend. Create it as its OWN Render service pointing at its OWN
+# Neon database (a branch of production is ideal) and Razorpay TEST MODE keys.
+# Nothing here may share a database, webhook secret or keys with production.
+services:
+  - type: web
+    name: dropbeynd-backend-staging
+    env: node
+    plan: free
+    buildCommand: npm install --legacy-peer-deps && npm run build
+    startCommand: npm start
+    healthCheckPath: /api/healthz
+    envVars:
+      - key: NODE_ENV
+        value: production
+      - key: PORT
+        value: 10000
+      - key: DATABASE_URL          # staging Neon branch, never production
+        sync: false
+      - key: CLERK_SECRET_KEY
+        sync: false
+      - key: CLERK_PUBLISHABLE_KEY
+        sync: false
+      - key: CLOUDINARY_CLOUD_NAME
+        sync: false
+      - key: CLOUDINARY_API_KEY
+        sync: false
+      - key: CLOUDINARY_API_SECRET
+        sync: false
+      - key: FRONTEND_URL          # the Vercel preview/staging URL
+        sync: false
+      - key: RAZORPAY_KEY_ID       # rzp_test_...
+        sync: false
+      - key: RAZORPAY_KEY_SECRET
+        sync: false
+      - key: RAZORPAY_WEBHOOK_SECRET   # staging-only secret
+        sync: false
+      - key: BILLING_CURRENCIES    # start with INR; add others only if the account supports them
+        value: INR
+      - key: BILLING_FX_RATES      # example values for testing only
