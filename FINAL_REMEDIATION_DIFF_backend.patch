+    assert.equal(p.allowedFormats, "mp4,mov");
+    // Cloudinary's scheme: SHA-1 of the sorted parameters followed by the API secret.
+    const toSign = `allowed_formats=mp4,mov&folder=creatorhub/posts&timestamp=${p.timestamp}&type=authenticated`;
