+/**
+ * Razorpay billing tests.
+ *
+ * What is real here: a Postgres engine (PGlite, in-process), the legacy table
+ * definitions, migration 0001 applied on top of them, the Express routes, the
+ * raw-body webhook path, and Razorpay's actual signature scheme (HMAC-SHA256).
+ *
+ * What is simulated: Razorpay's servers. The REST client is replaced by a fake
+ * that records calls, and webhooks are built and signed by the test with the
+ * same secret the server is configured with. These tests therefore prove the
+ * server's behaviour for events of the documented shape. They do NOT prove
+ * that Razorpay sends exactly those shapes: that needs a Razorpay Test Mode
+ * run with real test keys (see docs/RAZORPAY_BILLING.md).
+ *
+ * Run: npm test
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import crypto from "node:crypto";
+import { readFileSync, readdirSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import path from "node:path";
+import type { AddressInfo } from "node:net";
+import express from "express";
+import { PGlite } from "@electric-sql/pglite";
+import { drizzle } from "drizzle-orm/pglite";
+import { and, eq, sql } from "drizzle-orm";
+import * as schema from "../../db/schema";
+import { netPaymentAmount, providerConfirmedPayment } from "../paymentContainment";
+import { readBillingConfig, type BillingConfig, type BillingDisabled } from "./config";
+import { convertMinor, currencyForCountry, detectCountry, sumInCurrency } from "./currency";
+import {
+  entitledCreatorIds, entitledSubscriptionWhere, isEntitled, isPaidEntitlement,
+  isSubscriptionEntitled, legacyGraceUntil, RENEWAL_GRACE_MS,
+} from "./entitlements";
+import { RazorpayApiError, type RazorpayClient } from "./razorpayClient";
+import { createBillingService, minorToDecimal, toMinorUnits } from "./service";
+import { verifySubscriptionCheckoutSignature, verifyWebhookSignature } from "./signatures";
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+
+// routes/payments.ts also builds the production router at import, which loads
+// db/index.ts. That needs a URL to exist; nothing here ever connects to it.
+process.env.DATABASE_URL ??= "postgresql://unused:unused@127.0.0.1:1/unused";
+const MIGRATION_1 = readFileSync(path.join(here, "../../../migrations/0001_razorpay_billing.sql"), "utf8");
+const MIGRATION_3 = readFileSync(path.join(here, "../../../migrations/0003_regional_currency.sql"), "utf8");
+const MIGRATION_4 = readFileSync(path.join(here, "../../../migrations/0004_reconciliation_and_safety.sql"), "utf8");
+
+// The tables as they exist in production today, before migration 0001.
+const LEGACY_SCHEMA = `
+  CREATE TYPE user_role AS ENUM ('user', 'creator', 'admin');
+  CREATE TYPE subscription_status AS ENUM ('active', 'cancelled', 'expired', 'past_due');
+  CREATE TYPE payment_status AS ENUM ('succeeded', 'pending', 'failed', 'refunded');
+  CREATE TABLE users (
+    id text PRIMARY KEY, clerk_id text UNIQUE NOT NULL, email varchar(255) UNIQUE NOT NULL,
+    name text, avatar_url text, role user_role NOT NULL DEFAULT 'user',
+    role_selected boolean NOT NULL DEFAULT false, is_suspended boolean NOT NULL DEFAULT false,
+    created_at timestamp NOT NULL DEFAULT now());
+  CREATE TABLE creators (
+    id text PRIMARY KEY, user_id text NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+    name text NOT NULL, bio text, niche text, avatar_url text, cover_url text,
+    monthly_price numeric(10,2) NOT NULL DEFAULT 9.99, subscriber_count integer NOT NULL DEFAULT 0,
+    stripe_product_id text, stripe_price_id text, created_at timestamp NOT NULL DEFAULT now());
+  CREATE TABLE subscriptions (
+    id text PRIMARY KEY, user_id text NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+    creator_id text NOT NULL REFERENCES creators(id) ON DELETE CASCADE,
+    status subscription_status NOT NULL DEFAULT 'active', stripe_subscription_id text,
+    current_period_end timestamp, created_at timestamp NOT NULL DEFAULT now());
+  CREATE TABLE payments (
+    id text PRIMARY KEY, user_id text NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+    creator_id text REFERENCES creators(id) ON DELETE SET NULL,
+    amount numeric(10,2) NOT NULL, currency varchar(3) NOT NULL DEFAULT 'usd',
+    status payment_status NOT NULL DEFAULT 'pending', stripe_payment_intent_id text,
+    created_at timestamp NOT NULL DEFAULT now());
+`;
+
+const SEED = `
+  INSERT INTO users (id, clerk_id, email, name) VALUES
+    ('owner', 'c_owner', 'owner@example.test', 'Owner'),
+    ('fan',   'c_fan',   'fan@example.test',   'Fan'),
+    ('other', 'c_other', 'other@example.test', 'Other');
+  INSERT INTO creators (id, user_id, name, monthly_price, subscriber_count) VALUES
+    ('creator1', 'owner', 'Creator One', 9.99, 42);
+  -- A subscription and payment written by the removed fake-payment paths.
+  INSERT INTO subscriptions (id, user_id, creator_id, status, stripe_subscription_id, current_period_end) VALUES
+    ('legacy_sub', 'other', 'creator1', 'active', 'sub_forged', now() + interval '10 years');
+  INSERT INTO payments (id, user_id, creator_id, amount, status) VALUES
+    ('legacy_pay', 'other', 'creator1', 500.00, 'succeeded');
+`;
+
+const TEST_ENV = {
+  RAZORPAY_KEY_ID: "rzp_test_unitTestKey",
+  RAZORPAY_KEY_SECRET: "unit-test-key-secret",
+  RAZORPAY_WEBHOOK_SECRET: "unit-test-webhook-secret",
+  BILLING_CURRENCIES: "INR,USD,GBP,EUR",
+  // A fixed table: units of each currency per one US dollar.
+  BILLING_FX_RATES: JSON.stringify({ USD: 1, INR: 98, GBP: 0.8, EUR: 0.9 }),
+};
+
+const DAY = 24 * 60 * 60 * 1000;
+const T0 = Date.parse("2026-01-01T00:00:00Z");
+
+async function setup() {
+  const client = new PGlite();
+  await client.exec(LEGACY_SCHEMA);
+  await client.exec(SEED);
+  await client.exec(MIGRATION_1);
+  await client.exec(MIGRATION_3);
+  await client.exec(MIGRATION_4);
+  const db = drizzle(client, { schema });
+
+  let clock = T0;
+  let env: Record<string, string | undefined> = { ...TEST_ENV };
+  const calls: Array<{ op: string; args: any }> = [];
+  let failNext = false;
+  let seq = 0;
+  // What "Razorpay" would answer when asked about a subscription (reconciliation).
+  const remote = new Map<string, { sub: any; invoices: any[] } | "error">();
+
+  const razorpay: RazorpayClient = {
+    async createPlan(args) {
+      calls.push({ op: "createPlan", args });
+      if (failNext) { failNext = false; throw new RazorpayApiError(400, "BAD_REQUEST_ERROR", "secret provider detail"); }
+      return { id: `plan_${++seq}`, period: "monthly", interval: 1, item: { name: args.name, amount: args.amountMinor, currency: args.currency } };
+    },
+    async createSubscription(args) {
+      calls.push({ op: "createSubscription", args });
+      return { id: `sub_${++seq}`, plan_id: args.planId, status: "created", current_start: null, current_end: null, ended_at: null };
+    },
+    async cancelSubscription(id, atCycleEnd) {
+      calls.push({ op: "cancelSubscription", args: { id, atCycleEnd } });
+      return { id, plan_id: "plan", status: atCycleEnd ? "active" : "cancelled", current_start: null, current_end: null, ended_at: null };
+    },
+    async fetchSubscription(id) {
+      calls.push({ op: "fetchSubscription", args: { id } });
+      const entry = remote.get(id);
+      if (!entry || entry === "error") throw new RazorpayApiError(500, "SERVER_ERROR", "provider unavailable");
+      return entry.sub;
+    },
+    async fetchInvoices(id) {
+      const entry = remote.get(id);
+      if (!entry || entry === "error") throw new RazorpayApiError(500, "SERVER_ERROR", "provider unavailable");
+      return entry.invoices;
+    },
+  };
+
+  const billing = createBillingService({
+    db: db as any,
+    getConfig: (): BillingConfig | BillingDisabled => readBillingConfig(env),
+    razorpay: () => razorpay,
+    now: () => new Date(clock),
+  });
+
+  const { createPaymentsRouter } = await import("../../routes/payments");
+  const app = express();
+  // Same order as app.ts: raw body for the webhook, then JSON.
+  app.use("/api/payments/webhook", express.raw({ type: () => true, limit: "1mb" }));
+  app.use(express.json());
+  app.use(
+    "/api/payments",
+    createPaymentsRouter({
+      billing,
+      // The production per-account limiter is process-wide; each test gets its own.
+      limiter: (_req, _res, next) => next(),
+      requireAuth: (req, res, next) => {
+        const id = req.headers["x-test-user"];
+        if (typeof id !== "string") { res.status(401).json({ error: "Unauthorized" }); return; }
+        (req as any).dbUser = { id };
+        next();
+      },
+    }),
+  );
+  const server = await new Promise<import("node:http").Server>((resolve) => {
+    const s = app.listen(0, "127.0.0.1", () => resolve(s));
+  });
+  const base = `http://127.0.0.1:${(server.address() as AddressInfo).port}/api/payments`;
+
+  async function api(method: string, pathname: string, user: string | null, body?: unknown) {
+    const res = await fetch(base + pathname, {
+      method,
+      headers: { "Content-Type": "application/json", ...(user ? { "x-test-user": user } : {}) },
+      body: body === undefined ? undefined : JSON.stringify(body),
+    });
+    return { status: res.status, json: (await res.json()) as any };
+  }
+
+  let eventSeq = 0;
+  /** Deliver a webhook. By default it is correctly signed, like Razorpay's. */
+  async function webhook(event: object, opts: { signature?: string | null; eventId?: string | null; rawBody?: string } = {}) {
+    const raw = opts.rawBody ?? JSON.stringify(event);
+    const signature =
+      opts.signature === undefined
+        ? crypto.createHmac("sha256", TEST_ENV.RAZORPAY_WEBHOOK_SECRET).update(raw).digest("hex")
+        : opts.signature;
+    const eventId = opts.eventId === undefined ? `evt_${++eventSeq}` : opts.eventId;
+    const headers: Record<string, string> = { "Content-Type": "application/json" };
+    if (signature) headers["X-Razorpay-Signature"] = signature;
+    if (eventId) headers["X-Razorpay-Event-Id"] = eventId;
+    const res = await fetch(base + "/webhook", { method: "POST", headers, body: raw });
+    return { status: res.status, json: (await res.json()) as any };
+  }
+
+  const sec = (ms: number) => Math.floor(ms / 1000);
+  /** A Razorpay subscription event of the documented shape. */
+  function subEvent(
+    type: string,
+    subId: string,
+    status: string,
+    o: { start?: number; end?: number; endedAt?: number; at?: number; payment?: { id: string; amount: number; status?: string; currency?: string } } = {},
+  ) {
+    const payload: any = {
+      subscription: {
+        entity: {
+          id: subId, entity: "subscription", status,
+          current_start: o.start ? sec(o.start) : null,
+          current_end: o.end ? sec(o.end) : null,
+          ended_at: o.endedAt ? sec(o.endedAt) : null,
+          notes: { userId: "ATTACKER-CONTROLLED", creatorId: "ATTACKER-CONTROLLED" },
+        },
+      },
+    };
+    if (o.payment) {
+      payload.payment = {
+        entity: {
+          id: o.payment.id, entity: "payment", amount: o.payment.amount, currency: o.payment.currency ?? "USD",
+          status: o.payment.status ?? "captured", created_at: sec(o.at ?? clock),
+          email: "someone@example.test", contact: "+910000000000",
+        },
+      };
+    }
+    return { entity: "event", event: type, contains: Object.keys(payload), payload, created_at: sec(o.at ?? clock) };
+  }
+
+  async function subRow(providerId: string) {
+    const [row] = await db.select().from(schema.subscriptionsTable)
+      .where(eq(schema.subscriptionsTable.providerSubscriptionId, providerId));
+    return row;
+  }
+  const entitled = (user = "fan") => isEntitled(db as any, user, "creator1", new Date(clock));
+  async function revenue() {
+    const [r] = await db.select({ total: sql<string>`COALESCE(SUM(${netPaymentAmount()}), 0)` })
+      .from(schema.paymentsTable)
+      .where(and(eq(schema.paymentsTable.creatorId, "creator1"), providerConfirmedPayment()));
+    return Number(r.total);
+  }
+  const count = async (table: any) => Number((await db.select({ n: sql<number>`count(*)::int` }).from(table))[0].n);
+
+  /** Start a checkout as `fan` and take it to a paid, active first period. */
+  async function activate(paymentId = "pay_1") {
+    const start = await api("POST", "/subscriptions", "fan", { creatorId: "creator1", currency: "USD" });
+    assert.equal(start.status, 201);
+    const subId = start.json.subscriptionId as string;
+    const r = await webhook(subEvent("subscription.charged", subId, "active", {
+      start: clock, end: clock + 30 * DAY, payment: { id: paymentId, amount: 999 },
+    }));
+    assert.equal(r.status, 200);
+    return subId;
+  }
+
+  return {
+    db, client, base, api, webhook, billing, remote, sec, subEvent, subRow, entitled, revenue, count, activate, calls,
+    setEnv: (e: Record<string, string | undefined>) => { env = e; },
+    advance: (ms: number) => { clock += ms; },
+    now: () => clock,
+    failNextProviderCall: () => { failNext = true; },
+    async close() { await new Promise((r) => server.close(r)); await client.close(); },
+  };
+}
+
+type Ctx = Awaited<ReturnType<typeof setup>>;
+function withBilling(name: string, fn: (t: Ctx) => Promise<void>) {
+  test(name, async () => {
+    const t = await setup();
+    try { await fn(t); } finally { await t.close(); }
+  });
+}
+
+// ─── Signatures ───────────────────────────────────────────────────────────────
+
+test("webhook signature matches Razorpay's published example", () => {
+  // From the razorpay-node documentation: body, secret and expected signature.
+  const body = '{"a":1,"b":2,"c":{"d":3}}';
+  const expected = "2fe04e22977002e6c7cb553adab8b460cb9e2a4970d5953cb27a8472752e3bbc";
+  assert.equal(verifyWebhookSignature(Buffer.from(body), expected, "123456"), true);
+  assert.equal(verifyWebhookSignature(Buffer.from(body + " "), expected, "123456"), false, "any byte change must fail");
+  assert.equal(verifyWebhookSignature(Buffer.from(body), expected, "1234567"), false);
+  assert.equal(verifyWebhookSignature(Buffer.from(body), undefined, "123456"), false);
+  assert.equal(verifyWebhookSignature(Buffer.from(body), "", "123456"), false);
+  assert.equal(verifyWebhookSignature(Buffer.from(body), "not-hex", "123456"), false);
+  assert.equal(verifyWebhookSignature(Buffer.from(body), expected.slice(0, 10), "123456"), false);
+  assert.equal(verifyWebhookSignature(Buffer.from(body), expected, ""), false);
+});
+
+test("checkout signature is HMAC of payment_id|subscription_id with the key secret", () => {
+  const signature = crypto.createHmac("sha256", "k").update("pay_A|sub_B").digest("hex");
+  assert.equal(verifySubscriptionCheckoutSignature({ paymentId: "pay_A", subscriptionId: "sub_B", signature }, "k"), true);
+  assert.equal(verifySubscriptionCheckoutSignature({ paymentId: "pay_X", subscriptionId: "sub_B", signature }, "k"), false);
+  assert.equal(verifySubscriptionCheckoutSignature({ paymentId: "pay_A", subscriptionId: "sub_X", signature }, "k"), false);
+  assert.equal(verifySubscriptionCheckoutSignature({ paymentId: "pay_A", subscriptionId: "sub_B", signature }, "other"), false);
+  assert.equal(verifySubscriptionCheckoutSignature({ paymentId: "pay_A", subscriptionId: "sub_B", signature: undefined }, "k"), false);
+});
+
+// ─── Configuration ────────────────────────────────────────────────────────────
+
+test("billing is off unless fully configured, and live keys need an explicit switch", () => {
+  assert.equal(readBillingConfig({}).enabled, false);
+  for (const key of Object.keys(TEST_ENV)) {
+    assert.equal(readBillingConfig({ ...TEST_ENV, [key]: "" }).enabled, false, `${key} missing must disable billing`);
+  }
+  const testMode = readBillingConfig(TEST_ENV);
+  assert.ok(testMode.enabled && testMode.mode === "test");
+
+  const live = { ...TEST_ENV, RAZORPAY_KEY_ID: "rzp_live_abc" };
+  assert.equal(readBillingConfig(live).enabled, false, "a live key alone must not enable billing");
+  assert.equal(readBillingConfig({ ...live, RAZORPAY_LIVE_ENABLED: "1" }).enabled, false);
+  const liveOn = readBillingConfig({ ...live, RAZORPAY_LIVE_ENABLED: "true" });
+  assert.ok(liveOn.enabled && liveOn.mode === "live");
+
+  assert.equal(readBillingConfig({ ...TEST_ENV, RAZORPAY_KEY_ID: "sk_test_stripe_style" }).enabled, false);
+  assert.equal(readBillingConfig({ ...TEST_ENV, BILLING_CURRENCIES: "INR,JPY" }).enabled, false, "unsupported currency");
+  assert.equal(readBillingConfig({ ...TEST_ENV, BILLING_FX_RATES: "not json" }).enabled, false);
+  assert.equal(readBillingConfig({ ...TEST_ENV, BILLING_FX_RATES: JSON.stringify({ USD: 1, INR: 98 }) }).enabled, false, "a rate is missing");
+  assert.equal(readBillingConfig({ ...TEST_ENV, BILLING_FX_RATES: JSON.stringify({ USD: 2, INR: 98, GBP: 0.8, EUR: 0.9 }) }).enabled, false, "USD must be 1");
+  assert.equal(readBillingConfig({ ...TEST_ENV, BILLING_FX_RATES: JSON.stringify({ USD: 1, INR: -1, GBP: 0.8, EUR: 0.9 }) }).enabled, false);
+  assert.equal(readBillingConfig({ ...TEST_ENV, BILLING_DEFAULT_CURRENCY: "JPY" }).enabled, false);
+  const only = readBillingConfig({ ...TEST_ENV, BILLING_CURRENCIES: "inr, gbp" });
+  assert.ok(only.enabled);
+  assert.deepEqual(only.currencies, ["INR", "GBP"]);
+  assert.equal(only.defaultCurrency, "INR", "falls back to the first offered currency when USD is not offered");
+});
+
+test("amounts convert exactly between decimal prices and minor units", () => {
+  assert.equal(toMinorUnits("9.99"), 999);
+  assert.equal(toMinorUnits("10"), 1000);
+  assert.equal(toMinorUnits("0.5"), 50);
+  assert.equal(toMinorUnits("19.90"), 1990);
+  for (const bad of ["-1", "1e3", "NaN", "", "1.234", "abc", null, undefined]) {
+    assert.equal(toMinorUnits(bad as any), null, `${bad} must be rejected`);
+  }
+  assert.equal(minorToDecimal(999), "9.99");
+  assert.equal(minorToDecimal(1000), "10.00");
+  assert.equal(minorToDecimal(5), "0.05");
+});
+
+// ─── Migration ────────────────────────────────────────────────────────────────
+
+withBilling("migrations are additive, repeatable, and leave existing rows untouched", async (t) => {
+  const before = await t.client.query("SELECT id, status, stripe_subscription_id FROM subscriptions WHERE id = 'legacy_sub'");
+  for (let run = 0; run < 2; run++) {
+    await t.client.exec(MIGRATION_1);
+    await t.client.exec(MIGRATION_3);
+    await t.client.exec(MIGRATION_4);
+  }
+  const after = await t.client.query("SELECT id, status, stripe_subscription_id FROM subscriptions WHERE id = 'legacy_sub'");
+  assert.deepEqual(after.rows, before.rows);
+  assert.deepEqual(after.rows, [{ id: "legacy_sub", status: "active", stripe_subscription_id: "sub_forged" }]);
+
+  const pay = await t.client.query("SELECT amount::text, status, provider, provider_verified_at FROM payments WHERE id = 'legacy_pay'");
+  assert.deepEqual(pay.rows, [{ amount: "500.00", status: "succeeded", provider: null, provider_verified_at: null }]);
+  const creator = await t.client.query("SELECT subscriber_count, monthly_price::text, price_currency FROM creators WHERE id = 'creator1'");
+  // Existing prices are untouched and are read as US dollars, as they were always displayed.
+  assert.deepEqual(creator.rows, [{ subscriber_count: 42, monthly_price: "9.99", price_currency: "USD" }]);
+});
+
+// ─── Entitlement of pre-existing data ─────────────────────────────────────────
+
+withBilling("a legacy 'active' subscription grants no access and a legacy payment is not revenue", async (t) => {
+  assert.equal(await t.entitled("other"), false);
+  assert.equal((await entitledCreatorIds(t.db as any, "other", new Date(t.now()))).size, 0);
+  assert.equal(await t.revenue(), 0);
+});
+
+// ─── Starting a subscription ──────────────────────────────────────────────────
+
+withBilling("starting a subscription creates a pending row with no access, priced by the server", async (t) => {
+  const r = await t.api("POST", "/subscriptions", "fan", {
+    creatorId: "creator1", currency: "USD", amount: 1, amountMinor: 1, price: "0.01", status: "active",
+  });
+  assert.equal(r.status, 201);
+  assert.equal(r.json.amountMinor, 999, "amount comes from the creator's stored price");
+  assert.equal(r.json.currency, "USD");
+  assert.equal(r.json.keyId, TEST_ENV.RAZORPAY_KEY_ID);
+  assert.ok(!JSON.stringify(r.json).includes(TEST_ENV.RAZORPAY_KEY_SECRET), "secret must never be returned");
+
+  const plan = t.calls.find((c) => c.op === "createPlan")!;
+  assert.equal(plan.args.amountMinor, 999);
+  assert.equal(plan.args.currency, "USD");
+
+  const row = await t.subRow(r.json.subscriptionId);
+  assert.equal(row.currency, "USD");
+  assert.equal(row.amountMinor, 999);
+  assert.equal(row.status, "pending");
+  assert.equal(row.userId, "fan");
+  assert.equal(row.providerVerifiedAt, null);
+  assert.equal(await t.entitled(), false);
+  assert.equal(await t.count(schema.paymentsTable), 1, "only the legacy row; no payment recorded");
+});
+
+withBilling("checkout requires sign-in, an existing creator, and not your own profile", async (t) => {
+  assert.equal((await t.api("POST", "/subscriptions", null, { creatorId: "creator1", currency: "USD" })).status, 401);
+  assert.equal((await t.api("POST", "/subscriptions", "fan", { creatorId: "nope", currency: "USD" })).status, 404);
+  assert.equal((await t.api("POST", "/subscriptions", "fan", {})).status, 400);
+  const own = await t.api("POST", "/subscriptions", "owner", { creatorId: "creator1", currency: "USD" });
+  assert.equal(own.status, 400);
+  assert.equal(own.json.code, "OWN_CREATOR");
+  assert.equal(t.calls.length, 0, "Razorpay must not be called for rejected requests");
+});
+
+withBilling("repeated clicks reuse the open checkout; a price change gets a new plan", async (t) => {
+  const a = await t.api("POST", "/subscriptions", "fan", { creatorId: "creator1", currency: "USD" });
+  const b = await t.api("POST", "/subscriptions", "fan", { creatorId: "creator1", currency: "USD" });
+  assert.equal(a.json.subscriptionId, b.json.subscriptionId);
+  assert.equal(t.calls.filter((c) => c.op === "createSubscription").length, 1);
+  assert.equal(t.calls.filter((c) => c.op === "createPlan").length, 1);
+
