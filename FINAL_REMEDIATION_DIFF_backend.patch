+/**
+ * Whole-application smoke test.
+ *
+ * Boots the real Express app (every middleware and every router, exactly as
+ * production wires them) on a temporary port and probes it over HTTP. It
+ * proves the server starts without optional settings, and checks the
+ * cross-cutting behaviour that unit tests cannot: middleware order, headers,
+ * CORS, JSON errors, and that sensitive routes refuse anonymous callers.
+ *
+ * No database is reachable and no Clerk session exists, so only behaviour
+ * that must hold for an anonymous caller is asserted.
+ *
+ * Run: npm test
+ */
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import type { Server } from "node:http";
+import type { AddressInfo } from "node:net";
+
+// Nothing ever connects to this database URL.
+process.env.DATABASE_URL ??= "postgresql://unused:unused@127.0.0.1:1/unused";
+// A syntactically valid development publishable key and a placeholder secret:
+// enough for the Clerk middleware to initialise. No request here is signed in.
+process.env.CLERK_PUBLISHABLE_KEY ??= "pk_test_cmVsZXZhbnQtYmFib29uLTkwLmNsZXJrLmFjY291bnRzLmRldiQ";
+process.env.CLERK_SECRET_KEY ??= "sk_test_placeholder_for_smoke_test_only";
+process.env.FRONTEND_URL = "https://app.example.test";
+process.env.NODE_ENV = "production";
+for (const k of [
+  "RAZORPAY_KEY_ID", "RAZORPAY_KEY_SECRET", "RAZORPAY_WEBHOOK_SECRET", "BILLING_CURRENCIES", "BILLING_FX_RATES",
+  "RECONCILE_SECRET", "OPENAI_API_KEY", "AI_INTEGRATIONS_OPENAI_API_KEY", "AI_INTEGRATIONS_OPENAI_BASE_URL", "ADMIN_EMAILS", "ADMIN_EMAIL",
+]) delete process.env[k];
+
+let server: Server;
+let base: string;
+
+before(async () => {
+  const { default: app } = await import("./app");
+  server = await new Promise<Server>((resolve) => {
+    const s = app.listen(0, "127.0.0.1", () => resolve(s));
+  });
+  base = `http://127.0.0.1:${(server.address() as AddressInfo).port}/api`;
+});
+
+after(async () => {
+  await new Promise((resolve) => server.close(resolve));
+});
+
+const send = (path: string, init: RequestInit = {}) => fetch(base + path, init);
+const json = { "Content-Type": "application/json" };
+
+test("the server starts with no AI, payment or admin settings and reports healthy", async () => {
+  const r = await send("/healthz");
+  assert.equal(r.status, 200);
+  assert.deepEqual(await r.json(), { status: "ok" });
+});
+
+test("every response carries the security headers and hides the framework", async () => {
+  const r = await send("/healthz");
+  assert.equal(r.headers.get("x-content-type-options"), "nosniff");
+  assert.equal(r.headers.get("x-frame-options"), "DENY");
+  assert.equal(r.headers.get("referrer-policy"), "no-referrer");
+  assert.match(r.headers.get("content-security-policy") ?? "", /default-src 'none'/);
+  assert.match(r.headers.get("strict-transport-security") ?? "", /max-age=\d+/);
+  assert.equal(r.headers.get("cache-control"), "no-store");
+  assert.equal(r.headers.get("x-powered-by"), null);
+});
+
+test("CORS allows the configured frontend with credentials and no other origin", async () => {
+  const ok = await send("/healthz", { headers: { Origin: "https://app.example.test" } });
+  assert.equal(ok.headers.get("access-control-allow-origin"), "https://app.example.test");
+  assert.equal(ok.headers.get("access-control-allow-credentials"), "true");
+
+  for (const origin of ["https://evil.test", "https://app.example.test.evil.test", "http://localhost:5173", "null"]) {
+    const r = await send("/healthz", { headers: { Origin: origin } });
+    assert.equal(r.headers.get("access-control-allow-origin"), null, origin);
+  }
+});
+
+test("with payments unconfigured nothing can be bought, granted or faked", async () => {
+  assert.deepEqual(await (await send("/payments/config")).json(), { enabled: false });
+
+  // The webhook path receives the raw body and refuses before reading it.
+  const hook = await send("/payments/webhook", {
+    method: "POST", headers: { ...json, "X-Razorpay-Signature": "00" },
+    body: JSON.stringify({ event: "subscription.charged", payload: {} }),
+  });
+  assert.equal(hook.status, 503);
+  assert.equal(((await hook.json()) as any).code, "PAYMENTS_UNAVAILABLE");
+
+  for (const path of ["/payments/direct-pay", "/payments/checkout", "/payments/portal"]) {
+    assert.equal((await send(path, { method: "POST", headers: json, body: "{}" })).status, 410, path);
+  }
+  for (const path of ["/tips", "/payments/methods", "/payments/payout-account", "/verifications/checkout", "/verifications/request"]) {
+    assert.equal((await send(path, { method: "POST", headers: json, body: "{}" })).status, 503, path);
+  }
+});
+
+test("anonymous callers are refused on every protected route", async () => {
+  const protectedRoutes: Array<[string, string]> = [
+    ["GET", "/users/me"], ["GET", "/users/bookmarks"], ["GET", "/users/liked-posts"],
+    ["GET", "/content/feed"], ["POST", "/content/posts"],
+    ["GET", "/subscriptions"], ["GET", "/subscriptions/any-creator"],
+    ["POST", "/payments/subscriptions"], ["POST", "/payments/razorpay/verify"], ["POST", "/payments/subscriptions/any/cancel"],
+    ["GET", "/payments/history"], ["GET", "/payments/payout-account"],
+    ["GET", "/creators/me"], ["GET", "/creators/me/dashboard"],
+    ["GET", "/messages/conversations"], ["POST", "/messages"],
+    ["GET", "/tips/creator/any"], ["GET", "/reports"], ["PATCH", "/reports/any"],
+    ["GET", "/admin/stats"], ["GET", "/admin/users"], ["DELETE", "/admin/users/any"],
+    ["GET", "/moderation/queue"], ["POST", "/moderation/scan/any"],
+    ["POST", "/ai-agent/scan"], ["GET", "/verifications/admin/all"], ["PATCH", "/verifications/admin/any"],
+    ["GET", "/tickets/admin/all"], ["POST", "/storage/cloudinary/sign"],
+  ];
+  for (const [method, path] of protectedRoutes) {
+    const r = await send(path, { method, headers: json, ...(method === "GET" ? {} : { body: "{}" }) });
+    assert.equal(r.status, 401, `${method} ${path} returned ${r.status}`);
+  }
+});
+
+test("the scheduler endpoint does not exist until a secret is configured", async () => {
+  const r = await send("/internal/reconcile", { method: "POST", headers: { Authorization: "Bearer anything" } });
+  assert.equal(r.status, 404);
+});
+
+test("old self-authorizing media links are gone, and so is the open upload endpoint", async () => {
+  // The previous scheme served /api/media/<token>. That shape no longer routes.
+  for (const token of ["abc.def", "eyJrIjoicG9zdCJ9.c2ln"]) {
+    assert.equal((await send(`/media/${token}`)).status, 404, token);
+  }
+  assert.equal((await send("/media/unknown-kind/123")).status, 404);
+  const legacy = await send("/storage/uploads/request-url", {
+    method: "POST", headers: json, body: JSON.stringify({ name: "a", size: 1, contentType: "image/png" }),
+  });
+  assert.equal(legacy.status, 404);
+});
+
+test("errors are JSON with no internals: unknown routes, malformed and oversized bodies", async () => {
+  const missing = await send("/no-such-route");
+  assert.equal(missing.status, 404);
+  assert.deepEqual(await missing.json(), { error: "Not found" });
+
+  const malformed = await send("/payments/direct-pay", { method: "POST", headers: json, body: "{not json" });
+  assert.equal(malformed.status, 400);
+  const body = JSON.stringify(await malformed.json());
+  assert.ok(!/SyntaxError|at JSON|node_modules|\.ts:|\.mjs:/.test(body), "no parser detail or stack trace");
+
+  const huge = await send("/payments/direct-pay", { method: "POST", headers: json, body: JSON.stringify({ x: "a".repeat(1_100_000) }) });
+  assert.equal(huge.status, 413);
+  assert.deepEqual(await huge.json(), { error: "Request is too large." });
+});
