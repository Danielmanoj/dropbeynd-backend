+-- 0002_drop_stripe_columns.DESTRUCTIVE.sql
+--
+-- !! DESTRUCTIVE AND IRREVERSIBLE. NOT RUN BY ANYTHING. DO NOT RUN WITHOUT APPROVAL. !!
+--
+-- Removes the Stripe-specific columns from the database. The application no
+-- longer reads or writes any of them, so running this changes no behaviour;
+-- it only discards the values they hold.
+--
+-- Before running:
+--   1. Complete the Stripe checks in docs/PHASE_1A_2_INVESTIGATION.md. Any
+--      Stripe ids stored here are the only link between database rows and
+--      Stripe objects. Once dropped, that link is gone.
+--   2. Confirm migration 0001 is applied and the Razorpay application code is
+--      deployed and working.
+--   3. Take a database backup or Neon branch and note when it expires.
+--
+-- Inspect what would be lost first:
+--   SELECT count(*) FILTER (WHERE stripe_subscription_id IS NOT NULL) FROM subscriptions;
+--   SELECT count(*) FILTER (WHERE stripe_payment_intent_id IS NOT NULL) FROM payments;
+--   SELECT count(*) FILTER (WHERE stripe_payment_intent_id IS NOT NULL) FROM tips;
+--   SELECT count(*) FILTER (WHERE stripe_payment_intent_id IS NOT NULL) FROM verification_requests;
+--   SELECT count(*) FILTER (WHERE stripe_product_id IS NOT NULL OR stripe_price_id IS NOT NULL) FROM creators;
+
+BEGIN;
+
+ALTER TABLE subscriptions         DROP COLUMN IF EXISTS stripe_subscription_id;
+ALTER TABLE payments              DROP COLUMN IF EXISTS stripe_payment_intent_id;
+ALTER TABLE tips                  DROP COLUMN IF EXISTS stripe_payment_intent_id;
+ALTER TABLE verification_requests DROP COLUMN IF EXISTS stripe_payment_intent_id;
+ALTER TABLE creators              DROP COLUMN IF EXISTS stripe_product_id;
+ALTER TABLE creators              DROP COLUMN IF EXISTS stripe_price_id;
+
+-- Review, then COMMIT; or ROLLBACK;
