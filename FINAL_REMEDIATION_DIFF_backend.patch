+/**
+ * Billing configuration, read from the environment.
+ *
+ * Billing is OFF unless everything it needs is present. There is no demo mode
+ * and no fallback: a missing or inconsistent setting disables payments and the
+ * API answers 503, it never grants access.
+ *
+ *   RAZORPAY_KEY_ID          rzp_test_… or rzp_live_…
+ *   RAZORPAY_KEY_SECRET      API secret for that key
+ *   RAZORPAY_WEBHOOK_SECRET  secret set on the webhook in the Razorpay dashboard
+ *   BILLING_CURRENCIES       comma-separated currencies subscribers may pay in,
+ *                            from INR, USD, GBP, EUR. Deliberately no default.
+ *   BILLING_FX_RATES         JSON: units of each currency per one US dollar,
+ *                            e.g. {"USD":1,"INR":98,"GBP":0.8,"EUR":0.9}.
+ *                            A fixed table you choose. Deliberately no default.
+ *   BILLING_DEFAULT_CURRENCY optional; offered when the region is unknown or
+ *                            has no currency of its own (default USD if offered)
+ *   BILLING_CURRENCY_SELECTION  "free" (default): a subscriber may pay in any
+ *                            offered currency. "region": only the currency of
+ *                            their detected region (or the default).
+ *   RAZORPAY_LIVE_ENABLED    must be exactly "true" to accept an rzp_live_ key
+ *   RAZORPAY_SUBSCRIPTION_CYCLES  optional, monthly cycles per subscription (default 120)
+ */
+import {
+  SUPPORTED_CURRENCIES,
+  isSupportedCurrency,
+  parseFxRates,
+  type Currency,
+  type FxRates,
+} from "./currency";
+
+export type BillingMode = "test" | "live";
+
+export interface BillingConfig {
+  enabled: true;
+  mode: BillingMode;
+  keyId: string;
+  keySecret: string;
+  webhookSecret: string;
+  /** Currencies a subscriber may be charged in. */
+  currencies: Currency[];
+  /** Fixed conversion table, units per one US dollar. */
+  rates: FxRates;
+  defaultCurrency: Currency;
+  /** Whether subscribers may choose a currency other than their region's. */
+  currencySelection: "free" | "region";
+  totalCycles: number;
+}
+
+export interface BillingDisabled {
+  enabled: false;
+  reason: string;
+}
+
+export function readBillingConfig(
+  env: Record<string, string | undefined> = process.env,
+): BillingConfig | BillingDisabled {
+  const keyId = env.RAZORPAY_KEY_ID?.trim() ?? "";
+  const keySecret = env.RAZORPAY_KEY_SECRET?.trim() ?? "";
+  const webhookSecret = env.RAZORPAY_WEBHOOK_SECRET?.trim() ?? "";
+  const currencyList = env.BILLING_CURRENCIES?.trim() ?? "";
+
+  const missing = [
+    !keyId && "RAZORPAY_KEY_ID",
+    !keySecret && "RAZORPAY_KEY_SECRET",
+    !webhookSecret && "RAZORPAY_WEBHOOK_SECRET",
+    !currencyList && "BILLING_CURRENCIES",
+    !env.BILLING_FX_RATES?.trim() && "BILLING_FX_RATES",
+  ].filter(Boolean);
+  if (missing.length > 0) {
+    return { enabled: false, reason: `Missing configuration: ${missing.join(", ")}` };
+  }
+
+  const currencies: Currency[] = [];
+  for (const raw of currencyList.split(",")) {
+    const code = raw.trim().toUpperCase();
+    if (!code) continue;
+    if (!isSupportedCurrency(code)) {
+      return {
+        enabled: false,
+        reason: `BILLING_CURRENCIES contains "${code}"; supported currencies are ${SUPPORTED_CURRENCIES.join(", ")}`,
+      };
+    }
+    if (!currencies.includes(code)) currencies.push(code);
+  }
+  if (currencies.length === 0) {
+    return { enabled: false, reason: "BILLING_CURRENCIES lists no currency" };
+  }
+
+  const rates = parseFxRates(env.BILLING_FX_RATES, currencies);
+  if (typeof rates === "string") return { enabled: false, reason: rates };
+
+  let defaultCurrency: Currency = currencies.includes("USD") ? "USD" : currencies[0];
+  const requestedDefault = env.BILLING_DEFAULT_CURRENCY?.trim().toUpperCase();
+  if (requestedDefault) {
+    if (!isSupportedCurrency(requestedDefault) || !currencies.includes(requestedDefault)) {
+      return { enabled: false, reason: "BILLING_DEFAULT_CURRENCY must be one of BILLING_CURRENCIES" };
+    }
+    defaultCurrency = requestedDefault;
+  }
+
+  const selectionRaw = env.BILLING_CURRENCY_SELECTION?.trim().toLowerCase() || "free";
+  if (selectionRaw !== "free" && selectionRaw !== "region") {
+    return { enabled: false, reason: "BILLING_CURRENCY_SELECTION must be \"free\" or \"region\"" };
+  }
+  const currencySelection: "free" | "region" = selectionRaw;
+
+  let mode: BillingMode;
+  if (keyId.startsWith("rzp_test_")) {
+    mode = "test";
+  } else if (keyId.startsWith("rzp_live_")) {
+    if (env.RAZORPAY_LIVE_ENABLED !== "true") {
+      return {
+        enabled: false,
+        reason: "A live Razorpay key is configured but RAZORPAY_LIVE_ENABLED is not \"true\"",
+      };
+    }
+    mode = "live";
+  } else {
+    return { enabled: false, reason: "RAZORPAY_KEY_ID must start with rzp_test_ or rzp_live_" };
+  }
+
+  const cycles = Number(env.RAZORPAY_SUBSCRIPTION_CYCLES ?? "120");
+  if (!Number.isInteger(cycles) || cycles < 1 || cycles > 1200) {
+    return { enabled: false, reason: "RAZORPAY_SUBSCRIPTION_CYCLES must be a whole number from 1 to 1200" };
+  }
+
+  return { enabled: true, mode, keyId, keySecret, webhookSecret, currencies, rates, defaultCurrency, currencySelection, totalCycles: cycles };
+}
+
+/** The conversion table alone, for reporting, even when checkout is otherwise off. */
+export function readFxRates(env: Record<string, string | undefined> = process.env): FxRates | null {
+  const rates = parseFxRates(env.BILLING_FX_RATES, []);
+  return typeof rates === "string" ? null : rates;
+}
