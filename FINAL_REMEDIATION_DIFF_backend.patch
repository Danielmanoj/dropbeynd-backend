+/**
+ * Regional currency.
+ *
+ * A creator sets ONE price in their own currency. A subscriber is charged in
+ * the currency of their region, at an amount converted with a FIXED rate table
+ * that the operator sets in configuration (BILLING_FX_RATES). Rates are not
+ * fetched from anywhere and do not move by themselves: the same creator price
+ * always yields the same amount in each currency until the operator changes
+ * the table.
+ *
+ * Region decides only the DEFAULT currency. The subscriber may switch to any
+ * supported currency before paying. The amount for whichever currency they
+ * choose is always computed here, on the server.
+ */
+
+export const SUPPORTED_CURRENCIES = ["INR", "USD", "GBP", "EUR"] as const;
+export type Currency = (typeof SUPPORTED_CURRENCIES)[number];
+
+export function isSupportedCurrency(value: unknown): value is Currency {
+  return typeof value === "string" && (SUPPORTED_CURRENCIES as readonly string[]).includes(value);
+}
+
+/** Units of each currency that equal one US dollar, e.g. { USD: 1, INR: 98, ... }. */
+export type FxRates = Record<Currency, number>;
+
+// Countries whose currency is the euro: the eurozone members, plus the states
+// and territories that use the euro by agreement or unilaterally.
+const EURO_COUNTRIES = new Set([
+  "AT", "BE", "BG", "HR", "CY", "EE", "FI", "FR", "DE", "GR", "IE", "IT", "LV",
+  "LT", "LU", "MT", "NL", "PT", "SK", "SI", "ES",
+  "AD", "MC", "SM", "VA", "ME", "XK",
+]);
+// United Kingdom and the Crown Dependencies, which use the pound.
+const POUND_COUNTRIES = new Set(["GB", "UK", "GG", "JE", "IM"]);
+
+/**
+ * ISO 3166 country code → the currency a subscriber there is offered first.
+ * India → INR, United States → USD, United Kingdom → GBP, euro countries → EUR.
+ * Everywhere else, and unknown, → null (the caller applies the default).
+ */
+export function currencyForCountry(country: string | null | undefined): Currency | null {
+  const code = country?.trim().toUpperCase();
+  if (!code) return null;
+  if (code === "IN") return "INR";
+  if (code === "US") return "USD";
+  if (POUND_COUNTRIES.has(code)) return "GBP";
+  if (EURO_COUNTRIES.has(code)) return "EUR";
+  return null;
+}
+
+/**
+ * Best-effort country of the request, from headers set by the hosting edge
+ * (Vercel, Cloudflare, and a generic fallback). These can be absent, or wrong
+ * for VPN users and travellers, which is why this only picks a default.
+ */
+export function detectCountry(headers: Record<string, string | string[] | undefined>): string | null {
+  for (const name of ["x-vercel-ip-country", "cf-ipcountry", "x-country-code"]) {
+    const raw = headers[name];
+    const value = (Array.isArray(raw) ? raw[0] : raw)?.trim().toUpperCase();
+    // "XX" and "T1" are Cloudflare's codes for unknown and Tor.
+    if (value && /^[A-Z]{2}$/.test(value) && value !== "XX" && value !== "T1") return value;
+  }
+  return null;
+}
+
+/** Parses BILLING_FX_RATES. Returns an error string instead of throwing. */
+export function parseFxRates(json: string | undefined, currencies: readonly Currency[]): FxRates | string {
+  if (!json?.trim()) return "BILLING_FX_RATES is not set";
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(json);
+  } catch {
+    return "BILLING_FX_RATES is not valid JSON";
+  }
+  if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
+    return "BILLING_FX_RATES must be a JSON object of currency → units per 1 USD";
+  }
+  const table = parsed as Record<string, unknown>;
+  if (table.USD !== 1) return "BILLING_FX_RATES must contain \"USD\": 1 (rates are units per one US dollar)";
+  const rates = {} as FxRates;
+  // Every supported currency needs a rate, because a creator may price in any
+  // of them even if subscribers are only charged in some.
+  for (const c of SUPPORTED_CURRENCIES) {
+    const r = table[c];
+    if (typeof r !== "number" || !Number.isFinite(r) || r <= 0) {
+      return `BILLING_FX_RATES is missing a positive rate for ${c}`;
+    }
+    rates[c] = r;
+  }
+  for (const c of currencies) {
+    if (!(c in rates)) return `BILLING_FX_RATES is missing a rate for ${c}`;
+  }
+  return rates;
+}
+
+/**
+ * Converts an amount in minor units (cents, pence, paise) between currencies
+ * using the fixed table. Same currency returns the amount unchanged.
+ *
+ * Rounding: to the nearest minor unit, except rupees, which are rounded to the
+ * whole rupee because fractional-rupee prices read as errors to customers.
+ */
+export function convertMinor(amountMinor: number, from: Currency, to: Currency, rates: FxRates): number {
+  if (from === to) return amountMinor;
+  const converted = (amountMinor * rates[to]) / rates[from];
+  if (to === "INR") return Math.round(converted / 100) * 100;
+  return Math.round(converted);
+}
+
+/**
+ * Adds up per-currency totals (major units, as decimal strings from SQL) in
+ * one target currency, using the fixed table. Without a table, only amounts
+ * already in the target currency can be counted.
+ */
+export function sumInCurrency(
+  rows: Array<{ currency: string | null; total: string | number | null }>,
+  target: Currency,
+  rates: FxRates | null,
+): number {
+  let minor = 0;
+  for (const row of rows) {
+    const from = String(row.currency ?? "").toUpperCase();
+    const amountMinor = Math.round(Number(row.total ?? 0) * 100);
+    if (!Number.isFinite(amountMinor) || !isSupportedCurrency(from)) continue;
+    if (from === target) minor += amountMinor;
+    else if (rates) minor += convertMinor(amountMinor, from, target, rates);
+  }
+  return minor / 100;
+}
+
+export function normalizeCurrency(value: unknown, fallback: Currency = "USD"): Currency {
+  const code = typeof value === "string" ? value.trim().toUpperCase() : "";
+  return isSupportedCurrency(code) ? code : fallback;
+}
