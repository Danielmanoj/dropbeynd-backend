+/**
+ * READ-ONLY report: who is affected by provider-verified entitlement.
+ *
+ * Counts subscriptions that predate Razorpay billing. These grant no access
+ * unless a dated legacy grace is configured (LEGACY_SUBSCRIPTION_GRACE_UNTIL).
+ * Use the numbers to decide whether to approve a grace period and for how long.
+ *
+ * This script only runs SELECT statements, inside a READ ONLY transaction, so
+ * the database rejects any write. It prints counts, never names or emails.
+ *
+ * Usage (point DATABASE_URL at a Neon branch or staging copy where possible):
+ *   npx tsx src/scripts/legacy-subscribers-report.ts
+ */
+import pg from "pg";
+
+async function main() {
+  if (!process.env.DATABASE_URL) throw new Error("DATABASE_URL is not set");
+  const client = new pg.Client({ connectionString: process.env.DATABASE_URL });
+  await client.connect();
+  try {
+    await client.query("BEGIN TRANSACTION READ ONLY");
+    await client.query("SET LOCAL statement_timeout = '20s'");
+
+    const byKind = await client.query(`
+      SELECT (provider IS NULL)  AS legacy,
+             status::text        AS status,
+             count(*)::int       AS subscriptions,
+             count(DISTINCT user_id)::int    AS users,
+             count(DISTINCT creator_id)::int AS creators
+      FROM subscriptions
+      GROUP BY 1, 2
+      ORDER BY 1 DESC, 2`);
+
+    const affected = await client.query(`
+      SELECT count(*)::int                  AS subscriptions,
+             count(DISTINCT user_id)::int    AS users,
+             count(DISTINCT creator_id)::int AS creators,
+             min(created_at)                 AS oldest,
+             max(current_period_end)         AS latest_period_end
+      FROM subscriptions
+      WHERE provider IS NULL AND status = 'active'`);
+
+    console.log("Subscriptions by origin and status (legacy = created before Razorpay billing):");
+    console.table(byKind.rows);
+    console.log("Legacy subscriptions still marked active. These users have NO access to paid");
+    console.log("content unless a legacy grace period is approved and configured:");
+    console.table(affected.rows);
+  } finally {
+    await client.query("ROLLBACK").catch(() => {});
+    await client.end();
+  }
+}
+
+main().catch((err) => {
+  console.error(err instanceof Error ? err.message : err);
+  process.exit(1);
+});
