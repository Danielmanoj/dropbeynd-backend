+/**
+ * Payment evidence and response-shaping helpers.
+ *
+ * The `status` column on `payments` cannot be trusted by itself: paths that
+ * have since been removed wrote "succeeded" for charges that never happened.
+ * Money is counted and displayed only when a row carries the evidence that the
+ * signature-verified Razorpay webhook handler writes (lib/billing/service.ts).
+ *
+ * This module imports the schema only, never the database connection, so it
+ * can be unit-tested without a database.
+ */
+import { and, eq, isNotNull, sql, type SQL } from "drizzle-orm";
+import { paymentsTable } from "../db/schema/payments";
+
+export const PAYMENTS_UNAVAILABLE_CODE = "PAYMENTS_UNAVAILABLE";
+
+/**
+ * A payment counts as revenue only if it succeeded AND was recorded by the
+ * verified webhook handler: provider, provider payment id and verification
+ * time are all set. A fully refunded payment has status "refunded" and is
+ * excluded.
+ */
+export function providerConfirmedPayment(): SQL {
+  return and(
+    eq(paymentsTable.status, "succeeded"),
+    eq(paymentsTable.provider, "razorpay"),
+    isNotNull(paymentsTable.providerPaymentId),
+    isNotNull(paymentsTable.providerVerifiedAt),
+  )!;
+}
+
+/** Amount actually kept: the charge less anything partially refunded. */
+export function netPaymentAmount(): SQL<string> {
+  return sql<string>`(${paymentsTable.amount} - ${paymentsTable.refundedAmount})`;
+}
+
+/**
+ * No tip payment flow exists, so no tip is provider-confirmed. Historical tip
+ * rows stay stored and are never counted or listed as income.
+ */
+export function providerConfirmedTip(): SQL {
+  return sql`false`;
+}
+
+// ─── Tip privacy ──────────────────────────────────────────────────────────────
+
+/** Only the creator who received the tips, or an admin, may list them. */
+export function canViewCreatorTips(
+  viewer: { id: string; role: string } | null | undefined,
+  creator: { userId: string } | null | undefined,
+): boolean {
+  if (!viewer || !creator) return false;
+  return viewer.role === "admin" || creator.userId === viewer.id;
+}
+
+export interface TipView {
