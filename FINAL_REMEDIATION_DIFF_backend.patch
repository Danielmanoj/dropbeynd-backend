+/**
+ * One-time migration of EXISTING media to protected delivery. NOT RUN BY ANYTHING.
+ *
+ * New uploads are already stored as Cloudinary "authenticated" assets. Media
+ * uploaded earlier is still a public asset: the API no longer hands its URL to
+ * anyone, but a copy of the old URL saved before this change keeps working
+ * until the asset itself is converted. This script converts it.
+ *
+ * For each post and lesson whose media is a PUBLIC asset in this Cloudinary
+ * account it (1) changes the asset's type to "authenticated" at Cloudinary,
+ * which invalidates the old public URL, and (2) stores the new URL.
+ *
+ * It changes data at Cloudinary and in the database, so:
+ *   - by default it is a DRY RUN that only lists what it would do;
+ *   - pass --apply to perform it, after taking a database backup;
+ *   - run it against staging first.
+ *
+ * Usage:
+ *   npx tsx src/scripts/protect-existing-media.ts            (dry run)
+ *   npx tsx src/scripts/protect-existing-media.ts --apply
+ */
+import { v2 as cloudinary } from "cloudinary";
+import { eq, isNotNull } from "drizzle-orm";
+
+const APPLY = process.argv.includes("--apply");
+const PUBLIC_ASSET = /^https:\/\/res\.cloudinary\.com\/([^/]+)\/(image|video|raw)\/upload\/(?:v\d+\/)?([^?#]+)$/;
+
+async function main() {
+  const { CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET } = process.env;
+  if (!CLOUDINARY_CLOUD_NAME || !CLOUDINARY_API_KEY || !CLOUDINARY_API_SECRET) {
+    throw new Error("Cloudinary is not configured");
+  }
+  cloudinary.config({ cloud_name: CLOUDINARY_CLOUD_NAME, api_key: CLOUDINARY_API_KEY, api_secret: CLOUDINARY_API_SECRET, secure: true });
+
+  const { db, postsTable, lessonsTable } = await import("../db");
+
+  const posts = await db.select({ id: postsTable.id, url: postsTable.mediaUrl }).from(postsTable).where(isNotNull(postsTable.mediaUrl));
+  const lessons = await db.select({ id: lessonsTable.id, url: lessonsTable.contentUrl }).from(lessonsTable).where(isNotNull(lessonsTable.contentUrl));
+
+  const work = [
+    ...posts.map((p) => ({ kind: "post" as const, id: p.id, url: p.url! })),
+    ...lessons.map((l) => ({ kind: "lesson" as const, id: l.id, url: l.url! })),
+  ];
+
+  let converted = 0, skipped = 0, failed = 0;
+  for (const item of work) {
+    const m = PUBLIC_ASSET.exec(item.url);
+    if (!m || m[1] !== CLOUDINARY_CLOUD_NAME) { skipped++; continue; }
+    const resourceType = m[2] as "image" | "video" | "raw";
+    // Raw assets keep their extension in the public id; images and videos do not.
+    const publicId = resourceType === "raw" ? decodeURIComponent(m[3]) : decodeURIComponent(m[3]).replace(/\.[^./]+$/, "");
+
+    if (!APPLY) {
+      console.log(`[dry run] would protect ${item.kind} ${item.id}: ${resourceType}/${publicId}`);
+      converted++;
+      continue;
+    }
+    try {
+      const result = await cloudinary.uploader.rename(publicId, publicId, {
+        resource_type: resourceType,
+        type: "upload",
+        to_type: "authenticated",
+        invalidate: true,
+      });
+      const newUrl: string = result.secure_url;
+      if (item.kind === "post") await db.update(postsTable).set({ mediaUrl: newUrl }).where(eq(postsTable.id, item.id));
+      else await db.update(lessonsTable).set({ contentUrl: newUrl }).where(eq(lessonsTable.id, item.id));
+      converted++;
+      console.log(`protected ${item.kind} ${item.id}`);
+    } catch (err) {
+      failed++;
+      console.error(`FAILED ${item.kind} ${item.id}: ${err instanceof Error ? err.message : err}`);
+    }
+  }
+
+  console.log(`${APPLY ? "Converted" : "Would convert"}: ${converted}. Skipped (not a public asset of this account): ${skipped}. Failed: ${failed}.`);
+  process.exit(failed > 0 ? 1 : 0);
+}
+
+main().catch((err) => {
+  console.error(err instanceof Error ? err.message : err);
+  process.exit(1);
+});
