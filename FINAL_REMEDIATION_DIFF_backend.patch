+      .razorpay(config)
+      .cancelSubscription(target.providerSubscriptionId, atPeriodEnd)
+      .catch(wrapProviderError);
+
+    // Records the request only. Status and period are left for the webhook.
+    await db
+      .update(subscriptionsTable)
+      .set({ cancelRequestedAt: now(), updatedAt: now() })
+      .where(eq(subscriptionsTable.id, target.id));
+
+    return {
+      cancelRequested: true,
+      atPeriodEnd,
+      accessUntil: atPeriodEnd ? target.currentPeriodEnd : null,
+    };
+  }
+
+  // ─── Webhook ────────────────────────────────────────────────────────────────
+
+  async function recountSubscribers(tx: BillingDb, creatorId: string) {
+    const [row] = await tx
+      .select({ n: sql<number>`count(DISTINCT ${subscriptionsTable.userId})::int` })
+      .from(subscriptionsTable)
+      .where(and(eq(subscriptionsTable.creatorId, creatorId), entitledSubscriptionWhere(now())));
+    await tx.update(creatorsTable).set({ subscriberCount: row?.n ?? 0 }).where(eq(creatorsTable.id, creatorId));
+  }
+
+  /**
+   * The column changes that bring a local row in line with the provider's
+   * state as of `asOf`. Deliveries can arrive out of order, so older state
+   * never overwrites newer, and a finished subscription is never revived.
+   */
+  function statePatch(
+    row: typeof subscriptionsTable.$inferSelect,
+    entity: { status: string; current_start?: number | null; current_end?: number | null; ended_at?: number | null },
+    asOf: Date,
+  ) {
+    const olderThanApplied = row.providerEventAt != null && asOf.getTime() < row.providerEventAt.getTime();
+    const wouldRevive =
+      TERMINAL_PROVIDER_STATUSES.has(row.providerStatus ?? "") && !TERMINAL_PROVIDER_STATUSES.has(entity.status);
+    const stale = olderThanApplied || wouldRevive;
+
+    const patch: Partial<typeof subscriptionsTable.$inferInsert> = { updatedAt: now() };
+    if (!stale) {
+      patch.providerStatus = entity.status;
+      patch.status = mapProviderStatus(entity.status);
+      patch.providerEventAt = asOf;
+      const start = unixToDate(entity.current_start);
+      const end = unixToDate(entity.current_end);
+      if (start) patch.currentPeriodStart = start;
+      if (end) patch.currentPeriodEnd = end;
+      const ended = unixToDate(entity.ended_at);
+      if (ended) patch.endedAt = ended;
+    }
+    return { patch, stale };
+  }
+
+  async function applySubscriptionEvent(tx: BillingDb, eventType: string, body: any, eventAt: Date) {
+    const entity = body?.payload?.subscription?.entity;
+    if (typeof entity?.id !== "string" || typeof entity?.status !== "string") {
+      return { outcome: "ignored_malformed" as WebhookOutcome, subjectId: null };
+    }
+
+    const [row] = await tx
+      .select()
+      .from(subscriptionsTable)
+      .where(and(
+        eq(subscriptionsTable.provider, BILLING_PROVIDER),
+        eq(subscriptionsTable.providerSubscriptionId, entity.id),
+      ))
+      .for("update");
+    // Only subscriptions this server created are known. An event for any other
+    // id cannot create a row, so it cannot grant anyone access.
+    if (!row) return { outcome: "ignored_unknown_subscription" as WebhookOutcome, subjectId: entity.id };
+
+    const { patch, stale } = statePatch(row, entity, eventAt);
+
+    // A captured charge is the only thing that marks a subscription as paid.
+    let recordedPayment = false;
+    if (eventType === "subscription.charged") {
+      const payment = body?.payload?.payment?.entity;
+      const captured = payment?.status === "captured" || payment?.captured === true;
+      if (typeof payment?.id === "string" && captured && Number.isInteger(payment?.amount) && payment.amount > 0) {
+        await tx
+          .insert(paymentsTable)
+          .values({
+            id: crypto.randomUUID(),
+            userId: row.userId,
+            creatorId: row.creatorId,
+            // The provider's figure, never the client's.
+            amount: minorToDecimal(payment.amount),
+            // Razorpay's currency for the charge; the subscription's own if absent.
+            currency: (String(payment.currency ?? "") || row.currency || "").toLowerCase().slice(0, 3) || "usd",
+            status: "succeeded",
+            provider: BILLING_PROVIDER,
+            providerPaymentId: payment.id,
+            providerVerifiedAt: now(),
+            subscriptionId: row.id,
+            createdAt: unixToDate(payment.created_at) ?? eventAt,
+          })
+          .onConflictDoNothing();
+        patch.providerVerifiedAt = row.providerVerifiedAt ?? now();
+        patch.accessRevokedAt = null;
+        recordedPayment = true;
+      }
+    }
