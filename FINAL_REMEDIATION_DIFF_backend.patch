+// ─── Protected media follows real entitlement ─────────────────────────────────
+
+/** The real media router, with the REAL entitlement check against this test's database. */
+async function mediaFor(t: Ctx) {
+  const { createMediaRouter } = await import("../../routes/media");
+  let served = 0;
+  const app = express();
+  app.use("/api/media", createMediaRouter({
+    identify: (req, _res, next) => {
+      const id = req.headers["x-test-user"];
+      if (typeof id === "string") (req as any).dbUser = { id, role: id === "owner" ? "creator" : "user" };
+      next();
+    },
+    // One subscriber-only post belonging to creator1 (owned by user "owner").
+    load: async (kind, id) => kind === "post" && id === "locked1"
+      ? { kind, rawUrl: "https://res.cloudinary.com/demo/image/authenticated/v1/creatorhub/posts/x.jpg",
+          creatorId: "creator1", creatorUserId: "owner", locked: true, visibleToOthers: true, removed: false }
+      : null,
+    isEntitled: (userId, creatorId) => isEntitled(t.db as any, userId, creatorId, new Date(t.now())),
+    sign: (u) => u,
+    fetch: (async () => { served++; return new Response("bytes", { status: 200, headers: { "content-type": "image/jpeg" } }); }) as any,
+  }));
+  const server = await new Promise<import("node:http").Server>((r) => { const s = app.listen(0, "127.0.0.1", () => r(s)); });
+  const url = `http://127.0.0.1:${(server.address() as AddressInfo).port}/api/media/post/locked1`;
+  return {
+    status: async (user?: string) => (await fetch(url, { headers: user ? { "x-test-user": user } : {} })).status,
+    served: () => served,
+    close: () => new Promise((r) => server.close(r)),
+  };
+}
