+/**
+ * Security regression tests: protected media, upload signing, administrator
+ * bootstrap, creator ownership, moderation failure handling, CORS, and the
+ * internal reconciliation trigger.
+ *
+ * No database or external service is used. Cloudinary is never contacted: its
+ * signatures are recomputed here and compared.
+ *
+ * Run: npm test
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import crypto from "node:crypto";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import path from "node:path";
+import type { AddressInfo } from "node:net";
+import express from "express";
+
+process.env.DATABASE_URL ??= "postgresql://unused:unused@127.0.0.1:1/unused";
+
+import {
+  canViewMedia,
+  deliveryUrl,
+  isAcceptableMediaUrl,
+  isAcceptableThumbnailUrl,
+  isAuthenticatedCloudinaryUrl,
+  isCloudinaryDeliveryUrl,
+  type MediaSubject,
+} from "./mediaAccess";
+import { allowedOrigins, isOriginAllowed } from "./httpSecurity";
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const src = (rel: string) => readFileSync(path.join(here, "..", rel), "utf8");
+
+const PUBLIC_URL = "https://res.cloudinary.com/demo/image/upload/v1/creatorhub/posts/a.jpg";
+const PROTECTED_URL = "https://res.cloudinary.com/demo/video/authenticated/s--abcd1234--/v1/creatorhub/posts/b.mp4";
+
+// ─── Who may see a piece of media ─────────────────────────────────────────────
+
+const OWNER = { id: "owner-user", role: "creator" };
+const ADMIN = { id: "an-admin", role: "admin" };
+const FAN = { id: "fan-user", role: "user" };
+const subject = (over: Partial<MediaSubject> = {}): MediaSubject => ({
+  kind: "post", creatorId: "creator1", creatorUserId: "owner-user",
+  locked: true, visibleToOthers: true, removed: false, ...over,
+});
+
+test("media access is decided for the viewer: owner, admin, entitled subscriber, and nobody else", () => {
+  const locked = subject();
+  assert.deepEqual(canViewMedia(locked, FAN, true), { allow: true }, "entitled subscriber");
+  assert.deepEqual(canViewMedia(locked, OWNER, false), { allow: true }, "the creator's own media");
+  assert.deepEqual(canViewMedia(locked, ADMIN, false), { allow: true }, "an administrator");
+
+  assert.deepEqual(canViewMedia(locked, null, false), { allow: false, status: 401, reason: "sign_in_required" });
+  assert.deepEqual(canViewMedia(locked, FAN, false), { allow: false, status: 403, reason: "not_entitled" });
+  // Entitlement of some other account is irrelevant: the flag is per viewer.
+  assert.equal(canViewMedia(locked, { id: "stranger", role: "user" }, false).allow, false);
+  // Being a creator of a DIFFERENT profile grants nothing.
+  assert.equal(canViewMedia(locked, { id: "another-creator", role: "creator" }, false).allow, false);
+});
+
+test("public media is open to everyone; unapproved and removed media is not", () => {
+  const publicPost = subject({ locked: false });
+  assert.deepEqual(canViewMedia(publicPost, null, false), { allow: true }, "signed-out visitor, public post");
+  assert.deepEqual(canViewMedia(publicPost, FAN, false), { allow: true });
+
+  // Awaiting or under review: only the owner and admins, and others are not told it exists.
+  const pending = subject({ locked: false, visibleToOthers: false });
+  assert.deepEqual(canViewMedia(pending, null, false), { allow: false, status: 404, reason: "not_found" });
+  assert.deepEqual(canViewMedia(pending, FAN, true), { allow: false, status: 404, reason: "not_found" });
+  assert.equal(canViewMedia(pending, OWNER, false).allow, true);
+  assert.equal(canViewMedia(pending, ADMIN, false).allow, true);
+
+  // Taken down: nobody at all, including the owner, an admin, and a paying subscriber.
+  const removed = subject({ removed: true });
+  for (const viewer of [null, FAN, OWNER, ADMIN]) {
+    assert.deepEqual(canViewMedia(removed, viewer, true), { allow: false, status: 404, reason: "not_found" });
+  }
+  assert.deepEqual(canViewMedia(null, FAN, true), { allow: false, status: 404, reason: "not_found" });
+
+  // Course material is always subscriber-only, and hidden while the course is unpublished.
+  const lesson = subject({ kind: "lesson" });
+  assert.equal(canViewMedia(lesson, null, false).allow, false);
+  assert.equal(canViewMedia(lesson, FAN, true).allow, true);
+  assert.equal(canViewMedia(subject({ kind: "lesson", visibleToOthers: false }), FAN, true).allow, false);
+});
+
+// ─── What address the API hands out ───────────────────────────────────────────
+
+test("protected media is addressed through the API, with no secret in the address", () => {
+  const base = { kind: "post" as const, id: "p1", env: {} };
+
+  // No access: nothing at all, whatever the asset.
+  for (const rawUrl of [PUBLIC_URL, PROTECTED_URL]) {
+    assert.equal(deliveryUrl({ ...base, rawUrl, locked: true, canAccess: false }), null);
+  }
+  assert.equal(deliveryUrl({ ...base, rawUrl: null, locked: false, canAccess: true }), null);
+
+  // A public post with a public asset keeps its CDN URL: genuinely public content is untouched.
+  assert.equal(deliveryUrl({ ...base, rawUrl: PUBLIC_URL, locked: false, canAccess: true }), PUBLIC_URL);
+
+  // Locked posts, and any authenticated asset, are addressed through the API.
+  for (const [rawUrl, locked] of [[PUBLIC_URL, true], [PROTECTED_URL, true], [PROTECTED_URL, false]] as const) {
+    const url = deliveryUrl({ ...base, rawUrl, locked, canAccess: true })!;
+    assert.equal(url, "/api/media/post/p1");
+    assert.ok(!url.includes("cloudinary"), "the storage URL must not leak");
+  }
+  assert.equal(deliveryUrl({ kind: "lesson", id: "l 1", rawUrl: PROTECTED_URL, locked: true, canAccess: true, env: {} }), "/api/media/lesson/l%201");
+
+  // The address is the same for every viewer and every request: it identifies
+  // the item and contains no token, signature or expiry to copy.
+  const again = deliveryUrl({ ...base, rawUrl: PROTECTED_URL, locked: true, canAccess: true });
+  assert.equal(again, "/api/media/post/p1");
+  assert.ok(!/[?&](token|sig|signature|expires|exp)=/.test(again!));
+
+  assert.equal(
+    deliveryUrl({ ...base, rawUrl: PROTECTED_URL, locked: true, canAccess: true, env: { MEDIA_BASE_URL: "https://api.example.test/" } }),
+    "https://api.example.test/api/media/post/p1",
+  );
+});
+
+test("only this platform's uploads are accepted as media", () => {
+  assert.equal(isAcceptableMediaUrl(PUBLIC_URL, "demo"), true);
+  assert.equal(isAcceptableMediaUrl(PROTECTED_URL, "demo"), true);
+  for (const bad of [
+    "https://res.cloudinary.com/someone-else/image/upload/a.jpg",
+    "http://res.cloudinary.com/demo/image/upload/a.jpg",
+    "https://res.cloudinary.com.evil.test/demo/image/upload/a.jpg",
+    "https://user:pass@res.cloudinary.com/demo/image/upload/a.jpg",
+    "https://evil.test/a.jpg", "http://169.254.169.254/latest/meta-data", "http://localhost:5432/",
+    "file:///etc/passwd", "javascript:alert(1)", "concat:a|b", "", null, 5, "x".repeat(3000),
+  ]) {
+    assert.equal(isAcceptableMediaUrl(bad as any, "demo"), false, String(bad).slice(0, 60));
+  }
+  assert.equal(isAcceptableThumbnailUrl("data:image/jpeg;base64,AAAA", "demo"), true);
+  assert.equal(isAcceptableThumbnailUrl("data:text/html;base64,AAAA", "demo"), false);
+  assert.equal(isAcceptableThumbnailUrl("data:image/svg+xml;base64,AAAA", "demo"), false);
+  assert.equal(isAuthenticatedCloudinaryUrl(PROTECTED_URL), true);
+  assert.equal(isAuthenticatedCloudinaryUrl(PUBLIC_URL), false);
+  assert.equal(isCloudinaryDeliveryUrl(PUBLIC_URL), true);
+});
+
+// ─── The media route ──────────────────────────────────────────────────────────
+
+/**
+ * The real media router with a simulated database and Cloudinary. The viewer
+ * is taken from an "x-test-user" header, standing in for a verified Clerk
+ * session; "entitled" is a set of user ids the test controls.
+ */
+async function mediaServer(items: Record<string, any>, entitledUsers: Set<string>, limits?: import("./rateLimits").MediaLimits) {
+  const { createMediaRouter } = await import("../routes/media");
+  const fetched: Array<{ url: string; range?: string }> = [];
+  const roles: Record<string, string> = { "owner-user": "creator", "an-admin": "admin" };
+  const { createMediaLimiter } = await import("./rateLimits");
+  let loads = 0;
+  const app = express();
+  // Stands in for the CORS layer, which sets its own Vary value first.
+  app.use((_req, res, next) => { res.vary("Origin"); next(); });
+  app.use(
+    "/api/media",
+    createMediaRouter({
+      limiter: limits ? createMediaLimiter(limits) : undefined,
+      identify: (req, _res, next) => {
+        const id = req.headers["x-test-user"];
+        if (typeof id === "string") (req as any).dbUser = { id, role: roles[id] ?? "user" };
+        next();
+      },
+      load: async (kind, id) => { loads++; return items[`${kind}:${id}`] ?? null; },
+      isEntitled: async (userId) => entitledUsers.has(userId),
+      sign: (u) => u + "?signed-by-server",
+      fetch: (async (url: any, init: any) => {
+        fetched.push({ url: String(url), range: init?.headers?.Range });
+        if (String(url).includes("storage-down")) throw new Error(`request to ${url} failed`);
+        const partial = !!init?.headers?.Range;
+        return new Response("media-bytes", {
+          status: partial ? 206 : 200,
+          headers: { "content-type": "video/mp4", ...(partial ? { "content-range": "bytes 0-10/11" } : {}) },
+        });
+      }) as any,
+    }),
+  );
+  const server = await new Promise<import("node:http").Server>((r) => { const s = app.listen(0, "127.0.0.1", () => r(s)); });
+  const base = `http://127.0.0.1:${(server.address() as AddressInfo).port}/api/media/`;
+  const get = (path: string, user?: string, headers: Record<string, string> = {}) =>
+    fetch(base + path, { headers: { ...(user ? { "x-test-user": user } : {}), ...headers } });
+  return { get, fetched, loads: () => loads, close: () => new Promise((r) => server.close(r)) };
+}
+
+const lockedPost = { kind: "post", rawUrl: PROTECTED_URL, creatorId: "creator1", creatorUserId: "owner-user", locked: true, visibleToOthers: true, removed: false };
+
+test("an entitled subscriber, the creator and an admin are served; the storage URL is never revealed", async () => {
+  const m = await mediaServer({ "post:p1": lockedPost }, new Set(["fan-user"]));
+  try {
+    for (const user of ["fan-user", "owner-user", "an-admin"]) {
+      const r = await m.get("post/p1", user);
+      assert.equal(r.status, 200, user);
+      assert.equal(await r.text(), "media-bytes");
+      assert.equal(r.headers.get("cache-control"), "private, no-store", "subscriber-only bytes are never cached");
+      assert.match(r.headers.get("vary") ?? "", /Authorization/);
+      assert.ok(![...r.headers.values()].some((v) => v.includes("cloudinary")));
+    }
+    assert.equal(m.fetched[0].url, PROTECTED_URL + "?signed-by-server", "fetched with a server-made signature");
+
+    // Seeking: the byte range is passed through, and authorized like any other request.
+    const ranged = await m.get("post/p1", "fan-user", { Range: "bytes=0-10" });
+    assert.equal(ranged.status, 206);
+    assert.equal(m.fetched.at(-1)!.range, "bytes=0-10");
+  } finally {
+    await m.close();
+  }
+});
+
+test("the same address refuses a signed-out visitor and a non-subscriber, without touching storage", async () => {
+  const m = await mediaServer({ "post:p1": lockedPost }, new Set(["fan-user"]));
+  try {
+    const anonymous = await m.get("post/p1");
+    assert.equal(anonymous.status, 401);
+    assert.equal(((await anonymous.json()) as any).code, "sign_in_required");
+
+    const stranger = await m.get("post/p1", "someone-else");
+    assert.equal(stranger.status, 403);
+    assert.equal(((await stranger.json()) as any).code, "not_entitled");
+    assert.equal(stranger.headers.get("cache-control"), "no-store");
+
+    // Range requests get no special treatment.
+    assert.equal((await m.get("post/p1", "someone-else", { Range: "bytes=0-10" })).status, 403);
+    assert.equal(m.fetched.length, 0, "nothing is fetched from storage for a refused viewer");
+  } finally {
+    await m.close();
+  }
+});
+
+test("copying a working media address to another person does not give them access", async () => {
+  const m = await mediaServer({ "post:p1": lockedPost }, new Set(["fan-user"]));
+  try {
+    // The subscriber loads the media. This exact address is what they could copy.
+    const address = "post/p1";
+    assert.equal((await m.get(address, "fan-user")).status, 200);
+
+    // Someone else uses the identical address: evaluated as themself.
+    assert.equal((await m.get(address)).status, 401, "pasted into a signed-out browser");
+    assert.equal((await m.get(address, "friend-of-fan")).status, 403, "opened by a signed-in non-subscriber");
+    // Decorating the address with anything the old scheme used changes nothing.
+    assert.equal((await m.get(address + "?token=abc&exp=9999999999", "friend-of-fan")).status, 403);
+    // The original subscriber still works.
+    assert.equal((await m.get(address, "fan-user")).status, 200);
+  } finally {
+    await m.close();
+  }
+});
+
+test("access ends on the very next request when entitlement ends", async () => {
+  const entitled = new Set(["fan-user"]);
+  const m = await mediaServer({ "post:p1": lockedPost }, entitled);
+  try {
+    assert.equal((await m.get("post/p1", "fan-user")).status, 200);
+    entitled.delete("fan-user"); // cancelled, expired, refunded: whatever ended it
+    assert.equal((await m.get("post/p1", "fan-user")).status, 403);
+    assert.equal((await m.get("post/p1", "fan-user", { Range: "bytes=5-" })).status, 403, "mid-playback range requests too");
+  } finally {
+    await m.close();
+  }
+});
+
+test("public media is served to anyone; unapproved, removed and missing media to no outsider", async () => {
+  const m = await mediaServer({
+    "post:public": { ...lockedPost, locked: false },
+    "post:pending": { ...lockedPost, locked: false, visibleToOthers: false },
+    "post:removed": { ...lockedPost, removed: true },
+    "lesson:l1": { ...lockedPost, kind: "lesson" },
+  }, new Set(["fan-user"]));
+  try {
+    const open = await m.get("post/public");
+    assert.equal(open.status, 200, "signed-out visitor, public post");
+    assert.equal(open.headers.get("cache-control"), "private, max-age=300");
+
+    assert.equal((await m.get("post/pending")).status, 404);
+    assert.equal((await m.get("post/pending", "fan-user")).status, 404);
+    assert.equal((await m.get("post/pending", "owner-user")).status, 200, "the creator sees their own pending post");
+    for (const user of [undefined, "fan-user", "owner-user", "an-admin"]) {
+      assert.equal((await m.get("post/removed", user)).status, 404, `removed, viewer ${user}`);
+    }
+    assert.equal((await m.get("post/does-not-exist", "fan-user")).status, 404);
+    assert.equal((await m.get("lesson/l1")).status, 401);
+    assert.equal((await m.get("lesson/l1", "fan-user")).status, 200);
+    assert.equal((await m.get("anything/l1", "fan-user")).status, 404, "unknown kind");
+  } finally {
+    await m.close();
+  }
+});
+
+test("the media route never fetches a stored URL that is not Cloudinary", async () => {
+  const m = await mediaServer({ "post:p1": { ...lockedPost, rawUrl: "http://169.254.169.254/latest/meta-data/" } }, new Set(["fan-user"]));
+  try {
+    assert.equal((await m.get("post/p1", "fan-user")).status, 404);
+    assert.equal(m.fetched.length, 0);
+  } finally {
+    await m.close();
+  }
+});
+
+test("no API response exposes a stored media URL, and no bearer-style media link remains", () => {
+  for (const file of ["routes/content.ts", "routes/creators.ts", "routes/users.ts", "routes/public.ts", "routes/admin.ts", "routes/moderation.ts", "routes/courses.ts"]) {
+    const text = src(file);
+    assert.ok(!/mediaUrl:\s*(p|post)\.mediaUrl/.test(text), `${file} returns a stored mediaUrl`);
+    assert.ok(!/contentUrl:\s*(l|lesson)\.contentUrl/.test(text), `${file} returns a stored contentUrl`);
