+/**
+ * Phase 1A regression tests: payment containment.
+ *
+ * These prove that no request can activate a subscription, record a payment,
+ * store a card, or record a tip. They need no database and no Clerk or provider
+ * credentials: the database pool is replaced with a counter that fails the
+ * test if any query is attempted.
+ *
+ * Run: npm test
+ */
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import path from "node:path";
+import type { Server } from "node:http";
+import type { AddressInfo } from "node:net";
+import express from "express";
+
+// db/index.ts refuses to load without a URL. Nothing ever connects to it.
+process.env.DATABASE_URL ??= "postgresql://unused:unused@127.0.0.1:1/unused";
+// These tests run with billing unconfigured: nothing may be granted or written.
+for (const k of ["RAZORPAY_KEY_ID", "RAZORPAY_KEY_SECRET", "RAZORPAY_WEBHOOK_SECRET", "BILLING_CURRENCIES", "BILLING_FX_RATES"]) delete process.env[k];
+
+let server: Server;
+let base: string;
+let dbQueries = 0;
+
+before(async () => {
+  const { pool } = await import("../db");
+  const refuse = () => {
+    dbQueries++;
+    throw new Error("Database access attempted by a disabled payment endpoint");
+  };
+  (pool as any).query = refuse;
+  (pool as any).connect = refuse;
+
+  const { default: paymentsRouter } = await import("./payments");
+  const { default: tipsRouter } = await import("./tips");
+
+  const app = express();
+  app.use(express.json());
+  app.use("/api/payments", paymentsRouter);
+  app.use("/api/tips", tipsRouter);
+
+  await new Promise<void>((resolve) => {
+    server = app.listen(0, "127.0.0.1", () => resolve());
+  });
+  base = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;
+});
+
+after(async () => {
+  await new Promise((resolve) => server.close(resolve));
+});
+
+async function post(pathname: string, body: unknown, headers: Record<string, string> = {}) {
+  const res = await fetch(base + pathname, {
+    method: "POST",
+    headers: { "Content-Type": "application/json", ...headers },
+    body: JSON.stringify(body),
+  });
+  return { status: res.status, json: (await res.json()) as Record<string, unknown> };
+}
+
+function assertDisabled(r: { status: number; json: Record<string, unknown> }) {
+  // Removed endpoints answer 410; endpoints that exist but are switched off
+  // (or, for the webhook, unconfigured in this test) answer 503.
+  assert.ok(r.status === 503 || r.status === 410, `unexpected status ${r.status}`);
+  assert.ok(r.json.code === "PAYMENTS_UNAVAILABLE" || r.json.code === "ENDPOINT_REMOVED");
+  for (const key of ["success", "payment", "url", "sessionId", "received", "id"]) {
+    assert.ok(!(key in r.json), `response must not contain "${key}"`);
+  }
+  assert.equal(dbQueries, 0, "disabled endpoint must not touch the database");
+}
+
+const forgedWebhook = {
+  type: "checkout.session.completed",
+  data: { object: { subscription: "sub_forged", metadata: { userId: "u1", creatorId: "c1" } } },
+};
+
+test("direct-pay cannot create a subscription or payment", async () => {
+  assertDisabled(await post("/api/payments/direct-pay", { creatorId: "c1", amount: "0.01" }));
+});
+
+test("checkout grants nothing when no provider is configured (former demo mode)", async () => {
+  const saved = process.env.LEGACY_PROVIDER_KEY;
+  delete process.env.LEGACY_PROVIDER_KEY;
+  try {
+    assertDisabled(await post("/api/payments/checkout", { creatorId: "c1" }));
+  } finally {
+    if (saved !== undefined) process.env.LEGACY_PROVIDER_KEY = saved;
+  }
+});
+
+test("checkout stays removed when a provider key is present", async () => {
+  const saved = process.env.LEGACY_PROVIDER_KEY;
+  process.env.LEGACY_PROVIDER_KEY = "placeholder_not_a_real_key";
+  try {
+    assertDisabled(await post("/api/payments/checkout", { creatorId: "c1" }));
+  } finally {
+    if (saved === undefined) delete process.env.LEGACY_PROVIDER_KEY;
+    else process.env.LEGACY_PROVIDER_KEY = saved;
+  }
+});
+
+test("webhook ignores an unsigned event", async () => {
+  assertDisabled(await post("/api/payments/webhook", forgedWebhook));
+});
+
+test("webhook ignores an event carrying a made-up signature header", async () => {
+  const saved = process.env.LEGACY_PROVIDER_KEY;
+  process.env.LEGACY_PROVIDER_KEY = "placeholder_not_a_real_key";
+  try {
+    assertDisabled(
+      await post("/api/payments/webhook", forgedWebhook, { "x-razorpay-signature": "t=1,v1=forged" }),
+    );
+    assertDisabled(
+      await post(
+        "/api/payments/webhook",
+        { type: "customer.subscription.deleted", data: { object: { id: "sub_x" } } },
+        { "x-razorpay-signature": "t=1,v1=forged" },
+      ),
+    );
+  } finally {
+    if (saved === undefined) delete process.env.LEGACY_PROVIDER_KEY;
+    else process.env.LEGACY_PROVIDER_KEY = saved;
+  }
+});
+
+test("billing portal no longer returns a stub URL", async () => {
+  assertDisabled(await post("/api/payments/portal", {}));
+});
+
+test("card details cannot be stored", async () => {
+  assertDisabled(
+    await post("/api/payments/methods", {
+      cardHolder: "A B", last4: "4242", expMonth: "12", expYear: "2030", isDefault: true,
+    }),
+  );
+});
+
+test("tips cannot be recorded", async () => {
+  assertDisabled(await post("/api/tips", { creatorId: "c1", amount: 25, message: "hi" }));
+});
+
+test("payment and tip routes contain no code that fabricates financial records", () => {
+  const dir = path.dirname(fileURLToPath(import.meta.url));
+  const banned = [
+    /insert\(\s*subscriptionsTable/,
+    /update\(\s*subscriptionsTable/,
+    /insert\(\s*paymentsTable/,
+    /insert\(\s*tipsTable/,
+    /insert\(\s*paymentMethodsTable/,
+    /status:\s*"succeeded"/,
+    /status:\s*"active"/,
+    /subscriberCount/,
+    /event\s*=\s*req\.body/,
+  ];
+  for (const file of ["payments.ts", "tips.ts"]) {
+    const source = readFileSync(path.join(dir, file), "utf8");
+    for (const pattern of banned) {
+      assert.ok(!pattern.test(source), `${file} must not match ${pattern}`);
+    }
+  }
+});
