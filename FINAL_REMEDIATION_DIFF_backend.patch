+import type { NextFunction, Request, Response } from "express";
+
+/**
+ * Origins allowed to make credentialed cross-origin requests.
+ *
+ *   FRONTEND_URL           the deployed frontend, e.g. https://app.example.com
+ *   CORS_ALLOWED_ORIGINS   optional extra origins, comma-separated
+ *                          (preview deployments, a staging frontend)
+ *
+ * Outside production, localhost on any port is also allowed for development.
+ */
+export function allowedOrigins(env: Record<string, string | undefined> = process.env): {
+  exact: Set<string>;
+  allowLocalhost: boolean;
+} {
+  const exact = new Set<string>();
+  for (const raw of [env.FRONTEND_URL, ...(env.CORS_ALLOWED_ORIGINS ?? "").split(",")]) {
+    const value = raw?.trim();
+    if (!value) continue;
+    try {
+      exact.add(new URL(value).origin);
+    } catch {
+      // Ignore anything that is not a URL rather than allowing it.
+    }
+  }
+  return { exact, allowLocalhost: env.NODE_ENV !== "production" };
+}
+
+export function isOriginAllowed(
+  origin: string | undefined,
+  allowed: { exact: Set<string>; allowLocalhost: boolean },
+): boolean {
+  // No Origin header: same-origin navigation, curl, or a server-to-server
+  // call. CORS does not apply and there is nothing to reflect.
+  if (!origin) return false;
+  if (allowed.exact.has(origin)) return true;
+  if (allowed.allowLocalhost) {
+    try {
+      const { hostname } = new URL(origin);
+      return hostname === "localhost" || hostname === "127.0.0.1" || hostname.endsWith(".localhost");
+    } catch {
+      return false;
+    }
+  }
+  return false;
+}
+
+/** Baseline response headers for an API that serves JSON and proxied media. */
+export function securityHeaders(req: Request, res: Response, next: NextFunction): void {
+  res.setHeader("X-Content-Type-Options", "nosniff");
+  res.setHeader("X-Frame-Options", "DENY");
+  res.setHeader("Referrer-Policy", "no-referrer");
+  res.setHeader("Permissions-Policy", "camera=(), microphone=(), geolocation=()");
+  // API responses are never documents; forbid everything if one is rendered.
+  res.setHeader("Content-Security-Policy", "default-src 'none'; frame-ancestors 'none'");
+  if (process.env.NODE_ENV === "production") {
+    res.setHeader("Strict-Transport-Security", "max-age=15552000; includeSubDomains");
+  }
+  // Responses can depend on who is asking; shared caches must not reuse them.
+  if (req.path.startsWith("/api") && !req.path.startsWith("/api/media/")) {
+    res.setHeader("Cache-Control", "no-store");
+  }
+  next();
+}
