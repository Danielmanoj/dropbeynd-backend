+-- 0001_razorpay_billing.sql
+--
+-- Adds what Razorpay subscription billing needs. ADDITIVE ONLY:
+--   * no column is dropped, no row is updated or deleted;
+--   * every existing subscription and payment row is left exactly as it is and,
+--     having no provider verification, grants no access and counts as no revenue;
+--   * safe to run more than once.
+--
+-- Run this BEFORE deploying the application code that uses it. The previous
+-- application version keeps working after it has run.
+--
+-- Note: "ALTER TYPE ... ADD VALUE" cannot be used in the same transaction that
+-- then uses the new value, so run this file as-is (autocommit), not wrapped in
+-- a single BEGIN/COMMIT.
+
+ALTER TYPE subscription_status ADD VALUE IF NOT EXISTS 'pending';
+
+-- ── subscriptions ────────────────────────────────────────────────────────────
+ALTER TABLE subscriptions
+  ADD COLUMN IF NOT EXISTS provider                 text,
+  ADD COLUMN IF NOT EXISTS provider_subscription_id text,
+  ADD COLUMN IF NOT EXISTS provider_plan_id         text,
+  ADD COLUMN IF NOT EXISTS provider_status          text,
+  ADD COLUMN IF NOT EXISTS current_period_start     timestamp,
+  ADD COLUMN IF NOT EXISTS provider_verified_at     timestamp,
+  ADD COLUMN IF NOT EXISTS provider_event_at        timestamp,
+  ADD COLUMN IF NOT EXISTS cancel_requested_at      timestamp,
+  ADD COLUMN IF NOT EXISTS access_revoked_at        timestamp,
+  ADD COLUMN IF NOT EXISTS ended_at                 timestamp,
+  ADD COLUMN IF NOT EXISTS updated_at               timestamp NOT NULL DEFAULT now();
+
+-- One local row per provider subscription. Webhook replays cannot duplicate it.
+CREATE UNIQUE INDEX IF NOT EXISTS subscriptions_provider_subscription_uq
+  ON subscriptions (provider, provider_subscription_id)
+  WHERE provider_subscription_id IS NOT NULL;
+
+CREATE INDEX IF NOT EXISTS subscriptions_user_creator_idx ON subscriptions (user_id, creator_id);
+CREATE INDEX IF NOT EXISTS subscriptions_creator_idx      ON subscriptions (creator_id);
+
+-- ── payments ─────────────────────────────────────────────────────────────────
+ALTER TABLE payments
+  ADD COLUMN IF NOT EXISTS provider             text,
+  ADD COLUMN IF NOT EXISTS provider_payment_id  text,
+  ADD COLUMN IF NOT EXISTS subscription_id      text,
+  ADD COLUMN IF NOT EXISTS refunded_amount      numeric(10,2) NOT NULL DEFAULT 0,
+  ADD COLUMN IF NOT EXISTS provider_verified_at timestamp;
+
+-- One row per provider payment. A replayed "charged" event cannot double-count.
+CREATE UNIQUE INDEX IF NOT EXISTS payments_provider_payment_uq
+  ON payments (provider, provider_payment_id)
+  WHERE provider_payment_id IS NOT NULL;
+
+CREATE INDEX IF NOT EXISTS payments_creator_created_idx ON payments (creator_id, created_at);
+CREATE INDEX IF NOT EXISTS payments_user_idx            ON payments (user_id);
+CREATE INDEX IF NOT EXISTS payments_subscription_idx    ON payments (subscription_id);
+
+-- ── creators: the Razorpay plan that matches the creator's current price ─────
+ALTER TABLE creators
+  ADD COLUMN IF NOT EXISTS razorpay_plan_id       text,
+  ADD COLUMN IF NOT EXISTS razorpay_plan_amount   integer,
+  ADD COLUMN IF NOT EXISTS razorpay_plan_currency varchar(3);
+
+-- ── payment_events: webhook idempotency ledger ───────────────────────────────
+-- The primary key is the provider's event id. Inserting it is the first step of
+-- processing an event, inside the same transaction as the event's effects, so
+-- an event is applied exactly once however many times it is delivered.
+CREATE TABLE IF NOT EXISTS payment_events (
+  id             text PRIMARY KEY,
+  provider       text NOT NULL,
+  event_type     text NOT NULL,
+  outcome        text NOT NULL,
+  subject_id     text,
+  payload_sha256 text NOT NULL,
+  received_at    timestamp NOT NULL DEFAULT now()
+);
