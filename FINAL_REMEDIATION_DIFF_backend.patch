+      .select()
+      .from(subscriptionsTable)
+      .where(and(
+        eq(subscriptionsTable.provider, BILLING_PROVIDER),
+        eq(subscriptionsTable.providerSubscriptionId, subscriptionId),
+        eq(subscriptionsTable.userId, user.id),
