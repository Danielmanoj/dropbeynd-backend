+/**
+ * Phase 1A.1 regression tests: residual payment containment.
+ *
+ * Covers revenue reporting, verification payments, payout bank details and
+ * tipper privacy. No database, Clerk or provider access is needed: disabled
+ * endpoints are called with the database pool replaced by a stub that fails
+ * the test on any query, and the authorization / response-shaping rules are
+ * tested as pure functions.
+ *
+ * Authenticated routes are not exercised end to end here, because that needs
+ * a Clerk session and a database. For those, the tests assert on the helper
+ * each route delegates to, and on the route source calling that helper.
+ *
+ * Run: npm test
+ */
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import path from "node:path";
+import type { Server } from "node:http";
+import type { AddressInfo } from "node:net";
+import express from "express";
+import { PgDialect } from "drizzle-orm/pg-core";
+import {
+  canViewCreatorTips,
+  providerConfirmedPayment,
+  providerConfirmedTip,
+  toPayoutAccountView,
+  toTipView,
+} from "../lib/paymentContainment";
+
+process.env.DATABASE_URL ??= "postgresql://unused:unused@127.0.0.1:1/unused";
+for (const k of ["RAZORPAY_KEY_ID", "RAZORPAY_KEY_SECRET", "RAZORPAY_WEBHOOK_SECRET", "BILLING_CURRENCIES", "BILLING_FX_RATES"]) delete process.env[k];
+
+const routesDir = path.dirname(fileURLToPath(import.meta.url));
+const source = (file: string) => readFileSync(path.join(routesDir, file), "utf8");
+
+let server: Server;
+let base: string;
+let dbQueries = 0;
+
+before(async () => {
+  const { pool } = await import("../db");
+  const refuse = () => {
+    dbQueries++;
+    throw new Error("Database access attempted by a disabled endpoint");
+  };
+  (pool as any).query = refuse;
+  (pool as any).connect = refuse;
+
+  const { default: paymentsRouter } = await import("./payments");
+  const { default: verificationsRouter } = await import("./verifications");
+
+  const app = express();
+  app.use(express.json());
+  app.use("/api/payments", paymentsRouter);
+  app.use("/api/verifications", verificationsRouter);
+
+  await new Promise<void>((resolve) => {
+    server = app.listen(0, "127.0.0.1", () => resolve());
+  });
+  base = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;
+});
+
+after(async () => {
+  await new Promise((resolve) => server.close(resolve));
+});
+
+async function post(pathname: string, body: unknown) {
+  const res = await fetch(base + pathname, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify(body),
+  });
+  return { status: res.status, json: (await res.json()) as Record<string, unknown> };
+}
+
+function assertDisabled(r: { status: number; json: Record<string, unknown> }) {
+  assert.equal(r.status, 503);
+  assert.equal(r.json.code, "PAYMENTS_UNAVAILABLE");
+  for (const key of ["submitted", "record", "url", "id", "status", "routingNumber"]) {
+    assert.ok(!(key in r.json), `response must not contain "${key}"`);
+  }
+  assert.equal(dbQueries, 0, "disabled endpoint must not touch the database");
+}
+
+// ─── 2. Revenue reporting ─────────────────────────────────────────────────────
+
+test("revenue predicate requires verified-webhook evidence, not only a status", () => {
+  const q = new PgDialect().sqlToQuery(providerConfirmedPayment());
+  assert.match(q.sql, /"payments"\."status" = \$1/);
+  assert.match(q.sql, /"payments"\."provider" = \$2/);
+  assert.match(q.sql, /"payments"\."provider_payment_id" is not null/);
+  assert.match(q.sql, /"payments"\."provider_verified_at" is not null/);
+  assert.deepEqual(q.params, ["succeeded", "razorpay"]);
+});
+
+test("no tip is provider-confirmed while tip payments do not exist", () => {
+  const q = new PgDialect().sqlToQuery(providerConfirmedTip());
+  assert.equal(q.sql.trim(), "false");
+});
+
+test("every revenue query in creator dashboards and admin statistics uses the provider-confirmed predicate", () => {
+  for (const file of ["creators.ts", "admin.ts", "aiAgent.ts", "payments.ts"]) {
+    const src = source(file);
+    assert.ok(
+      !/eq\(\s*paymentsTable\.status/.test(src),
+      `${file} must not treat the status column alone as proof of payment`,
+    );
+    // Each statement that reads the payments table must apply the predicate.
+    const reads = src.split(/(?=\.from\(paymentsTable\)|db\.query\.paymentsTable\.findMany)/).slice(1);
+    assert.ok(reads.length > 0, `${file} should read payments`);
+    for (const chunk of reads) {
+      // A fixed window: the predicate must appear within the same statement.
+      const statement = chunk.slice(0, 500);
+      assert.ok(
+        statement.includes("providerConfirmedPayment()"),
+        `${file}: a payments query does not use providerConfirmedPayment(): ${statement.slice(0, 80)}`,
+      );
+    }
+  }
+});
+
+// ─── 3. Verification payments ─────────────────────────────────────────────────
+
+test("verification checkout is disabled", async () => {
+  assertDisabled(await post("/api/verifications/checkout", {}));
+});
+
+test("verification cannot be requested for free", async () => {
+  assertDisabled(await post("/api/verifications/request", { notes: "please" }));
+});
+
+test("verify-payment records nothing", async () => {
+  assertDisabled(await post("/api/verifications/verify-payment", { sessionId: "anything" }));
+});
+
+test("verification routes cannot create requests or grant a badge", () => {
+  const src = source("verifications.ts");
+  assert.ok(!/insert\(\s*verificationsTable/.test(src), "must not insert verification requests");
+  // Approval is refused before any update can run.
+  const refuse = src.indexOf("VERIFICATION_PAYMENT_UNAVAILABLE");
+  const update = src.indexOf("db.update(verificationsTable)");
+  assert.ok(refuse !== -1 && update !== -1 && refuse < update);
+});
+
+// ─── 4. Payout bank details ───────────────────────────────────────────────────
+
+test("new bank details are refused and never reach the database", async () => {
+  assertDisabled(
+    await post("/api/payments/payout-account", {
+      bankName: "Any Bank", accountHolderName: "A B", accountNumber: "000123456789", routingNumber: "021000021",
+    }),
+  );
+});
+
+test("payout routes cannot write bank details", () => {
+  const src = source("payments.ts");
+  assert.ok(!/insert\(\s*payoutAccountsTable/.test(src));
+  assert.ok(!/update\(\s*payoutAccountsTable/.test(src));
+  assert.ok(!src.includes("res.json(account ?? null)"), "must not return the raw payout row");
+  // Reads and deletes stay scoped to the signed-in user.
+  assert.ok(src.includes("eq(payoutAccountsTable.userId, user.id)"));
+});
+
+test("the payout view masks the routing number and drops internal ids", () => {
+  const view = toPayoutAccountView({
+    id: "pa_1", userId: "user_1", creatorId: "creator_1",
+    bankName: "Any Bank", accountHolderName: "A B",
+    accountNumberLast4: "6789", routingNumber: "021000021",
+    accountType: "checking", currency: "usd", isDefault: true, createdAt: new Date(0),
+  } as any);
+  assert.equal(view.routingNumberLast4, "0021");
+  assert.ok(!("routingNumber" in view));
+  assert.ok(!("userId" in view));
+  assert.ok(!("creatorId" in view));
+  assert.ok(!JSON.stringify(view).includes("021000021"));
+});
+
+// ─── 5. Tipper privacy ────────────────────────────────────────────────────────
+
+test("only the receiving creator or an admin may list a creator's tips", () => {
+  const creator = { userId: "owner" };
+  assert.equal(canViewCreatorTips({ id: "owner", role: "creator" }, creator), true);
+  assert.equal(canViewCreatorTips({ id: "someone", role: "admin" }, creator), true);
+  assert.equal(canViewCreatorTips({ id: "someone", role: "user" }, creator), false);
+  assert.equal(canViewCreatorTips({ id: "other-creator", role: "creator" }, creator), false);
+  assert.equal(canViewCreatorTips(null, creator), false);
+  assert.equal(canViewCreatorTips({ id: "owner", role: "creator" }, null), false);
+});
+
+test("a tip view never contains the tipper's email, ids or role", () => {
+  const view = toTipView({
+    id: "tip_1", userId: "user_9", creatorId: "creator_1",
+    amount: "5.00", currency: "usd", message: "nice", 
+    createdAt: new Date(0),
+    user: {
+      id: "user_9", clerkId: "clerk_secret_id", email: "private@example.com",
+      name: "Sam", avatarUrl: null, role: "user", isSuspended: false,
+    },
+  } as any);
+  assert.deepEqual(Object.keys(view).sort(), ["amount", "createdAt", "currency", "id", "message", "userName"]);
+  assert.equal(view.userName, "Sam");
+  const serialized = JSON.stringify(view);
+  for (const secret of ["private@example.com", "clerk_secret_id", "user_9"]) {
+    assert.ok(!serialized.includes(secret), `tip view leaked ${secret}`);
+  }
+  assert.equal(toTipView({ id: "t", amount: "1", currency: "usd", message: null, createdAt: new Date(0), user: null }).userName, "Anonymous");
+});
+
+test("the tips route enforces the access rule and never spreads raw rows", () => {
+  const src = source("tips.ts");
+  const guard = src.indexOf("canViewCreatorTips(viewer, creator)");
+  const query = src.indexOf("db.query.tipsTable.findMany");
+  assert.ok(guard !== -1 && query !== -1 && guard < query, "access check must run before the query");
+  assert.ok(!/\.\.\.t\b/.test(src), "must not spread tip rows into the response");
+  assert.ok(!/with:\s*\{\s*user:\s*true\s*\}/.test(src), "must not load the full user row");
+  assert.ok(src.includes("tips.map(toTipView)"));
+});
