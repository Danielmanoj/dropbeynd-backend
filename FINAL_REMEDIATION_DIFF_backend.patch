+/**
+ * Minimal Razorpay REST client for Subscriptions.
+ *
+ * Uses the documented REST API directly (HTTPS + basic auth with key id and
+ * secret) rather than the SDK, so the only moving part is `fetch`, which tests
+ * replace with a simulator. No amount or status from this client is ever
+ * trusted for access: entitlement comes only from verified webhooks.
+ */
+
+export interface RazorpaySubscription {
+  id: string;
+  entity?: string;
+  plan_id: string;
+  status: string;
+  current_start: number | null;
+  current_end: number | null;
+  ended_at: number | null;
+  charge_at?: number | null;
+  paid_count?: number;
+  remaining_count?: number;
+  notes?: Record<string, string>;
+}
+
+/** An invoice Razorpay raised for one billing cycle of a subscription. */
+export interface RazorpayInvoice {
+  id: string;
+  subscription_id?: string;
+  payment_id: string | null;
+  status: string;
+  amount_paid?: number;
+  currency?: string;
+  paid_at?: number | null;
+}
+
+export interface RazorpayPlan {
+  id: string;
+  period: string;
+  interval: number;
+  item: { name: string; amount: number; currency: string };
+}
+
+export class RazorpayApiError extends Error {
+  constructor(
+    public readonly status: number,
+    public readonly code: string | undefined,
+    message: string,
+  ) {
+    super(message);
+    this.name = "RazorpayApiError";
+  }
+}
+
+export interface RazorpayClient {
+  createPlan(input: { name: string; amountMinor: number; currency: string; notes?: Record<string, string> }): Promise<RazorpayPlan>;
+  createSubscription(input: { planId: string; totalCount: number; notes: Record<string, string> }): Promise<RazorpaySubscription>;
+  cancelSubscription(subscriptionId: string, atCycleEnd: boolean): Promise<RazorpaySubscription>;
+  /** Razorpay's current view of a subscription. Used by reconciliation. */
+  fetchSubscription(subscriptionId: string): Promise<RazorpaySubscription>;
+  /** The invoices (one per billing cycle) Razorpay holds for a subscription. */
+  fetchInvoices(subscriptionId: string): Promise<RazorpayInvoice[]>;
+}
+
+export type FetchLike = (url: string, init: { method: string; headers: Record<string, string>; body?: string; signal?: AbortSignal }) => Promise<{
+  ok: boolean;
+  status: number;
+  json(): Promise<any>;
+}>;
+
+const BASE_URL = "https://api.razorpay.com/v1";
+
+export function createRazorpayClient(opts: {
+  keyId: string;
+  keySecret: string;
+  fetch?: FetchLike;
+  timeoutMs?: number;
+}): RazorpayClient {
+  const doFetch: FetchLike = opts.fetch ?? (globalThis.fetch as unknown as FetchLike);
+  const auth = "Basic " + Buffer.from(`${opts.keyId}:${opts.keySecret}`).toString("base64");
+
+  const post = <T>(path: string, body: unknown) => call<T>("POST", path, body);
+  const get = <T>(path: string) => call<T>("GET", path);
+
+  async function call<T>(method: "GET" | "POST", path: string, body?: unknown): Promise<T> {
+    const res = await doFetch(`${BASE_URL}${path}`, {
+      method,
+      headers: { Authorization: auth, ...(body === undefined ? {} : { "Content-Type": "application/json" }) },
+      ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+      signal: AbortSignal.timeout(opts.timeoutMs ?? 15_000),
+    });
+    const data = await res.json().catch(() => ({}));
+    if (!res.ok) {
+      throw new RazorpayApiError(
+        res.status,
+        data?.error?.code,
+        data?.error?.description ?? `Razorpay request failed with status ${res.status}`,
+      );
+    }
+    return data as T;
+  }
+
+  return {
+    createPlan({ name, amountMinor, currency, notes }) {
+      return post<RazorpayPlan>("/plans", {
+        period: "monthly",
+        interval: 1,
+        item: { name, amount: amountMinor, currency },
+        notes: notes ?? {},
+      });
+    },
+    createSubscription({ planId, totalCount, notes }) {
+      return post<RazorpaySubscription>("/subscriptions", {
+        plan_id: planId,
+        total_count: totalCount,
+        quantity: 1,
+        customer_notify: 1,
+        notes,
+      });
+    },
+    cancelSubscription(subscriptionId, atCycleEnd) {
+      return post<RazorpaySubscription>(
+        `/subscriptions/${encodeURIComponent(subscriptionId)}/cancel`,
+        { cancel_at_cycle_end: atCycleEnd ? 1 : 0 },
+      );
+    },
+    fetchSubscription(subscriptionId) {
+      return get<RazorpaySubscription>(`/subscriptions/${encodeURIComponent(subscriptionId)}`);
+    },
+    async fetchInvoices(subscriptionId) {
+      const data = await get<{ items?: RazorpayInvoice[] }>(
+        `/invoices?subscription_id=${encodeURIComponent(subscriptionId)}`,
+      );
+      return Array.isArray(data.items) ? data.items : [];
+    },
+  };
+}
