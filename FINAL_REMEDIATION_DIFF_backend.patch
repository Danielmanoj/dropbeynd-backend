+test("changing visibility never exposes protected media and never fakes a lock", async () => {
+  const { mediaFitsLockState, lockChange } = await import("./mediaAccess");
+  // Creating: subscriber-only needs a protected asset.
+  assert.equal(mediaFitsLockState(PROTECTED_URL, true), true);
+  assert.equal(mediaFitsLockState(PUBLIC_URL, true), false);
+  assert.equal(mediaFitsLockState(PUBLIC_URL, false), true);
+  assert.equal(mediaFitsLockState(PROTECTED_URL, false), true);
+  assert.equal(mediaFitsLockState(null, true), true, "a text post can be locked");
+  // Public → subscriber-only with a public asset: refused, not silently "locked".
+  assert.equal(lockChange(false, true, PUBLIC_URL), "refuse");
+  assert.equal(lockChange(false, true, PROTECTED_URL), "ok");
+  assert.equal(lockChange(false, true, null), "ok");
+  // Subscriber-only → public: allowed, and the asset stays protected (served via the API).
+  assert.equal(lockChange(true, false, PROTECTED_URL), "ok");
+  // Posts locked before this rule existed are not disturbed by unrelated edits.
+  assert.equal(lockChange(true, true, PUBLIC_URL), "ok");
+
+  const content = src("routes/content.ts");
+  assert.match(content, /if \(!mediaFitsLockState\(mediaUrl, isLocked === true\)\) \{\s*res\.status\(400\)/);
